{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-ecs-fix-position.sh",
            "statusMessage": "Checking ECS --fix argument position..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-tool-invocation-guardrails.sh",
            "statusMessage": "Checking tool-invocation guardrails..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-git-safety.sh",
            "statusMessage": "Checking git safety guardrails..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-composer-normalize-reminder.sh",
            "statusMessage": "Checking composer normalize follow-up..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-content-hygiene.sh",
            "statusMessage": "Checking content hygiene..."
          }
        ]
      }
    ]
  }
}
