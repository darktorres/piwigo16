# Template for `.env` (production runtime) and `.env.test` (test runtime).
# Copy to either file and fill in real values. Both files are gitignored.
#
# Two-file split — fully independent, no inheritance, no merging:
#
#   .env       — Loaded by every web request (common.inc.php / install.php /
#                upgrade.php / i.php) when no `X-Piwigo-Env` header is set.
#                Holds production DB credentials.
#
#   .env.test  — Loaded INSTEAD OF .env when the request carries
#                `X-Piwigo-Env: test` AND originates from loopback
#                (127.0.0.1 / ::1). Self-contained — the runtime never
#                merges .env into .env.test. Holds test DB credentials.
#                See: src/Piwigo/Config/TestMode.php
#
# Per-request switch — set by the test infrastructure:
#   - tests/bootstrap.php   PHPUnit CLI; sets $_SERVER['HTTP_X_PIWIGO_ENV']
#                           before any runtime call
#   - playwright.config.ts  e2e; extraHTTPHeaders attaches the header to
#                           every browser/API request
#
# Install lifecycle is also split: prod uses local/.installed, tests use
# local/.installed.test, so test installs never touch the prod sentinel.
# install.php writes credentials to whichever env file is active for the
# request that triggered it.
#
# Mapping applied to Config::$data at runtime:
#   PIWIGO_DB_HOST     -> $conf['db_host']
#   PIWIGO_DB_USER     -> $conf['db_user']
#   PIWIGO_DB_PASSWORD -> $conf['db_password']
#   PIWIGO_DB_BASE     -> $conf['db_base']
#   PIWIGO_DB_PREFIX   -> $conf['db_prefix']  (also drives $prefixeTable)
#
# Test-runner-only extras (not applied to $conf, just used by test setup):
#   PIWIGO_DB_PORT     test runner only; runtime reads $conf['db_host']
#                      which can include `host:port`
#   PIWIGO_BASE_URL    test runner only; base URL of the local Apache install

# ──────────────────────────────────────────────────────────────────────────
# .env (production) — copy this block, fill in real values, save as `.env`.
# ──────────────────────────────────────────────────────────────────────────

PIWIGO_DB_HOST=localhost
PIWIGO_DB_USER=piwigo
PIWIGO_DB_PASSWORD=
PIWIGO_DB_BASE=piwigo
PIWIGO_DB_PREFIX=piwigo_

# ──────────────────────────────────────────────────────────────────────────
# .env.test (tests) — copy this block, fill in real values, save as
# `.env.test`. PIWIGO_DB_BASE MUST be a throw-away DB; the integration
# suite drops & recreates it on every run.
# ──────────────────────────────────────────────────────────────────────────

# PIWIGO_DB_HOST=127.0.0.1
# PIWIGO_DB_PORT=3306
# PIWIGO_DB_USER=root
# PIWIGO_DB_PASSWORD=
# PIWIGO_DB_BASE=piwigo_test
# PIWIGO_DB_PREFIX=piwigo_
# PIWIGO_BASE_URL=http://localhost/piwigo16
