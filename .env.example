# Template for `.env` (production runtime) and `.env.test` (test runtime).
# Copy to either file and fill in real values. Both files are gitignored.
#
# Two-file split — fully independent, no inheritance, no merging:
#
#   .env       — Loaded by every web request (common.inc.php / install.php /
#                i.php) when no `X-Piwigo-Env` header is set. Holds
#                production DB credentials.
#
#   .env.test  — Loaded INSTEAD OF .env when the request carries
#                `X-Piwigo-Env: test` AND originates from loopback
#                (127.0.0.1 / ::1). Self-contained — the runtime never
#                merges .env into .env.test. Holds test DB credentials.
#                See: include/env.inc.php
#
# Per-request switch — set by the test infrastructure:
#   - tests/bootstrap.php     Pest CLI; sets $_SERVER['HTTP_X_PIWIGO_ENV']
#                             before any runtime call
#   - tests/Browser suite     browser E2E; attaches the header to every
#                             browser/HTTP request
#
# Install lifecycle is also split: prod uses local/.installed, tests use
# local/.installed.test, so test installs never touch the prod sentinel.
# install.php writes credentials to whichever env file is active for the
# request that triggered it.
#
# Mapping applied to $conf at runtime (pwg_apply_env_to_conf()):
#   PIWIGO_DB_HOST     -> $conf['db_host']
#   PIWIGO_DB_USER     -> $conf['db_user']
#   PIWIGO_DB_PASSWORD -> $conf['db_password']
#   PIWIGO_DB_BASE     -> $conf['db_base']
#
# Not part of the $conf mapping above — read directly by
# Piwigo\Db\DbCredentials::fromEnv() instead:
#   PIWIGO_DB_DRIVER   'mysqli' (default, also covers MariaDB — same wire
#                      protocol) or 'pgsql'. Native DBAL drivers only, not
#                      pdo_mysql/pdo_pgsql.
#
# Also not part of the $conf mapping — read directly by
# Piwigo\Bootstrap\RequestBootstrap::pemUrl() instead, same
# DbCredentials-style getenv() pattern (P27.9):
#   PIWIGO_ALT_PLUGINS_PEM_URL    Overrides the plugin-catalog base URL
#   PIWIGO_ALT_THEMES_PEM_URL     Overrides the theme-catalog base URL
#   PIWIGO_ALT_LANGUAGES_PEM_URL  Overrides the language-catalog base URL
#                      Point these at a local extension-catalog mirror
#                      (e.g. a sibling piwigo16-plugins/piwigo16-themes/
#                      piwigo16-languages repo, statically serving its own
#                      manifest.json + .zip archives) instead of the real
#                      piwigo.org PEM server. Takes priority over the
#                      DB-backed generic CurrentConfig::$alternativePemUrl
#                      override, which in turn takes priority over the
#                      real AppInfo::URL . '/ext' default. Unset -> no
#                      per-type override, falls through as normal.
#
# Test-runner-only extras (not applied to $conf, just used by test setup):
#   PIWIGO_DB_PORT     test runner only; runtime reads $conf['db_host']
#                      which can include `host:port`
#   PIWIGO_BASE_URL    test runner only; base URL of the running PHP server.
#                      Required by Integration/Contract tests (curl) and
#                      Browser tests. For Apache: http://localhost/piwigo17.
#   PIWIGO_TEST_NOW    read by pwg_now() (include/env.inc.php) — freezes what
#                      time_since()-based "N units ago" text (and the admin
#                      dashboard's activity chart) treats as "now", so those
#                      pages render deterministically in visual-regression
#                      screenshots. ISO-8601 with a `T` separator, no space
#                      (symfony/dotenv requires quoting any value containing
#                      a space). Must stay AFTER the committed fixture's own
#                      baked-in timestamps (tests/Fixtures/piwigo-16.x.sql is
#                      regenerated with live NOW() values) or time_since()
#                      output would go negative ("in X"). Bump forward
#                      whenever the fixture is regenerated with
#                      `composer test:fixture-regen`, same idea as bumping a
#                      baseline. Unset -> real wall-clock time (prod-safe
#                      default; this var is only ever read in test mode).

# ──────────────────────────────────────────────────────────────────────────
# .env (production) — copy this block, fill in real values, save as `.env`.
# ──────────────────────────────────────────────────────────────────────────

PIWIGO_DB_HOST=localhost
PIWIGO_DB_USER=piwigo
PIWIGO_DB_PASSWORD=
PIWIGO_DB_BASE=piwigo
# PIWIGO_ALT_PLUGINS_PEM_URL=http://localhost/piwigo16-plugins
# PIWIGO_ALT_THEMES_PEM_URL=http://localhost/piwigo16-themes
# PIWIGO_ALT_LANGUAGES_PEM_URL=http://localhost/piwigo16-languages

# ──────────────────────────────────────────────────────────────────────────
# .env.test (tests) — copy this block, fill in real values, save as
# `.env.test`. PIWIGO_DB_BASE MUST be a throw-away DB; the Integration/
# Contract/Browser suites drop & recreate it on every fixture reload.
# ──────────────────────────────────────────────────────────────────────────

# PIWIGO_DB_HOST=127.0.0.1
# PIWIGO_DB_PORT=3306
# PIWIGO_DB_USER=root
# PIWIGO_DB_PASSWORD=
# PIWIGO_DB_BASE=piwigo_test
# PIWIGO_BASE_URL=http://localhost/piwigo17
# PIWIGO_TEST_NOW=2026-08-01T00:00:00
# PIWIGO_ALT_PLUGINS_PEM_URL=http://localhost/piwigo16-plugins
# PIWIGO_ALT_THEMES_PEM_URL=http://localhost/piwigo16-themes
# PIWIGO_ALT_LANGUAGES_PEM_URL=http://localhost/piwigo16-languages

# ──────────────────────────────────────────────────────────────────────────
# .env.test against PostgreSQL instead of MySQL/MariaDB — same file, same
# suite, just swap PIWIGO_DB_DRIVER/PIWIGO_DB_PORT (and the credentials) in
# the block above rather than keeping a second env file in sync.
# ──────────────────────────────────────────────────────────────────────────

# PIWIGO_DB_HOST=127.0.0.1
# PIWIGO_DB_PORT=5432
# PIWIGO_DB_DRIVER=pgsql
# PIWIGO_DB_USER=postgres
# PIWIGO_DB_PASSWORD=
# PIWIGO_DB_BASE=piwigo_test
# PIWIGO_BASE_URL=http://localhost/piwigo17
# PIWIGO_TEST_NOW=2026-08-01T00:00:00
