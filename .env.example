# Template for .env (runtime) and .env.local (local-only overrides).
# Copy to .env and fill in real values. .env and .env.local are gitignored.
#
# Loaded at boot by Piwigo\Config\ConfigLoader and applied to $conf:
#   PIWIGO_DB_HOST     -> $conf['db_host']
#   PIWIGO_DB_USER     -> $conf['db_user']
#   PIWIGO_DB_PASSWORD -> $conf['db_password']
#   PIWIGO_DB_BASE     -> $conf['db_base']
#
# Env values win over local/config/database.inc.php (12-factor precedence).
# Existing installs that rely on database.inc.php keep working unchanged
# if no .env is present.
#
# Also consumed by the test runner:
#   tests/bootstrap.php (phpdotenv) for unit / integration tests
#   tests/Integration/IntegrationTestCase.php for DB connection
#   tests/e2e/global-setup.ts for Playwright DB seeding

# MySQL host reachable by the runtime / test runner.
PIWIGO_DB_HOST=127.0.0.1

# MySQL port (currently used by the test runner only; runtime reads from
# $conf['db_host'] which can include `host:port`).
PIWIGO_DB_PORT=3306

# MySQL credentials. For tests, the user must have privileges to CREATE/DROP
# databases (the integration suite drops & recreates PIWIGO_DB_BASE on every
# test).
PIWIGO_DB_USER=root
PIWIGO_DB_PASSWORD=

# Database name. NEVER point this at production from a test run — the
# integration suite drops and recreates this database on every test.
PIWIGO_DB_BASE=piwigo_test

# Base URL of the local Apache instance serving this Piwigo checkout
# (test runner only).
PIWIGO_BASE_URL=http://localhost/piwigo16
