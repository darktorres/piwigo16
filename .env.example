# Template for `.env` (runtime overrides) and `.env.local` (test-runner
# overrides). Copy to either file and fill in real values. Both files are
# gitignored.
#
# Two-file split — important:
#
#   .env       — Loaded at every web request by Piwigo\Config\ConfigLoader
#                in include/common.inc.php / install.php / upgrade.php / i.php.
#                Use for runtime overrides like production DB credentials.
#
#   .env.local — Loaded ONLY by tests/bootstrap.php for the test runner.
#                Use for test-runner-specific values that must NOT leak into
#                a real web request — typically PIWIGO_DB_BASE=piwigo_test
#                so the integration suite can drop & recreate the database
#                without touching the real one.
#
# Mapping applied to $conf at runtime (PIWIGO_DB_PORT/_BASE_URL are test-only):
#   PIWIGO_DB_HOST     -> $conf['db_host']
#   PIWIGO_DB_USER     -> $conf['db_user']
#   PIWIGO_DB_PASSWORD -> $conf['db_password']
#   PIWIGO_DB_BASE     -> $conf['db_base']
#   PIWIGO_DB_PREFIX   -> $conf['db_prefix']  (also drives $prefixeTable)
#
# `.env` is the sole runtime source for DB credentials.
#
# Also consumed by:
#   tests/Integration/IntegrationTestCase.php (DB connection per test)
#   tests/e2e/global-setup.ts (Playwright DB seeding)

# MySQL host reachable by the runtime / test runner.
PIWIGO_DB_HOST=127.0.0.1

# MySQL port (test runner only; runtime reads $conf['db_host'] which can
# include `host:port`).
PIWIGO_DB_PORT=3306

# MySQL credentials. For tests, the user must have privileges to CREATE/DROP
# databases (the integration suite drops & recreates PIWIGO_DB_BASE per test).
PIWIGO_DB_USER=root
PIWIGO_DB_PASSWORD=

# Database name. In .env.local for tests this MUST be a throw-away DB — the
# integration suite drops and recreates it on every run.
PIWIGO_DB_BASE=piwigo_test

# Table-name prefix (formerly $prefixeTable in local/config/database.inc.php).
PIWIGO_DB_PREFIX=piwigo_

# Base URL of the local Apache instance serving this Piwigo checkout
# (test runner only).
PIWIGO_BASE_URL=http://localhost/piwigo16
