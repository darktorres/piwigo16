# Template for .env.local — copy to .env.local and fill in real values.
# .env.local is gitignored. Loaded by tests/bootstrap.php; consumed by
# tests/Integration/IntegrationTestCase.php and tests/e2e/global-setup.ts.

# MySQL host reachable by the test runner.
PIWIGO_DB_HOST=127.0.0.1

# MySQL port.
PIWIGO_DB_PORT=3306

# MySQL credentials. The user must have privileges to CREATE/DROP databases
# (the integration suite drops & recreates PIWIGO_DB_BASE on every test).
PIWIGO_DB_USER=root
PIWIGO_DB_PASSWORD=

# Test database name. NEVER point this at the production database — it
# gets dropped and recreated on every integration test run.
PIWIGO_DB_BASE=piwigo_test

# Base URL of the local Apache instance serving this Piwigo checkout.
PIWIGO_BASE_URL=http://localhost/piwigo16
