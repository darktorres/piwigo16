# Normalise line endings to LF in the repo — Pint PSR-12 enforces LF on Linux CI.
* text=auto eol=lf

# Windows batch files must stay CRLF.
*.bat text eol=crlf

# Vendor Unix binaries must be executable and LF.
vendor/bin/php-parse    text eol=lf
vendor/bin/phpstan      text eol=lf
vendor/bin/phpstan.phar text eol=lf
vendor/bin/phpunit      text eol=lf
vendor/bin/pint         text eol=lf
vendor/bin/rector       text eol=lf

# Release tarball: exclude dev tooling and docs from git archive exports.
/tests                  export-ignore
/docs                   export-ignore
/tools                  export-ignore
/.github                export-ignore
/phpunit.xml.dist       export-ignore
/phpstan.neon           export-ignore
/phpstan-baseline.neon  export-ignore
/rector.php             export-ignore
/pint.json              export-ignore
/composer.lock          export-ignore
/vendor/phpstan         export-ignore
/vendor/rector          export-ignore
/vendor/phpunit         export-ignore
/vendor/laravel         export-ignore
/vendor/symfony         export-ignore
/vendor/bin             export-ignore

# Binary assets — no line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.sql -text
