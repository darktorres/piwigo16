# Normalise line endings to LF in the repo — Pint PSR-12 enforces LF on Linux CI.
* text=auto eol=lf

# Windows batch files must stay CRLF.
*.bat text eol=crlf

# Vendor Unix binaries must be executable and LF.
vendor/bin/php-parse    text eol=lf
vendor/bin/phpstan      text eol=lf
vendor/bin/phpstan.phar text eol=lf
vendor/bin/phpunit      text eol=lf
vendor/bin/pint         text eol=lf
vendor/bin/rector       text eol=lf

# Binary assets — no line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.sql -text
