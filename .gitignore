# Piwigo specific directories
/_data
/plugins/*
!/plugins/index.php
/themes/*
!/themes/index.php
!/themes/_base
!/themes/admin
!/themes/standard_pages
/upload
/galleries/*
!/galleries/index.php
/local/*
!/local/**/index.php

# IntelliJ
.idea
*.iml
*.ipr
*.iws

# Eclipse
.settings
.project

# PHP tooling
.phpunit.cache
phpstan*.txt

# Node / Playwright
node_modules/
playwright-report/
test-results/
dist/
# Test fixtures intentionally ship a pre-built dist/ tree as input to
# AssetServiceTest — exempt them from the dist/ rule above.
!tests/Fixtures/Plugins/*/dist/
!tests/Fixtures/Plugins/*/dist/**

# Composer dependencies
/vendor/

# Tool session artifacts
.playwright-mcp/
.claude/worktrees/

# Generated by `composer openapi:dump` / `npm run openapi:dump`
/openapi.json

# Local env (DB credentials, never commit). .env.example is the committed template.
.env
.env.test
.env.*.local
