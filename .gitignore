# Environment files (see .env.example)
/.env
/.env.test

# Composer dependencies
/vendor

# tools/openapi-bootstrap.php's own draft output -- throwaway scaffolding
# for Phase 2 of the OpenAPI spec work to hand-review from, never trusted
# verbatim and never the committed artifact itself (that's openapi/openapi.yaml
# + openapi/paths/*.yaml, written by hand). Regenerate with `php
# tools/openapi-bootstrap.php`.
/openapi/.draft

# JS dependencies + build output
/node_modules
/dist
/.lighthouseci

# SBOM output (P3, generated fresh each CI run — see composer.json's "sbom"
# script and .github/workflows/ci.yml's sbom job). package-lock.json is never
# used by this project (bun.lock is authoritative) — it's only ever a
# throwaway snapshot the SBOM tooling needs since @cyclonedx/cyclonedx-npm
# doesn't read bun.lock directly.
/sbom-*.cdx.json
/package-lock.json

# pest-plugin-browser auto-captures a screenshot here on assertion failure
/tests/Browser/Screenshots

# GoldenHtmlSnapshotTest.php/MailGoldenHtmlSnapshotTest.php write a real
# `diff -u` here on a mismatch, for review without re-running the suite --
# generated on failure, not committed state.
/tests/Fixtures/GoldenHtml/.diffs
/tests/Fixtures/GoldenHtml/mail/.diffs

# deptrac's incremental-analysis cache (P6+)
/.deptrac.cache

# PHPUnit's own test-result cache (--order-by=defects, risky/incomplete tracking)
/.phpunit.result.cache

# Generated PHPStan Latte analysis files (bin/piwigo phpstan-latte:compile);
# deliberately NOT under _data/ -- PHPStan's excludePaths beats paths, so a
# subtree of the excluded _data/* could never be analysed.
/_analysis/

# Piwigo specific directories
/_data/*
!/_data/.gitkeep
/plugins/*
!/plugins/index.php
/themes/*
!/themes/index.php
!/themes/admin
!/themes/default
!/themes/standard_pages
!/themes/golden_html_test
/upload
/galleries/*
!/galleries/index.php
/local/*
!/local/**/index.php

# IntelliJ
.idea
*.iml
*.ipr
*.iws

# Eclipse
.settings
.project