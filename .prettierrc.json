{
  "singleQuote": true,
  "tabWidth": 4,
  "useTabs": false,
  "trailingComma": "es5",
  "printWidth": 100,
  "semi": true,
  "arrowParens": "always",
  "overrides": [
    {
      "files": ["*.json", "*.md", "*.yml", "*.yaml"],
      "options": { "tabWidth": 2 }
    },
    {
      "files": "*.css",
      "options": { "tabWidth": 2, "singleQuote": false }
    }
  ]
}
