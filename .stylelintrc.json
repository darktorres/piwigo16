{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "custom-property-pattern": "^[a-z][a-z0-9-]*$",
    "color-no-invalid-hex": true,
    "color-hex-length": "short",
    "color-named": "never",
    "shorthand-property-no-redundant-values": true,
    "declaration-block-no-redundant-longhand-properties": true,
    "length-zero-no-unit": true,
    "unit-allowed-list": ["px", "em", "rem", "%", "vh", "vw", "fr", "deg", "ms", "s"],
    "selector-no-vendor-prefix": [true, { "severity": "warning" }],
    "no-descending-specificity": null,
    "selector-class-pattern": null,
    "selector-id-pattern": null,
    "keyframes-name-pattern": null,
    "no-duplicate-selectors": true,
    "alpha-value-notation": "number",
    "color-function-notation": null,
    "hue-degree-notation": null,
    "media-feature-range-notation": null,
    "import-notation": null,
    "value-keyword-case": null,
    "comment-empty-line-before": null,
    "rule-empty-line-before": null,
    "declaration-empty-line-before": null,
    "at-rule-empty-line-before": null,
    "at-rule-no-unknown": [true, { "ignoreAtRules": ["literal"] }]
  },
  "ignoreFiles": [
    "**/*.min.css",
    "node_modules/**",
    "dist/**",
    "_data/**",
    "vendor/**",
    "plugins/LocalFilesEditor/codemirror/**",
    "plugins/piwigo-openstreetmap/leaflet/**",
    "plugins/piwigo-openstreetmap/fontello/**",
    "plugins/piwigo-videojs/video-js-*/**",
    "themes/default/vendor/fontello/**",
    "admin/themes/default/fontello/**",
    "admin/themes/default/fonts/**"
  ]
}
