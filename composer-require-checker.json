{
  "symbol-whitelist": [
    "PhpCsFixer\\Fixer\\Alias\\RandomApiMigrationFixer",
    "PhpCsFixer\\Fixer\\Basic\\SingleLineEmptyBodyFixer",
    "PhpCsFixer\\Fixer\\Phpdoc\\GeneralPhpdocAnnotationRemoveFixer",
    "PhpCsFixer\\Fixer\\Strict\\DeclareStrictTypesFixer",
    "PhpCsFixer\\Fixer\\StringNotation\\NoTrailingWhitespaceInStringFixer",
    "PhpCsFixer\\Fixer\\Whitespace\\LineEndingFixer",
    "Symplify\\CodingStandard\\Fixer\\Commenting\\ParamReturnAndVarTagMalformsFixer",
    "Symplify\\CodingStandard\\Fixer\\LineLength\\LineLengthFixer",
    "Symplify\\EasyCodingStandard\\Config\\ECSConfig",
    "Symplify\\EasyCodingStandard\\ValueObject\\Option",
    "Rector\\Config\\RectorConfig",
    "ComposerUnused\\ComposerUnused\\Configuration\\PatternFilter",
    "Symfony\\Component\\Yaml\\Yaml",

    "exif_read_data",
    "imagick",
    "Imagick",
    "ImagickPixel",

    "gzopen64",

    "INTL_IDNA_VARIANT_2003",

    "Github\\Client",

    "Psr\\Cache\\CacheItemInterface",
    "Psr\\Log\\LoggerInterface",
    "League\\OAuth2\\Client\\Grant\\RefreshToken",

    "create_function",
    "each",
    "get_magic_quotes_gpc",
    "get_magic_quotes_runtime",
    "set_magic_quotes_runtime",
    "mysql_affected_rows",
    "mysql_close",
    "mysql_connect",
    "mysql_errno",
    "mysql_error",
    "mysql_fetch_array",
    "mysql_fetch_assoc",
    "mysql_fetch_object",
    "mysql_fetch_row",
    "mysql_free_result",
    "mysql_get_server_info",
    "mysql_insert_id",
    "mysql_num_rows",
    "mysql_query",
    "mysql_real_escape_string",
    "mysql_select_db",
    "mysql_set_charset",
    "apc_compile_file",
    "apc_delete_file",
    "imap_errors",
    "imap_rfc822_parse_adrlist",
    "opcache_invalidate",

    "Null",
    "Chr",
    "Ord",
    "Header",
    "buf",
    "Unknown",
    "ImageColorAllocate",
    "ImageCopyResized",
    "ImageCreate",
    "ImageDestroy",
    "ImageJpeg",
    "ImagePng",
    "ImageSetPixel",

    "PclError",
    "PclErrorCode",
    "PclErrorReset",
    "PclErrorString",
    "QRbitrtream",
    "QRstr",
    "Smarty\\Lexer\\Exception",
    "Smarty_Internal_Debug",

    "PHPWG_INSTALLED",
    "DB_CHARSET",
    "DB_COLLATE",
    "plugin_activate",
    "plugin_deactivate",
    "plugin_install",
    "plugin_uninstall",
    "theme_activate",
    "theme_deactivate",
    "theme_delete"
  ],
  "scan-files": [
    "*.php",
    "admin/**/*.php",
    "include/**/*.php",
    "install/*.php",
    "plugins/*.php",
    "template-extension/**/*.php",
    "themes/**/*.php",
    "tools/*.php"
  ]
}
