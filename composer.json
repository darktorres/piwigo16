{
    "name": "piwigo/piwigo",
    "description": "Piwigo photo gallery — modernized",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ahand/mobileesp": "dev-master"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.4",
        "rector/rector": "^2.0",
        "symfony/process": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "Piwigo\\": "src/Piwigo/",
            "Smarty\\": "include/smarty/src/"
        },
        "files": [
            "include/smarty/src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Piwigo\\Tests\\": "tests/",
            "Piwigo\\Tools\\PhpStan\\": "tools/phpstan/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
