{
  "name": "piwigo/piwigo",
  "description": "Piwigo photo gallery — modernized",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.5",
    "ext-calendar": "*",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-filter": "*",
    "ext-gd": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "ext-openssl": "*",
    "ext-pcntl": "*",
    "ext-session": "*",
    "ext-simplexml": "*",
    "ext-zip": "*",
    "ext-zlib": "*",
    "doctrine/dbal": "^4.4",
    "doctrine/migrations": "^3.9",
    "doctrine/orm": "^3.6",
    "endroid/qr-code": "^6",
    "gettext/gettext": "^5.7",
    "gettext/translator": "^1.2",
    "league/flysystem": "^3.35",
    "league/flysystem-local": "^3.31",
    "monolog/monolog": "^3.0",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "pelago/emogrifier": "^8",
    "php-di/php-di": "^7.0",
    "psr/http-client": "^1.0",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0",
    "sentry/sentry": "^4",
    "smarty/smarty": "^5",
    "symfony/cache": "^8.0",
    "symfony/console": "^8.0",
    "symfony/doctrine-messenger": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/http-client": "^8.0",
    "symfony/mailer": "^8",
    "symfony/messenger": "^8.1",
    "symfony/mime": "^8",
    "symfony/process": "^8.0",
    "symfony/routing": "^8.0"
  },
  "suggest": {
    "ext-exif": "Read EXIF metadata from JPEGs. All call sites guard with function_exists(); features that need EXIF degrade gracefully when the extension is absent.",
    "ext-imagick": "Alternative graphics library to GD, selected at runtime when present.",
    "ext-imap": "Optional email-address parsing helper for notification features."
  },
  "require-dev": {
    "cweagans/composer-patches": "^2.0",
    "cyclonedx/cyclonedx-php-composer": "^6.2",
    "deptrac/deptrac": "^4.6",
    "icanhazstring/composer-unused": "^0.9",
    "justinrainbow/json-schema": "^6.8",
    "maglnet/composer-require-checker": "^4.16",
    "pestphp/pest": "^4.7",
    "pestphp/pest-plugin-arch": "^4.0",
    "pestphp/pest-plugin-browser": "^4.3",
    "pestphp/pest-plugin-mutate": "^4.0",
    "pestphp/pest-plugin-type-coverage": "^4.0",
    "phpbench/phpbench": "^1.4",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "rector/rector": "^2.0",
    "roave/security-advisories": "dev-latest",
    "symfony/yaml": "^8.1",
    "symplify/easy-coding-standard": "^13.1",
    "vimeo/psalm": "^6.16"
  },
  "autoload": {
    "psr-4": {
      "Piwigo\\": "src/Piwigo/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Piwigo\\Tests\\": "tests/",
      "Piwigo\\Tools\\PhpStan\\": "tools/phpstan/"
    }
  },
  "scripts": {
    "lint:php": "@php vendor/bin/ecs check",
    "analyse:phpstan": "@php vendor/bin/phpstan analyse",
    "analyse:psalm": "@php vendor/bin/psalm",
    "analyse": [
      "@analyse:phpstan"
    ],
    "test": "@php vendor/bin/pest --testsuite Unit,Arch",
    "test:coverage": "@php vendor/bin/pest --testsuite Unit,Arch --coverage --min=0.1",
    "test:integration": "@php vendor/bin/pest --testsuite Integration",
    "test:contract": "@php vendor/bin/pest --testsuite Contract",
    "test:browser": [
      "bash tools/reimport-fixture.sh",
      "bash tools/pest-cleanup.sh --testsuite Browser --exclude-group=fixture-regen --exclude-group=visual-regression"
    ],
    "test:fixture-regen": "bash tools/pest-cleanup.sh --testsuite Browser --group=fixture-regen",
    "test:visual": [
      "bash tools/reimport-fixture.sh",
      "bash tools/pest-cleanup.sh --testsuite Browser --group=visual-regression"
    ],
    "plan-lint": "@php tools/plan-lint.php",
    "require-checker": "@php vendor/bin/composer-require-checker check --config-file=composer-require-checker.json composer.json",
    "unused": "@php vendor/bin/composer-unused --configuration=composer-unused.php",
    "bench": "@php vendor/bin/phpbench run",
    "sbom": "@composer CycloneDX:make-sbom --output-format=JSON --output-file=sbom-composer.cdx.json --spec-version=1.6 --output-reproducible"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "process-timeout": 0,
    "allow-plugins": {
      "cyclonedx/cyclonedx-php-composer": true,
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true,
      "cweagans/composer-patches": true,
      "cweagans/composer-configurable-plugin": true
    }
  },
  "extra": {
    "patches": {
      "pestphp/pest-plugin-browser": {
        "Fix expectScreenshot() unconditionally failing when the tolerant threshold comparison actually passes (missing return after Page.php's foreach loop)": "patches/pest-plugin-browser-4.3.1-expect-screenshot-success-path.patch",
        "Add Chromium launch flags for deterministic screenshot rendering on Linux (font hinting/LCD text/color profile) -- the plugin's own maintainers don't trust screenshot assertions on Linux/CI without this class of mitigation, see PR pestphp/pest-plugin-browser#175": "patches/pest-plugin-browser-4.3.1-deterministic-screenshot-flags.patch",
        "Fix Execution::resetAssertions() passing Assert::class instead of null as ReflectionProperty::setValue()'s first argument for a static property (PHP 8.1 deprecation)": "patches/pest-plugin-browser-4.3.1-reset-assertions-static-property.patch"
      }
    },
    "phpstan/extension-installer": {
      "ignore": [
        "tomasvotruba/type-coverage"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
