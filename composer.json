{
  "name": "piwigo/piwigo",
  "description": "Piwigo photo gallery — modernized",
  "type": "project",
  "require": {
    "php": "^8.5",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "ahand/mobileesp": "dev-master",
    "endroid/qr-code": "^5.0",
    "matthiasmullie/minify": "^1.3",
    "openpsa/universalfeedcreator": "^1.9",
    "pclzip/pclzip": "^2.8",
    "pelago/emogrifier": "^8.0",
    "phpmailer/phpmailer": "^6.9",
    "smarty/smarty": "^5.0",
    "tedivm/jshrink": "^1.7"
  },
  "require-dev": {
    "laravel/pint": "^1.18",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^11.4",
    "rector/rector": "^2.0",
    "symfony/process": "^7.1"
  },
  "autoload": {
    "psr-4": {
      "Piwigo\\": "src/Piwigo/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Piwigo\\Tests\\": "tests/",
      "Piwigo\\Tools\\PhpStan\\": "tools/phpstan/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "classmap-authoritative": true,
    "sort-packages": true,
    "allow-plugins": {}
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
