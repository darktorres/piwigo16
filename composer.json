{
  "name": "piwigo/piwigo",
  "description": "Piwigo photo gallery — modernized",
  "type": "project",
  "require": {
    "php": "^8.5",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "ahand/mobileesp": "dev-master",
    "doctrine/dbal": "^4.4",
    "doctrine/migrations": "^3.9",
    "endroid/qr-code": "^6.0",
    "gettext/gettext": "^5.7",
    "gettext/translator": "^1.2",
    "league/flysystem": "^3.33",
    "league/flysystem-local": "^3.31",
    "monolog/monolog": "^3.0",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "openpsa/universalfeedcreator": "^1.9",
    "pclzip/pclzip": "^2.8",
    "pelago/emogrifier": "^8.0",
    "php-di/php-di": "^7.0",
    "phpmailer/phpmailer": "^7.0",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0",
    "psr/simple-cache": "^3.0",
    "smarty/smarty": "^5.0",
    "symfony/cache": "^8.0",
    "symfony/doctrine-messenger": "^8.0",
    "symfony/messenger": "^8.0",
    "symfony/routing": "^8.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "laravel/pint": "^1.18",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^13.0",
    "rector/argtyper": "^0.6.0",
    "rector/extension-installer": "^0.11.2",
    "rector/jack": "^1.0",
    "rector/mockstan": "dev-main",
    "rector/rector": "^2.0",
    "rector/swiss-knife": "^2.3",
    "rector/type-perfect": "^2.1",
    "symfony/process": "^8.0",
    "vimeo/psalm": "^6.16"
  },
  "suggest": {
    "ext-exif": "Read EXIF metadata from JPEGs. All call sites guard with function_exists(); features that need EXIF degrade gracefully when the extension is absent."
  },
  "autoload": {
    "psr-4": {
      "Piwigo\\": "src/Piwigo/"
    },
    "files": [
      "src/Piwigo/Calendar/CalendarConstants.php",
      "src/Piwigo/Search/QConstants.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Piwigo\\Tests\\": "tests/",
      "Piwigo\\Tools\\PhpStan\\": "tools/phpstan/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "classmap-authoritative": true,
    "sort-packages": true,
    "allow-plugins": {
      "rector/extension-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
