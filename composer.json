{
  "name": "piwigo/piwigo",
  "description": "Piwigo photo gallery — modernized",
  "type": "project",
  "require": {
    "php": "^8.5",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "ahand/mobileesp": "dev-master",
    "doctrine/dbal": "^4.4",
    "doctrine/migrations": "^3.9",
    "endroid/qr-code": "^6.0",
    "gettext/gettext": "^5.7",
    "gettext/translator": "^1.2",
    "league/flysystem": "^3.33",
    "league/flysystem-local": "^3.31",
    "matthiasmullie/minify": "^1.3",
    "monolog/monolog": "^3.0",
    "openpsa/universalfeedcreator": "^1.9",
    "pclzip/pclzip": "^2.8",
    "pelago/emogrifier": "^8.0",
    "php-di/php-di": "^7.0",
    "phpmailer/phpmailer": "^7.0",
    "psr/log": "^3.0",
    "psr/simple-cache": "^3.0",
    "smarty/smarty": "^5.0",
    "symfony/cache": "^8.0",
    "symfony/doctrine-messenger": "^8.0",
    "symfony/messenger": "^8.0",
    "tedivm/jshrink": "^1.7",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "laravel/pint": "^1.18",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^13.0",
    "rector/rector": "^2.0",
    "symfony/process": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "Piwigo\\": "src/Piwigo/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Piwigo\\Tests\\": "tests/",
      "Piwigo\\Tools\\PhpStan\\": "tools/phpstan/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "classmap-authoritative": true,
    "sort-packages": true,
    "allow-plugins": {}
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
