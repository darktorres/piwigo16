{
  "name": "piwigo/piwigo",
  "description": "Piwigo photo gallery — modernized",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.5",
    "ext-calendar": "*",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-filter": "*",
    "ext-gd": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "ext-openssl": "*",
    "ext-pcntl": "*",
    "ext-pgsql": "*",
    "ext-session": "*",
    "ext-simplexml": "*",
    "ext-zip": "*",
    "ext-zlib": "*",
    "doctrine/dbal": "^4.4",
    "doctrine/migrations": "^3.9",
    "doctrine/orm": "^3.6",
    "endroid/qr-code": "^6",
    "gettext/gettext": "^5.7",
    "gettext/translator": "^1.2",
    "league/flysystem": "^3.35",
    "league/flysystem-local": "^3.31",
    "monolog/monolog": "^3.0",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "pelago/emogrifier": "^8",
    "php-di/php-di": "^7.0",
    "psr/http-client": "^1.0",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0",
    "sentry/sentry": "^4",
    "smarty/smarty": "^5",
    "symfony/cache": "^8.0",
    "symfony/console": "^8.0",
    "symfony/doctrine-messenger": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/http-client": "^8.0",
    "symfony/mailer": "^8",
    "symfony/messenger": "^8.1",
    "symfony/mime": "^8",
    "symfony/process": "^8.0",
    "symfony/routing": "^8.0"
  },
  "suggest": {
    "ext-exif": "Read EXIF metadata from JPEGs. All call sites guard with function_exists(); features that need EXIF degrade gracefully when the extension is absent.",
    "ext-imagick": "Alternative graphics library to GD, selected at runtime when present.",
    "ext-imap": "Optional email-address parsing helper for notification features."
  },
  "require-dev": {
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-pdo_pgsql": "*",
    "cweagans/composer-patches": "^2.0",
    "cyclonedx/cyclonedx-php-composer": "^6.2",
    "deptrac/deptrac": "^4.6",
    "icanhazstring/composer-unused": "^0.9",
    "justinrainbow/json-schema": "^6.8",
    "maglnet/composer-require-checker": "^4.16",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-arch": "^5.0",
    "pestphp/pest-plugin-browser": "^5.0",
    "pestphp/pest-plugin-mutate": "^5.0",
    "pestphp/pest-plugin-phpstan": "^5.0",
    "pestphp/pest-plugin-type-coverage": "^5.0",
    "phpbench/phpbench": "^1.4",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "rector/rector": "^2.0",
    "roave/security-advisories": "dev-latest",
    "shipmonk/dead-code-detector": "^1.3",
    "staabm/phpstan-dba": "dev-main",
    "symfony/yaml": "^8.1",
    "symplify/easy-coding-standard": "^13.1",
    "vimeo/psalm": "7.x-dev"
  },
  "autoload": {
    "psr-4": {
      "Piwigo\\": "src/Piwigo/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Piwigo\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/Fixtures/Migrations/"
    ]
  },
  "scripts": {
    "lint:php": "@php vendor/bin/ecs check",
    "lint:psr4": "@composer dump-autoload --optimize --strict-psr",
    "analyse:phpstan": "@php vendor/bin/phpstan analyse",
    "analyse": [
      "@analyse:phpstan"
    ],
    "test": [
      "bash tools/reimport-fixture.sh",
      "@php vendor/bin/pest --testsuite Unit,Arch --parallel"
    ],
    "test:coverage": [
      "bash tools/reimport-fixture.sh",
      "@php vendor/bin/pest --testsuite Unit,Arch --coverage-php _data/coverage-raw/unit-arch.cov"
    ],
    "test:coverage:integration": [
      "bash tools/reimport-fixture.sh",
      "@php vendor/bin/pest --testsuite Integration --coverage-php _data/coverage-raw/integration.cov"
    ],
    "test:integration": [
      "bash tools/reimport-fixture.sh",
      "@php vendor/bin/pest --testsuite Integration"
    ],
    "test:contract": [
      "bash tools/reimport-fixture.sh",
      "@php vendor/bin/pest --testsuite Contract"
    ],
    "test:browser": [
      "bash tools/reimport-fixture.sh",
      "@php vendor/bin/pest --testsuite Browser --exclude-group=fixture-regen --exclude-group=visual-regression --exclude-group=install-flow"
    ],
    "test:coverage:web": [
      "rm -rf _data/coverage-raw/web",
      "PIWIGO_COVERAGE=1 php vendor/bin/pest --testsuite Contract",
      "bash tools/reimport-fixture.sh",
      "PIWIGO_COVERAGE=1 php vendor/bin/pest --testsuite Browser --exclude-group=fixture-regen --exclude-group=visual-regression --exclude-group=install-flow"
    ],
    "test:coverage:all": [
      "@test:coverage",
      "@test:coverage:integration",
      "@test:coverage:web",
      "@php tools/coverage-merge.php _data/coverage-raw/unit-arch.cov _data/coverage-raw/integration.cov"
    ],
    "test:fixture-regen": "@php vendor/bin/pest --testsuite Browser --group=fixture-regen",
    "test:visual": [
      "bash tools/reimport-fixture.sh",
      "@php vendor/bin/pest --testsuite Browser --group=visual-regression"
    ],
    "test:install": "@php vendor/bin/pest --testsuite Browser --group=install-flow",
    "test:mutate": "@php vendor/bin/pest --mutate --testsuite Unit --parallel --everything --covered-only",
    "require-checker": "@php vendor/bin/composer-require-checker check --config-file=composer-require-checker.json composer.json",
    "unused": "@php vendor/bin/composer-unused --configuration=composer-unused.php",
    "bench": "@php vendor/bin/phpbench run",
    "sbom": "@composer CycloneDX:make-sbom --output-format=JSON --output-file=sbom-composer.cdx.json --spec-version=1.6 --output-reproducible"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "process-timeout": 0,
    "allow-plugins": {
      "cyclonedx/cyclonedx-php-composer": true,
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true,
      "cweagans/composer-patches": true,
      "cweagans/composer-configurable-plugin": true
    }
  },
  "extra": {
    "patches": {
      "pestphp/pest-plugin-browser": {
        "Fix expectScreenshot() unconditionally failing when the tolerant threshold comparison actually passes (missing return after Page.php's foreach loop)": "patches/pest-plugin-browser-5.0.0-expect-screenshot-success-path.patch",
        "Add Chromium launch flags for deterministic screenshot rendering on Linux (font hinting/LCD text/color profile) -- the plugin's own maintainers don't trust screenshot assertions on Linux/CI without this class of mitigation, see PR pestphp/pest-plugin-browser#175": "patches/pest-plugin-browser-5.0.0-deterministic-screenshot-flags.patch",
        "Fix Execution::resetAssertions() passing Assert::class instead of null as ReflectionProperty::setValue()'s first argument for a static property (PHP 8.1 deprecation)": "patches/pest-plugin-browser-5.0.0-reset-assertions-static-property.patch",
        "Fix PlaywrightNpmServer::start() launching via SystemProcess::fromShellCommandline() (a plain command string), which proc_open() routes through /bin/sh -c on this environment -- Symfony ends up tracking the shell's PID, not the real playwright run-server process underneath it, so stop()'s SIGTERM only reaches the shell and the real server survives, reparented to the nearest subreaper, on every run regardless of whether the suite passed. Ported the same fix already applied and confirmed working for the plugin's own pre-5.0 PlaywrightNpmServer (a differently-located/structured class the 4.3.1->5.0.0 rewrite silently reintroduced this exact bug for): build the process from an argv array instead, which bypasses the shell entirely": "patches/pest-plugin-browser-5.0.0-stop-server-without-shell.patch"
      },
      "pestphp/pest-plugin-mutate": {
        "Bound the composed --filter argument length in MutationTest::start() -- a mutation covered by hundreds/thousands of tests can build a --filter regex past Linux's 128 KiB MAX_ARG_STRLEN, crashing proc_open() with ProcessStartFailedException (\"Argument list too long\") and killing the entire test:mutate run; falls back to running the full testsuite for that one mutant instead, which is always correctness-preserving": "patches/pest-plugin-mutate-5.0.1-bound-filter-argument-length.patch",
        "Fix MutationTestRunner::run() building $coveredLines directly from lineCoverage()'s raw per-line array, which since phpunit/php-code-coverage 14 is keyed by an interned test index (int) with the hit count as the value, not a list of test id strings -- MutationTest::start() then fed a hit-count int straight into preg_match(), fatalling with 'Argument #2 ($subject) must be of type string, int given' on the very first covered mutation. Resolves each surviving index back to its real test id via testIds() before handing $coveredLines off": "patches/pest-plugin-mutate-5.0.1-resolve-interned-test-index.patch"
      },
      "smarty/smarty": {
        "Fix TemplateBase::$compile_id's @var docblock (string) contradicting its own `= null` default and setCompileId()'s real usage -- confirmed by reading the class itself; no native property type declared, so PHPStan trusts the wrong docblock": "patches/smarty-smarty-5.8.4-compile-id-nullable-docblock.patch",
        "Fix Smarty::unregisterFilter()'s @param docblock typo `callback|string` (not a real PHP/PHPStan type -- resolves to the unrelated class Smarty\\callback) to the real accepted type `callable|string`, matching its own _getFilterName() implementation": "patches/smarty-smarty-5.8.4-unregisterfilter-callable-docblock.patch",
        "Fix Smarty::$error_reporting's @var docblock (int) contradicting its own `= null` default -- only ever set to an int by the constructor when template debugging is off, so it genuinely stays null when debugging is on (confirmed by reading the constructor + TemplateInstanceTest.php's own already-passing coverage of both branches); same class of bug as $compile_id above": "patches/smarty-smarty-5.8.4-error-reporting-nullable-docblock.patch"
      },
      "doctrine/dbal": {
        "Fix Driver\\PgSQL\\Statement::__destruct() unconditionally running a DEALLOCATE cleanup query even when the connection's transaction was already aborted by an earlier failed query -- PostgreSQL rejects every subsequent command in an aborted transaction, so the DEALLOCATE itself fails with 'current transaction is aborted, commands ignored until end of transaction block', surfacing as a spurious PHP warning during exception unwinding, strictly before any higher-level rollback (e.g. Doctrine ORM UnitOfWork::commit()'s own finally block) gets a chance to run. Guards with pg_transaction_status(), which requires a preceding pg_connection_busy() call to avoid reading a stale ACTIVE status (confirmed via live reproduction against a real aborted transaction) -- see doctrine/dbal#5893, which added the destructor with no aborted-transaction handling and no known upstream fix": "patches/doctrine-dbal-4.4.4-pgsql-statement-skip-deallocate-on-aborted-transaction.patch"
      },
      "vimeo/psalm": {
        "Fix StatementsAnalyzer referencing two of its own properties, $depth and $root_scope, without ever declaring either as a class property -- confirmed absent from the class, every parent, and every trait in the installed source. $depth is a plain recursion-depth counter (incremented on analyze() entry, decremented in its own finally block, gating checkUnreferencedVars()/var-initialization-alteration to only the outermost call); reading/writing it under PHP 8.2+'s dynamic-property deprecation throws PHP Error: Creation of dynamic property ... is deprecated on literally the first statement analyzed in any file. $root_scope is read at two sites gating that same logic but is never assigned anywhere in the codebase, so reading it throws PHP Error: Undefined property once $depth's crash is patched around. Psalm's own ErrorHandler (by design) escalates both from a PHP notice/deprecation into a hard RuntimeException; inside a forked amphp/parallel worker that crash cascades into an unhandled Future, then an uncaught-in-event-loop-callback error, which leaves that worker's Revolt driver Fiber marked running so the next worker spawn's own EventLoop::run() call fails with 'The event loop is already running' -- i.e. Psalm 7.x-dev crashes on every real run, in exactly this shape, purely from its own missing property declarations. No upstream fix found (the file's own commit history has no matching change) and no existing GitHub issue found for this exact crash; declares `private int $depth = 0;` and `private bool $root_scope = false;` next to the class's other simple fields, matching each one's existing usage/semantics exactly (root_scope stays unwired/always-false, matching its current always-undefined behavior, rather than inventing new analysis logic upstream doesn't have)": "patches/vimeo-psalm-dev-master-statementsanalyzer-undeclared-properties.patch"
      }
    },
    "phpstan/extension-installer": {
      "ignore": [
        "tomasvotruba/type-coverage"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
