{
  "name": "piwigo/piwigo",
  "description": "Piwigo photo gallery — modernized",
  "type": "project",
  "require": {
    "php": "^8.5",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "ext-zip": "*",
    "composer/semver": "^3.4",
    "doctrine/dbal": "^4.4",
    "doctrine/migrations": "^3.9",
    "endroid/qr-code": "^6.0",
    "gettext/gettext": "^5.7",
    "gettext/translator": "^1.2",
    "latte/latte": "^3.1",
    "league/flysystem": "^3.33",
    "league/flysystem-local": "^3.31",
    "mobiledetect/mobiledetectlib": "^4.8",
    "monolog/monolog": "^3.0",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "opis/json-schema": "^2.6",
    "pelago/emogrifier": "^8.0",
    "php-di/php-di": "^7.0",
    "phpmailer/phpmailer": "^7.0",
    "psr/event-dispatcher": "^1.0",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0",
    "psr/simple-cache": "^3.0",
    "symfony/cache": "^8.0",
    "symfony/doctrine-messenger": "^8.0",
    "symfony/event-dispatcher": "^8.0",
    "symfony/messenger": "^8.0",
    "symfony/routing": "^8.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "efabrica/phpstan-latte": "0.99.*",
    "laravel/pint": "^1.18",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^13.0",
    "psalm/plugin-phpunit": "^0.19.7",
    "rector/argtyper": "^0.6.0",
    "rector/extension-installer": "^0.11.2",
    "rector/jack": "^1.0",
    "rector/mockstan": "dev-main",
    "rector/rector": "^2.0",
    "rector/swiss-knife": "^2.3",
    "rector/type-perfect": "^2.1",
    "symfony/process": "^8.0",
    "symplify/coding-standard": "^13.0",
    "symplify/easy-coding-standard": "^13.1",
    "vimeo/psalm": "^6.16"
  },
  "suggest": {
    "ext-exif": "Read EXIF metadata from JPEGs. All call sites guard with function_exists(); features that need EXIF degrade gracefully when the extension is absent."
  },
  "autoload": {
    "psr-4": {
      "Piwigo\\": "src/Piwigo/"
    },
    "files": [
      "src/Piwigo/Calendar/CalendarConstants.php",
      "src/Piwigo/Search/QConstants.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Piwigo\\Tests\\": "tests/",
      "Piwigo\\Tools\\PhpStan\\": "tools/phpstan/",
      "Piwigo\\Tools\\SmartyToLatte\\": "tools/smarty-to-latte/"
    }
  },
  "scripts": {
    "lint:latte": "@php tools/latte-lint.php",
    "lint:php": "@php vendor/bin/pint --test",
    "lint": [
      "@lint:php",
      "@lint:latte"
    ],
    "analyse:phpstan": "@php vendor/bin/phpstan analyse",
    "analyse:psalm": "@php vendor/bin/psalm",
    "analyse": [
      "@analyse:phpstan",
      "@analyse:psalm"
    ],
    "precompile:templates": "@php tools/precompile_templates.php",
    "piwigo:lint": "@php tools/plugin-lint.php",
    "test": "@php vendor/bin/phpunit"
  },
  "scripts-descriptions": {
    "lint": "Run all PHP/Latte lints (pint --test + latte-lint)",
    "lint:latte": "Validate .latte templates with PiwigoExtension registered",
    "lint:php": "Check PHP code style with Pint (no fixes)",
    "analyse": "Run static analysis (phpstan + psalm)",
    "analyse:phpstan": "Run PHPStan",
    "analyse:psalm": "Run Psalm",
    "precompile:templates": "Warm Latte compile cache for every bundled .latte (deploy/CI)",
    "piwigo:lint": "Scan plugin source for forbidden legacy patterns (pwg_query, $GLOBALS, *_TABLE, trigger_change …)",
    "test": "Run PHPUnit"
  },
  "repositories": [
    {
      "type": "path",
      "url": "tools/phpstan-latte",
      "options": {
        "symlink": true
      }
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "classmap-authoritative": true,
    "sort-packages": true,
    "allow-plugins": {
      "rector/extension-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
