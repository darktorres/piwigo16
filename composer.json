{
  "name": "piwigo/piwigo",
  "description": "Piwigo photo gallery — modernized",
  "license": "GPL-2.0-or-later",
  "type": "project",
  "require": {
    "php": "^8.5",
    "ext-calendar": "*",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-filter": "*",
    "ext-gd": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "ext-openssl": "*",
    "ext-pcntl": "*",
    "ext-pgsql": "*",
    "ext-session": "*",
    "ext-simplexml": "*",
    "ext-sqlite3": "*",
    "ext-zip": "*",
    "ext-zlib": "*",
    "composer/semver": "3.4.4",
    "doctrine/collections": "2.6.0",
    "doctrine/dbal": "4.4.4",
    "doctrine/event-manager": "2.1.1",
    "doctrine/migrations": "3.9.7",
    "doctrine/orm": "3.6.8",
    "doctrine/persistence": "4.2.0",
    "endroid/qr-code": "6.1.3",
    "gettext/gettext": "5.7.3",
    "gettext/translator": "1.2.3",
    "latte/latte": "3.1.6",
    "league/flysystem": "3.35.2",
    "league/flysystem-local": "3.31.0",
    "monolog/monolog": "3.10.0",
    "nyholm/psr7": "1.8.2",
    "nyholm/psr7-server": "1.1.0",
    "opis/json-schema": "2.6.0",
    "pelago/emogrifier": "8.2.0",
    "php-di/php-di": "7.1.1",
    "psr/cache": "3.0.0",
    "psr/container": "2.0.2",
    "psr/event-dispatcher": "1.0.0",
    "psr/http-client": "1.0.3",
    "psr/http-message": "2.0",
    "psr/http-server-handler": "1.0.2",
    "psr/http-server-middleware": "1.0.2",
    "psr/log": "3.0.2",
    "sentry/sentry": "4.30.0",
    "symfony/cache": "8.1.4",
    "symfony/console": "8.1.4",
    "symfony/doctrine-messenger": "8.1.4",
    "symfony/dotenv": "8.1.2",
    "symfony/event-dispatcher": "8.1.2",
    "symfony/http-client": "8.1.4",
    "symfony/http-client-contracts": "3.7.1",
    "symfony/mailer": "8.1.2",
    "symfony/messenger": "8.1.4",
    "symfony/mime": "8.1.4",
    "symfony/process": "8.1.0",
    "symfony/routing": "8.1.2"
  },
  "require-dev": {
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-pdo_pgsql": "*",
    "cweagans/composer-patches": "2.0.0",
    "cyclonedx/cyclonedx-php-composer": "6.2.0",
    "deptrac/deptrac": "4.7.1",
    "ergebnis/composer-normalize": "2.52.0",
    "icanhazstring/composer-unused": "0.9.6",
    "justinrainbow/json-schema": "6.10.0",
    "maglnet/composer-require-checker": "4.24.0",
    "nikic/php-parser": "5.8.0",
    "pestphp/pest": "5.1.1",
    "pestphp/pest-plugin-arch": "5.0.0",
    "pestphp/pest-plugin-browser": "5.0.1",
    "pestphp/pest-plugin-mutate": "5.0.2",
    "pestphp/pest-plugin-phpstan": "5.0.2",
    "pestphp/pest-plugin-type-coverage": "5.0.2",
    "php-openapi/openapi": "2.1.0",
    "phpbench/phpbench": "1.7.0",
    "phpstan/extension-installer": "1.4.3",
    "phpstan/phpdoc-parser": "2.3.3",
    "phpstan/phpstan": "2.2.8",
    "phpstan/phpstan-deprecation-rules": "2.0.5",
    "phpstan/phpstan-doctrine": "2.0.28",
    "phpstan/phpstan-phpunit": "2.0.18",
    "phpstan/phpstan-strict-rules": "2.0.12",
    "phpstan/phpstan-symfony": "2.0.20",
    "rector/rector": "2.6.2",
    "roave/security-advisories": "dev-latest",
    "shipmonk/dead-code-detector": "1.3.3",
    "staabm/phpstan-dba": "dev-main#72f7bed7f09c1122dfbbe09e28d291d31960d924",
    "studio-design/gesso": "2.6.0",
    "symfony/yaml": "8.1.2",
    "symplify/easy-coding-standard": "13.2.17",
    "tracy/tracy": "2.12.1"
  },
  "suggest": {
    "ext-exif": "Read EXIF metadata from JPEGs. All call sites guard with function_exists(); features that need EXIF degrade gracefully when the extension is absent.",
    "ext-imagick": "Alternative graphics library to GD, selected at runtime when present.",
    "ext-imap": "Optional email-address parsing helper for notification features."
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Piwigo\\": "src/Piwigo/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Piwigo\\Tests\\": "tests/",
      "Piwigo\\Tools\\OpenApi\\": "tools/openapi/",
      "Piwigo\\Tools\\PhpStan\\": "tools/phpstan/"
    },
    "exclude-from-classmap": [
      "/tests/Fixtures/Migrations/"
    ]
  },
  "config": {
    "allow-plugins": {
      "cweagans/composer-configurable-plugin": true,
      "cweagans/composer-patches": true,
      "cyclonedx/cyclonedx-php-composer": true,
      "ergebnis/composer-normalize": true,
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    },
    "optimize-autoloader": true,
    "process-timeout": 0,
    "sort-packages": true
  },
  "extra": {
    "patches": {
      "doctrine/dbal": {
        "Fix Driver\\PgSQL\\Statement::__destruct() unconditionally running a DEALLOCATE cleanup query even when the connection's transaction was already aborted by an earlier failed query -- PostgreSQL rejects every subsequent command in an aborted transaction, so the DEALLOCATE itself fails with 'current transaction is aborted, commands ignored until end of transaction block', surfacing as a spurious PHP warning during exception unwinding, strictly before any higher-level rollback (e.g. Doctrine ORM UnitOfWork::commit()'s own finally block) gets a chance to run. Guards with pg_transaction_status(), which requires a preceding pg_connection_busy() call to avoid reading a stale ACTIVE status (confirmed via live reproduction against a real aborted transaction) -- see doctrine/dbal#5893, which added the destructor with no aborted-transaction handling and no known upstream fix": "patches/doctrine-dbal-4.4.4-pgsql-statement-skip-deallocate-on-aborted-transaction.patch"
      },
      "pestphp/pest": {
        "Fix Plugins\\Parallel\\Paratest\\WrapperRunner::run() calling TestResultFacade::init(); EventFacade::instance()->seal(); itself, immediately before constructing SuiteLoader -- whose own constructor is precisely where PHPUnit's ExtensionBootstrapper runs every registered extension's bootstrap(), including any registerSubscriber() call a normal PHPUnit extension makes there. By the time that loop runs under --parallel, the Event Facade is already sealed by this premature call, so registerSubscriber() throws PHPUnit\\Event\\Exception\\EventFacadeIsSealedException -- confirmed live via studio-design/gesso's OpenApiCoverageExtension throwing exactly this in every worker, every `composer test` run. PHPUnit converts the uncaught exception into a non-fatal testRunnerTriggeredWarningEvents() entry, but phpunit.xml's own failOnPhpunitWarning setting silently defaults to true in PHPUnit's own XML loader when unset (unlike its failOnPhpunitDeprecation sibling, which defaults false), so this one warning event alone fails the whole run's exit code even though every individual test passes. Confirmed via 3 real, side-by-side references (PHPUnit's own single-process Application.php, and brianium/paratest's own unmodified SuiteLoader.php, reused directly by this same Pest fork for every other file in this directory) that both bootstrap every extension first and only seal the Facade afterward -- Pest's own WrapperRunner::run() duplicates that same init+seal pair one step too early, before SuiteLoader (which already performs the identical, correctly-ordered call itself, at the end of its own constructor) ever gets constructed. No known upstream fix found and no existing report matching this exact symptom -- pestphp/pest v5.1.1 is the latest release, so this isn't something a version bump on our end would resolve": "patches/pestphp-pest-5.1.1-defer-event-facade-seal-past-extension-bootstrap.patch"
      },
      "pestphp/pest-plugin-browser": {
        "Fix expectScreenshot() unconditionally failing when the tolerant threshold comparison actually passes (missing return after Page.php's foreach loop)": "patches/pest-plugin-browser-5.0.0-expect-screenshot-success-path.patch",
        "Add Chromium launch flags for deterministic screenshot rendering on Linux (font hinting/LCD text/color profile) -- the plugin's own maintainers don't trust screenshot assertions on Linux/CI without this class of mitigation, see PR pestphp/pest-plugin-browser#175": "patches/pest-plugin-browser-5.0.0-deterministic-screenshot-flags.patch",
        "Start `playwright run-server` with --unsafe, without which playwright-core's own filterLaunchOptions() silently discards every `args` entry the patch above sends (allowUnsafe gates args/executablePath/ignoreDefaultArgs; `headless` passes through regardless, so nothing looks broken). Confirmed by reading the live browser's argv: none of the five determinism flags was applied, LCD subpixel text anti-aliasing was on in every screenshot, and 5-14 of the 80 visual baselines differed between any two capture runs. With the flags actually reaching Chromium, three consecutive full captures are byte-identical": "patches/pest-plugin-browser-5.0.0-run-server-unsafe-launch-options.patch",
        "Fix Execution::resetAssertions() passing Assert::class instead of null as ReflectionProperty::setValue()'s first argument for a static property (PHP 8.1 deprecation)": "patches/pest-plugin-browser-5.0.0-reset-assertions-static-property.patch",
        "Fix PlaywrightNpmServer::start() launching via SystemProcess::fromShellCommandline() (a plain command string), which proc_open() routes through /bin/sh -c on this environment -- Symfony ends up tracking the shell's PID, not the real playwright run-server process underneath it, so stop()'s SIGTERM only reaches the shell and the real server survives, reparented to the nearest subreaper, on every run regardless of whether the suite passed. Ported the same fix already applied and confirmed working for the plugin's own pre-5.0 PlaywrightNpmServer (a differently-located/structured class the 4.3.1->5.0.0 rewrite silently reintroduced this exact bug for): build the process from an argv array instead, which bypasses the shell entirely": "patches/pest-plugin-browser-5.0.0-stop-server-without-shell.patch"
      },
      "pestphp/pest-plugin-mutate": {
        "Bound the composed --filter argument length in MutationTest::start() -- a mutation covered by hundreds/thousands of tests can build a --filter regex past Linux's 128 KiB MAX_ARG_STRLEN, crashing proc_open() with ProcessStartFailedException (\"Argument list too long\") and killing the entire test:mutate run; falls back to running the full testsuite for that one mutant instead, which is always correctness-preserving": "patches/pest-plugin-mutate-5.0.1-bound-filter-argument-length.patch"
      }
    },
    "phpstan/extension-installer": {
      "ignore": [
        "tomasvotruba/type-coverage"
      ]
    }
  },
  "scripts": {
    "analyse": [
      "@analyse:phpstan"
    ],
    "analyse:phpstan": [
      "@php bin/piwigo phpstan-latte:compile",
      "@php vendor/bin/phpstan analyse"
    ],
    "analyse:phpstan:extensions": "bash tools/analyse-ported-extensions.sh",
    "bench": "@php vendor/bin/phpbench run",
    "check:doc-drift": "@php tools/doc-drift-check.php",
    "generate:latte-shims": "@php bin/piwigo phpstan-latte:generate-shims",
    "lint:composer": "@composer normalize --dry-run",
    "lint:composer:fix": "@composer normalize",
    "lint:latte": "@php tools/latte-lint.php",
    "lint:php": "@php vendor/bin/ecs check",
    "lint:psr4": "@composer dump-autoload --optimize --strict-psr",
    "lint:vartype": "@php bin/piwigo phpstan-latte:sync-vartype",
    "lint:vartype:fix": "@php bin/piwigo phpstan-latte:sync-vartype --fix",
    "precompile:templates": "@php bin/piwigo precompile:templates",
    "require-checker": "@php vendor/bin/composer-require-checker check --config-file=composer-require-checker.json composer.json",
    "sbom": "@composer CycloneDX:make-sbom --output-format=JSON --output-file=sbom-composer.cdx.json --spec-version=1.6 --output-reproducible",
    "test": [
      "bash tools/reimport-fixture.sh",
      "@php vendor/bin/pest --testsuite Unit,Arch --parallel",
      "@php vendor/bin/gesso coverage:merge --spec-base-path=openapi --specs=openapi --strip-prefixes=/api/v1"
    ],
    "test:browser": [
      "bash tools/reimport-fixture.sh",
      "@php vendor/bin/pest --testsuite Browser --exclude-group=fixture-regen --exclude-group=visual-regression --exclude-group=golden-html-snapshot --exclude-group=install-flow"
    ],
    "test:coverage": [
      "bash tools/reimport-fixture.sh",
      "@php vendor/bin/pest --testsuite Unit,Arch --coverage-php _data/coverage-raw/unit-arch.cov"
    ],
    "test:coverage:all": [
      "@test:coverage",
      "@test:coverage:integration",
      "@test:coverage:web",
      "@php tools/coverage-merge.php _data/coverage-raw/unit-arch.cov _data/coverage-raw/integration.cov"
    ],
    "test:coverage:integration": [
      "bash tools/reimport-fixture.sh",
      "@php vendor/bin/pest --testsuite Integration --coverage-php _data/coverage-raw/integration.cov"
    ],
    "test:coverage:web": [
      "rm -rf _data/coverage-raw/web",
      "bash tools/reimport-fixture.sh",
      "PIWIGO_COVERAGE=1 php vendor/bin/pest --testsuite Browser --exclude-group=fixture-regen --exclude-group=visual-regression --exclude-group=golden-html-snapshot --exclude-group=install-flow"
    ],
    "test:fixture-regen": "@php vendor/bin/pest --testsuite Browser --group=fixture-regen",
    "test:golden-html": [
      "bash tools/reimport-fixture.sh",
      "@php vendor/bin/pest --testsuite Browser --group=golden-html-snapshot"
    ],
    "test:install": "@php vendor/bin/pest --testsuite Browser --group=install-flow",
    "test:integration": [
      "bash tools/reimport-fixture.sh",
      "@php vendor/bin/pest --testsuite Integration"
    ],
    "test:mutate": "@php vendor/bin/pest --mutate --testsuite Unit --parallel --everything --covered-only",
    "test:profile": [
      "bash tools/reimport-fixture.sh",
      "@php -d memory_limit=1024M vendor/bin/pest --testsuite Unit,Arch --profile"
    ],
    "test:profile:browser": [
      "bash tools/reimport-fixture.sh",
      "@php -d memory_limit=1024M vendor/bin/pest --testsuite Browser --exclude-group=fixture-regen --exclude-group=visual-regression --exclude-group=golden-html-snapshot --exclude-group=install-flow --profile"
    ],
    "test:profile:integration": [
      "bash tools/reimport-fixture.sh",
      "@php -d memory_limit=1024M vendor/bin/pest --testsuite Integration --profile"
    ],
    "test:visual": [
      "bash tools/reimport-fixture.sh",
      "@php vendor/bin/pest --testsuite Browser --group=visual-regression"
    ],
    "unused": "@php vendor/bin/composer-unused --configuration=composer-unused.php"
  }
}
