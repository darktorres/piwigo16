# FrankenPHP/Caddy config for the production image (docs/PLAN-REPLAY.md P4).
# Mirrors the Apache .htaccess rules at the repo root + per-directory —
# see docs/DEPLOYMENT.md for the nginx equivalent.
#
# Listens on :80 as the non-root www-data user — verified empirically that
# Caddy/FrankenPHP wants CAP_NET_BIND_SERVICE at startup regardless of which
# port it ends up binding, so trying to dodge that by listening on a high
# port bought nothing. docker-compose.yml/Helm both do
# cap_drop: [ALL] + cap_add: [NET_BIND_SERVICE] — a single narrow exception,
# not the ~14-capability Docker default set and not root.

{
	auto_https off
	admin off
}

:80 {
	root * /app
	encode zstd br gzip

	# SEC-01: deny directories that must never be served directly.
	# install.php itself (the routed install entry point) stays reachable;
	# only the install/ directory (SQL dumps, upgrade scripts) is denied.
	# vendor/ and deploy/ were found still 200-ing during the P4 audit —
	# vendor/ is copied in explicitly via a cross-stage COPY --from=builder,
	# so .dockerignore's own vendor/ entry (which only governs this stage's
	# plain `COPY . .`) never applied to it. node_modules/docs/.git aren't
	# actually present in this image (.dockerignore excludes them from the
	# `COPY . .` and nothing cross-stage-copies them back in) but are denied
	# here too, matching .htaccess, as a defense-in-depth guard against a
	# future .dockerignore change silently reintroducing them.
	@denied path /config/* /tools/* /dev/* /src/* /tests/* /install/* /vendor/* /node_modules/* /docs/* /deploy/* /.git/*
	respond @denied 403

	# SEC-01: deny direct access to sensitive root-level tooling configs and
	# dependency manifests too — not just the directories above. Mirrors
	# .htaccess's equivalent file-level rule.
	@denied_files path /composer.json /composer.lock /package.json /bun.lock /phpstan.neon /psalm.xml /rector.php /ecs.php /knip.json /lefthook.yml /tsconfig.json /.stylelintrc.json /.prettierrc.json /lighthouserc.json /.size-limit.json /renovate.json /release-please-config.json /.release-please-manifest.json /eslint-suppressions.json /.editorconfig /.gitignore /.dockerignore /Dockerfile /docker-compose.yml /docker-compose.yaml /justfile /.env* /*.ts
	respond @denied_files 403

	# SEC-06: hashed Vite output never needs revalidation.
	@immutable path_regexp immutable \.[0-9a-f]{8}\.(js|css|woff2|avif|webp|png|jpg)$
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# [SEC-21] uploaded SVG/HTML must never render inline. Mirrors
	# .htaccess's equivalent rule -- see its own comment for the full
	# rationale (UploadService sanitizes SVG content at upload time; this
	# is defense-in-depth for anything that slips through, e.g. HTML).
	@uploadedSvgHtml path_regexp uploadedSvgHtml ^/upload/.*\.(svg|html?)$
	header @uploadedSvgHtml Content-Disposition attachment

	# Stable external contract for health/ready probes (Dockerfile
	# HEALTHCHECK, compose, Helm) even though there's no real router yet —
	# these currently resolve to the plain health.php/ready.php scripts.
	rewrite /health /health.php
	rewrite /ready /ready.php

	php_server
}
