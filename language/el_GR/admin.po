msgstr "Το όνομα χρήστη άλλαξε με επιτυχία"

msgid "Yes, let's proceed"
msgstr "Ναι, ας προχωρήσουμε"

msgid "You are about to set %s as main user instead of %s, do you wish to continue ?"
msgstr "Πρόκειται να ορίσετε τον %s σαν Κύριο Χρήστη αντί του %s, θέλετε να προχωρήσετε;"

msgid "The passwords do not match"
msgstr "Οι κωδικοί δεν ταιριάζουν"

msgid "Set as main user"
msgstr "Όρισέ τον σαν Κύριο Χρήστη"

msgid "Resend password link"
msgstr "Επανααποστολή του συνδέσμου του κωδικού"

msgid "Please complete all fields"
msgstr "Παρακαλώ συμπληρώστε όλα τα πεδία"

msgid "Password copied"
msgstr "Ο κωδικός αντιγράφηκε"

msgid "Copy the link below and send it to the user so the password can be set."
msgstr "Αντιγράψτε τον παρακάτω σύνδεσμο και στείλτε τον στον χρήστη για να μπορέσει να οριστεί ο κωδικός."

msgid "Copied link"
msgstr "Αντιγραμμένος σύνδεσμος"

msgid "Changing the main user"
msgstr "Αλλάζω τον Κύριο Χρήστη"

msgid "Cannot send an email to this user because he doesn't have an email address"
msgstr "Δεν είναι δυνατόν να σταλεί μήνημα σε αυτό τον χρήστη επειδή δεν έχει διεύθυνση."

msgid "%s is the new main user"
msgstr "%s είναι ο νέος Κύριος Χρήστης"

msgid "Ok, got it!"
msgstr "Εντάξει, το 'πιασα!"

msgid "Read the release note"
msgstr "Διαβάστε την ανακοίνωση"

msgid "What's new in version %s"
msgstr "Τί νέο υπάρχει στην έκδοση %s;"

msgid "A photo library administrator has created the following account for you:"
