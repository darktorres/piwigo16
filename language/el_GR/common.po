msgid "The secret will no longer be displayed. You must copy it to continue."
msgstr "Η μυστική σας λέξη δεν θα είναι πλέον ορατή. Πρέπει να την αντιγράψετε για να συνεχίσετε."

msgid "Verification code"
msgstr "Κωδικός επαλήθευσης"

msgid "Verify"
msgstr "Επαλήθευσε"

msgid "Here is your verification code:"
msgstr "Ορίστε ο κωδικός σας επαλήθευσης:"

msgid "If this wasn't you, please change your password immediately or contact your webmaster."
msgstr "Αν δεν είσασταν εσείς, παρακαλώ αλλάξτε αμέσως τον κωδικό σας ή επικοινωνήστε με τον Διαχειριστή της Σελίδας."

msgid "If you changed your password because you think it was stolen, we recommend revoking your %d API keys <a href=\"%s\">in your profile</a>."
msgstr "Εαν αλλάξατε τον κωδικό σας επειδή πιστεύετε ότι κλάπηκε, σας συνιστούμε να αναιρέσετε τα %d κλειδιά ΑΡΙ <a href=\"%s\">στο προφίλ σας</a>."

msgid "Too many attempts, please try later.."
msgstr "Υπερβολικά πολλές προσπάθειες, παρακαλώ προσπαθείστε αργότερα..."

msgid "Verification successful! You can now choose a new password."
msgstr "Η επαλήθευση ήταν επιτυχής! Μπορείτε τώρα να επιλέξετε ένα καινούριο κωδικό."

msgid "Your verification code"
msgstr "Ο κωδικός σας επαλήθευσης"

