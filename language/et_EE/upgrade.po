msgid "All sub-albums of private albums become private"
msgstr "Privaatsete albumite kõik alam-albumid saavad samuti privaatseteks"

msgid "As a precaution, following plugins have been deactivated. You must check for plugins upgrade before reactiving them:"
msgstr "Ettevaatusabinõuks on järgmised pluginad deaktiveeritud. Sa pead vaatama kas neile on saadaval uuendusi, enne kui sa need aktiveerid."

msgid "As a precaution, following themes have been deactivated. You must check for themes upgrade before reactiving them:"
msgstr "Ettevaatusabinõuks on järgmised teemad deaktiveeritud. Sa pead vaatama kas neile on saadaval uuendusi, enne kui sa need aktiveerid."

msgid "In <i>%s</i>, before <b>?></b>, insert:"
msgstr "In <i>%s</i>, before <b>?></b>, insert:"

msgid "Only administrator can run upgrade: please sign in below."
msgstr "Ainult administraatoril on õigus uuendada, logi sisse allpool."

msgid "Only thumbnails prefix and webmaster mail address have been saved from previous configuration"
msgstr "Ainult pisipiltide eesliides ja veebimeistri epostiaadress on eelmistest seadistustest talletatud"

msgid "Perform a maintenance check in [Administration>Tools>Maintenance] if you encounter any problem."
msgstr "Soorita hoolduskontroll [vt Administreerimine>Tööriistad>Hooldus] juhul kui sa märkad probleemi."

msgid "SQL queries"
msgstr "SQL andmebaasi päring"

msgid "Statistics"
msgstr "Statistika"

msgid "This page proposes to upgrade your database corresponding to your old version of Piwigo to the current version. The upgrade assistant thinks you are currently running a <strong>release %s</strong> (or equivalent)."
msgstr "On soovitatud uuendada andmebaas Piwigo uuele versioonile. Uuendamisprogrammi abiline arvab et praegu jooksutatakse <strong>versiooni %s</strong> (või sellele vastavat)."

msgid "Upgrade from version %s to %s"
msgstr "Ueenda versioonilt %s versioonile %s"

msgid "Upgrade informations"
msgstr "Uuendusest lähemalt"

msgid "Upgrade"
msgstr "Uuenda"

msgid "User permissions and group permissions have been erased"
msgstr "Kasutajate ja gruppide kasutamisõigused on kustutatud"

msgid "You do not have access rights to run upgrade"
msgstr "Sul puudub õigus käivitada uuendust"

msgid "total SQL time"
msgstr "SQL aeg kokku"

msgid "total upgrade time"
msgstr "uuendamisel kulutatud aeg kokku"

msgid "Discover what's new in Piwigo %s"
msgstr "Vaata, mida on uut Piwigo %s-s"

