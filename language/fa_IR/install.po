"X-Piwigo-Zero-Plural: false\n"

msgid "Installation"
msgstr "نصب"

msgid "Basic configuration"
msgstr "تنظیمات پایه"

msgid "Default gallery language"
msgstr "زبان پیشفرض گالری"

msgid "Database configuration"
msgstr "تنظیمات پایگاه داده"

msgid "Admin configuration"
msgstr "تنظیمات مدیریت"

msgid "Start Install"
msgstr "آغاز نصب"

msgid "It will be shown to the visitors. It is necessary for website administration"
msgstr "این به بازدیدکنندگان نمایش داده خواهد شده و برای مدیریت سایت ضروری است"

msgid "Connection to server succeed, but it was impossible to connect to database"
msgstr "ارتباط با سرور با موفقیت برقرار شد، ولی ارتباط با پایگاه داده با مشکل مواجه شد."

msgid "Can't connect to server"
msgstr "ارتباط با سرور برقرار نشد"

msgid "Host"
msgstr "میزبان (Host)"

msgid "User"
msgstr "نام کاربری"

msgid "user login given by your host provider"
msgstr "نام کاربری را از هاست دریافت کنید"

msgid "user password given by your host provider"
msgstr "گذرواژه را از هاست دریافت کنید"

msgid "Database name"
msgstr "نام پایگاه داده"

msgid "also given by your host provider"
msgstr "این مورد را نیز باید از هاست دریافت کنید"

msgid "Database table prefix"
msgstr "پیشوند جدول‌های پایگاه داده"

msgid "database tables names will be prefixed with it (enables you to manage better your tables)"
msgstr "نام تمام جدول‌های پایگاه داده با این پیشوند آغاز خواهند شد (این گزینه برای مدیریت بهتر پایگاه داده مفید خواهد بود)"

msgid "enter a login for webmaster"
msgstr "مشخصات ورود مدیرکل را وارد کنید"

msgid "webmaster login can't contain characters ' or \""
msgstr "مشخصات ورود مدیرکل نباید دارای کاراکترهای ' و \" باشند"

msgid "please enter your password again"
msgstr "لطفا گذرواژه‌ی خود را دوباره وارد کنید"

msgid "Keep it confidential, it enables you to access administration panel"
msgstr "گذرواژه را محرمانه نگه دارید، این گذرواژه دسترسی شما به پنل مدیریت را فراهم می‌کند"

msgid "Password [confirm]"
msgstr "تاييد گذرواژه"

msgid "verification"
msgstr "تایید"

msgid "Need help ? Ask your question on <a href=\"%s\">Piwigo message board</a>."
msgstr "به کمک نیاز دارید؟ پرسش خود را در <a href=\"%s\">تالارهای پشتیبانی Piwigo</a> مطرح کنید."

msgid "Visitors will be able to contact site administrator with this mail"
msgstr "بازدیدکنندگان می‌توانند به وسیله‌ی این ایمیل با مدیرکل ارتباط برقرار کنند"

msgid "PHP 5 is required"
msgstr "نسخه‌ی 5.3 پی‌اچ‌پی مورد نیاز است"

msgid "It appears your webhost is currently running PHP %s."
msgstr "به نظر می‌رسد هاست شما از نسخه‌ی %s پی‌اچ‌پی استفاده می‌کند."

msgid "Piwigo may try to switch your configuration to PHP 5 by creating or modifying a .htaccess file."
msgstr "Piwigo می‌تواند تنظیمات پی‌اچ‌پی شما را با ایجاد یا ویرایش یک فایل .htaccess به نسخه‌ی 5.3 تغییر دهد."

msgid "Note you can change your configuration by yourself and restart Piwigo after that."
msgstr "در نظر داشته باشید که می‌توانید خودتان تنظیمات را تغییر داده و Piwigo را دوباره راه‌اندازی کنید."

msgid "Try to configure PHP 5"
msgstr "در حال تلاش برای پیکربندی پی‌اچ‌پی 5.3"

msgid "Sorry!"
msgstr "شرمنده!"

msgid "Piwigo was not able to configure PHP 5."
msgstr "Piwigo قادر به پیکربندی پی‌اچ‌پی 5.3 نیست."

msgid "You may referer to your hosting provider's support and see how you could switch to PHP 5 by yourself."
msgstr "با سرویس دهنده‌ی هاست خود تماس گرفته و از آن‌ها بپرسید که چگونه می‌توانید هاست خود را به پی‌اچ‌پی 5.3 تغییر دهید."

msgid "Hope to see you back soon."
msgstr "به امید دیدار دوباره."

msgid "Congratulations, Piwigo installation is completed"
msgstr "Piwigo با موفقیت نصب شد"

msgid "An alternate solution is to copy the text in the box above and paste it into the file \"local/config/database.inc.php\" (Warning : database.inc.php must only contain what is in the textarea, no line return or space character)"
msgstr "یک راه دیگر این است که متن بالا را کپی کرده و بدون اضافه یا کم کردن حتی یک حرف، آن را در مسیر زیر قرار دهید: \n\"local/config/database.inc.php\" \n(هشدار: محتوای این فایل باید کاملا با فیلد متن بالا مشابه بوده و خط یا فاصله‌ی اضافی نداشته باشد)"

msgid "Creation of config file local/config/database.inc.php failed."
msgstr "ایجاد فایل local/config/database.inc.php با مشکل مواجه شد."

msgid "Download the config file"
msgstr "دانلود فایل پیکربندی (Config)"

msgid "You can download the config file and upload it to local/config directory of your installation."
msgstr "می‌توانید فایل پیکربندی را دانلود کرده و در مسیر local/config در محلی که گالری را نصب کرده‌اید، آپلود کنید."

msgid "Don't hesitate to consult our forums for any help : %s"
msgstr "هر مشکلی که داشتید را در انجمن مطرح کنید: %s"

msgid "Just another Piwigo gallery"
msgstr "یک گالری دیگر با Piwigo"

msgid "Welcome to my photo gallery"
msgstr "به گالری عکس من خوش آمدید"

msgid "Welcome to your new installation of Piwigo!"
msgstr "به گالری Piwigo خود خوش آمدید!"

msgid "localhost or other, supplied by your host provider"
msgstr "localhost یا آدرس دیگر، این مورد را باید از هاست دریافت کنید"

msgid "PHP version %s required (you are running on PHP %s)"
msgstr "نسخه‌ی %s پی‌اچ‌پی مورد نیاز است (شما در حال حاضر از نسخه‌ی %s استفاده می‌کنید)"

