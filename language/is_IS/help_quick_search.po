msgid "photos posted in 2003"
msgstr "myndir birtar árið 2003"

msgid "photos taken in 2003"
msgstr "myndir teknar árið 2003"

msgid "return photos less than 700px high"
msgstr "myndir sem eru minni en 700px á hæð"

msgid "return photos wider than 500px"
msgstr "myndir breiðari en 500px"

msgid "return photos with at least 1,000 views"
msgstr "skila myndum með að minnsta kosti 1.000 áhorfum"

msgid "returns photos of 12 megapixels or more"
msgstr "skilar myndum sem eru 12 megapixlar eða stærri"

msgid "returns photos of 5 megapixels"
msgstr "skilar myndum með 5 megapixla upplausn"

msgid "up to 100 (inclusive)"
msgstr "allt að 100 (meðtalið)"

msgid "will give you all photos with at least one note."
msgstr "mun skila þér öllum myndum með að minnsta kosti einni athugasemd."

msgid "will give you photos without notes."
msgstr "mun skila þér myndum án athugasemda."

msgid "Searches photos by taken date."
msgstr "Leitar að myndum eftir tökudegi."

msgid "Searches photos by width/height ratio."
msgstr "Leitar að myndum eftir breidd-/hæðarhlutfalli."

msgid "Searches photos with a given width or height."
msgstr "Leitar að myndum með tiltekinni breidd eða hæð."

msgid "Supported numeric operators"
msgstr "Studdar tölulegar aðgerðir"

msgid "The quick search engine allows you to use boolean operators to refine your search. By default, the search applies to all keywords. Searches are not case sensitive."
msgstr "Hraðleitarvélin gerir þér kleift að nota Boolean aðgerðir til að betrumbæta leitina. Sjálfgefið er að leitin eigi við um öll leitarorð. Leitir eru ekki hástafa- og lágstafa-næm."

msgid "These operators can be used with numeric fields such as"
msgstr "Þessar aðgerðir er hægt að nota með tölulegum reitum eins og"

msgid "Use quotes to search for an exact keyword or phrase."
msgstr "Notaðu gæsalappir til að leita að nákvæmu leitarorði eða orðasambandi."

msgid "With keywords"
msgstr "Með leitarorðum"

msgid "between 10 and 100 (inclusive)"
msgstr "á milli 10 og 100 (að meðtöldum)"

msgid "equals 100"
msgstr "jafngildir 100"

msgid "finds files between 1MB and 10MB."
msgstr "finnur skrár á milli 1MB og 10MB."

msgid "finds panoramas"
msgstr "finnur víðmyndir"

msgid "finds photo 123 to 126 (it may find between 0 and 4 photos, because photos can be deleted)"
msgstr "finnur mynd 123 til 126 (það gæti fundið á milli 0 og 4 myndir, því hægt er að eyða myndum)"

msgid "finds photos from compact cameras in portrait or landscape modes"
msgstr "finnur myndir úr litlum myndavélum í skammsniðnum eða láréttum stillingum"

msgid "from 100 and above"
msgstr "frá 100 og upp úr"

msgid "greater than 100"
msgstr "meiri en 100"

msgid "less than 100"
msgstr "færri en 100"

msgid "photos after Jan 1st 2008"
msgstr "myndir eftir 1. janúar 2008"

msgid "photos from 2003 to 2008"
msgstr "myndir frá 2003 til 2008"

msgid "photos from may 2003"
msgstr "myndir frá maí 2003"

msgid "Add a dash (-) or NOT before a word to exclude from search. Note that NOT acts as a filtering operator so you cannot have a search containing only NOT operators. You cannot combine OR with NOT (john OR NOT bill is not valid)"
msgstr "Bætið við bandstriki (-) eða EKKI fyrir framan orð sem á að útiloka úr leit. Athugið að NOT virkar sem síunarvirki þannig að ekki er hægt að leita að því að það innihaldi eingöngu NOT virkjana. Ekki er hægt að sameina OR með NOT (John OR NOT bill er ekki gilt)."

msgid "Add an OR between words."
msgstr "Bættu við OR á milli orða."

msgid "Exact search"
msgstr "Nákvæm leit"

msgid "Exclude"
msgstr "Útiloka"

msgid "Grouping"
msgstr "Flokkun"

msgid "Here is a list of actions you can perform:"
msgstr "Hér er listi yfir aðgerðir sem þú getur framkvæmt:"

msgid "OR inclusive"
msgstr "OR innifalið"

msgid "Others"
msgstr "Aðrir"

msgid "Same principle as for"
msgstr "Sama meginregla og fyrir"

msgid "Search using extended syntax"
msgstr "Leita með útvíkkaðri setningafræði"

msgid "Searches by author."
msgstr "Leitar eftir höfundi."

msgid "Searches by file name."
msgstr "Leitar eftir skráarnafni."

msgid "Searches for photos by number of views."
msgstr "Leitar að myndum eftir fjölda skoðana."

msgid "Searches only for photos with the given words in title or description."
msgstr "Leitar aðeins að myndum með tilgreindum orðum í titli eða lýsingu."

msgid "Searches only in tag names without looking at photo titles or descriptions."
msgstr "Leitar aðeins í merkjaheitum án þess að skoða myndatitla eða lýsingar."

msgid "Searches photos by file size."
msgstr "Leitar að myndum eftir skráarstærð."

msgid "Searches photos by its numeric identifier in Piwigo."
msgstr "Leitar að myndum eftir tölulegu auðkenni þeirra í Piwigo."

msgid "Searches photos by posted date."
msgstr "Leitar að myndum eftir birtingardegi."

msgid "Searches photos by rating."
msgstr "Leitar að myndum eftir einkunn."

msgid "Searches photos by size in pixels."
msgstr "Leitar að myndum eftir stærð í pixlum."

