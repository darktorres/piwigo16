msgid "Upgrade"
msgstr "განახლება"

msgid "Upgrade from version %s to %s"
msgstr "განახლება %s ვერსიიდან %s ვერსიამდე"

msgid "Statistics"
msgstr "სტატისტიკა"

msgid "total upgrade time"
msgstr "განახლების საერთო დრო"

msgid "total SQL time"
msgstr "SQL საერთო დრო"

msgid "SQL queries"
msgstr "SQL მოთხოვნა"

msgid "Upgrade informations"
msgstr "ინფორმაცია განახლებებზე"

msgid "Perform a maintenance check in [Administration>Tools>Maintenance] if you encounter any problem."
msgstr "განახორციელეთ მომსახურება [ადმინისტრირება>ინსტრუმენტები>მომსახურება] თუკი შეგექმნათ რაიმე პრობლემა."

msgid "Only administrator can run upgrade: please sign in below."
msgstr "მხოლოდ ადმინისტრტორს შეუძლია განახლების გაშვება: შეამოწმეთ ქვევით."

msgid "You do not have access rights to run upgrade"
msgstr "თქვენ არ გაქვთ განახლების გაშვების უფლება"

msgid "All sub-albums of private albums become private"
msgstr "პრივატული (კერძო) კატეგორიის ყველა ქვეკატეგორია იქნება პრივატული"

msgid "User permissions and group permissions have been erased"
msgstr "მომხმარებლების და ჯგუფების დაშვების უფლებები წაშლილია"

msgid "Only thumbnails prefix and webmaster mail address have been saved from previous configuration"
msgstr "მხოლოდ ესკიზების პრეფიქსები და ვებმასტერის ფოსტის მისამართი იქნა შენახული წინა კონფიგურაციიდან"

msgid "This page proposes to upgrade your database corresponding to your old version of Piwigo to the current version. The upgrade assistant thinks you are currently running a <strong>release %s</strong> (or equivalent)."
msgstr "ეს გვერდი გთავაზობთ მონაცემთა ბაზის მოდერნიზაციას,თქვენი Piwigo ძველი ვერსიიდან ახალ ვერსიამდე. განახლების დამხმარე საშუალება ფიქრობს,რომ თქვენ ამჟამად იყენებთ <b> ვერსია %s </b> (ან ეკვივალენტურს)."

msgid "As a precaution, following plugins have been deactivated. You must check for plugins upgrade before reactiving them:"
msgstr "სასურველია,რომ შემდეგი პლაგინები დეზაქტივირებული იყოს. თქვენ უნდა შეამოწმოთ პლაგინების განახლება მანამდე,სანამ მოახდენთ მათ აქტივაციას:"

msgid "In <i>%s</i>, before <b>?></b>, insert:"
msgstr " %s, მდე ?>, ჩავსვათ:"

msgid "As a precaution, following themes have been deactivated. You must check for themes upgrade before reactiving them:"
msgstr "უსაფრთხოების მიზნით შემდეგი თემები გამორთულია. თქვენ უნდა შეამოწმოთთემების განახლება? სანამ მათ ახლიდან ჩართავთ:"

