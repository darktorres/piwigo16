msgid "Upgrade"
msgstr "Uzlabošana"

msgid "This page proposes to upgrade your database corresponding to your old version of Piwigo to the current version. The upgrade assistant thinks you are currently running a <strong>release %s</strong> (or equivalent)."
msgstr "Šī lapa piedāvā uzlabot Jūsu Piwigo veco datu bāzi uz jaunāko versiju. Uzlabošanas asistents domā, ka Jūs patlaban lietojat <strong>release %s</strong> ( vai ekvivalentu)."

msgid "Upgrade from version %s to %s"
msgstr "Uzlabojums no  %s versijas uz %s"

msgid "Statistics"
msgstr "Statistika"

msgid "total upgrade time"
msgstr "kopējais uzlabošanas procesa laiks"

msgid "total SQL time"
msgstr "kopējais SQL laiks"

msgid "SQL queries"
msgstr "SQL rindas"

msgid "Upgrade informations"
msgstr "Informācija par uzlabojumu"

msgid "Perform a maintenance check in [Administration>Tools>Maintenance] if you encounter any problem."
msgstr "Veiciet profilakses pārbaudi [Administrēšana>Rīki>Profilakse] , ja ir gadījusies kāda kļūme."

msgid "As a precaution, following plugins have been deactivated. You must check for plugins upgrade before reactiving them:"
msgstr "Piesardzības nolūkos tiek atslēgti sekojoši spraudņi. Pirms tos atkal pieslēgt, pārbaudiet vai nav pieejami to uzlabojumi:"

msgid "Only administrator can run upgrade: please sign in below."
msgstr "Uzlabojumu var veikt tikai administrators: lūdzu veiciet pierakstīšanos zemāk."

msgid "You do not have access rights to run upgrade"
msgstr "Jums nav pieejas tiesību, lai veiktu uzlabojumu"

msgid "All sub-albums of private albums become private"
msgstr "Visi privātā albūma apakšalbūmi kļūst privāti"

msgid "User permissions and group permissions have been erased"
msgstr "Lietotāju un grupu piekļuves tiesības ir izdzēstas"

msgid "Only thumbnails prefix and webmaster mail address have been saved from previous configuration"
msgstr "No iepriekšējās konfigurācijas ir saglabāti tikai sīkbilžu prefiksi un webmāstera e-pasta adreses"

msgid "In <i>%s</i>, before <b>?></b>, insert:"
msgstr "Iekš <i>%s</i>, pirms <b>?></b>,ievietot:"

msgid "As a precaution, following themes have been deactivated. You must check for themes upgrade before reactiving them:"
msgstr "Piesardzības pasākumu dēļ, sekojošas tēmas ir deaktivētas. Pirms atkal tās aktivēt, jums jāpārbauda, vai nav pieejami šo tēmu jauninājumi:"

msgid "Discover what's new in Piwigo %s"
msgstr "Uzzini, kas jauns Piwigo %s"

