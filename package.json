{
  "name": "piwigo-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:js": "eslint .",
    "lint:js:fix": "bun run lint:js -- --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "bun run lint:css -- --fix",
    "format": "prettier --check \"**/*.{ts,json,md,css}\"",
    "format:fix": "prettier --write \"**/*.{ts,json,md,css}\"",
    "knip": "knip",
    "size-limit": "size-limit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@size-limit/file": "^12.1.0",
    "@size-limit/preset-app": "^12.1.0",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "knip": "^6.24.0",
    "lefthook": "^2.1.9",
    "prettier": "^3.9.4",
    "size-limit": "^12.1.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "web-vitals": "^5.3.0"
  }
}
