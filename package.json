{
  "name": "piwigo-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:js": "eslint .",
    "lint:js:fix": "bun run lint:js -- --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "bun run lint:css -- --fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:openapi": "redocly lint openapi/openapi.yaml",
    "generate:api-client": "openapi-typescript openapi/openapi.yaml -o openapi/client/schema.d.ts",
    "format": "prettier --check \"**/*.{ts,cjs,json,md,css}\"",
    "format:fix": "prettier --write \"**/*.{ts,cjs,json,md,css}\"",
    "format:latte": "prettier --check --plugin=./tools/latte-prettier/plugin.cjs \"{themes,template-extension}/**/*.latte\"",
    "format:latte:fix": "prettier --write --plugin=./tools/latte-prettier/plugin.cjs \"{themes,template-extension}/**/*.latte\"",
    "knip": "knip",
    "size-limit": "size-limit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@cyclonedx/cyclonedx-npm": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@redocly/cli": "^2.46.1",
    "@size-limit/file": "^13.0.3",
    "@size-limit/preset-app": "^13.0.3",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.1",
    "knip": "^6.32.0",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.2",
    "openapi-typescript": "^7.13",
    "playwright": "1.61.1",
    "prettier": "^3.9.6",
    "size-limit": "^13.0.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "openapi-fetch": "^0.17",
    "web-vitals": "^6.1.0"
  },
  "overrides": {
    "tar": ">=7.5.22 <8.0.0",
    "ip-address": ">=10.4.0 <11.0.0",
    "postcss": ">=8.5.26 <9.0.0",
    "fast-uri": ">=3.1.5 <4.0.0",
    "body-parser": ">=1.20.6 <2.0.0"
  }
}
