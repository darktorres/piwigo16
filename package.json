{
  "name": "piwigo-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e/tsconfig.json",
    "lint:js": "eslint .",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "npm run lint:css -- --fix",
    "lint:md": "markdownlint \"**/*.md\" --ignore-path .markdownlintignore",
    "lint:md:fix": "npm run lint:md -- --fix",
    "openapi:dump": "php tools/openapi-dump.php > openapi.json",
    "lint:openapi": "npm run openapi:dump && redocly lint openapi.json",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:md",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix && npm run lint:md:fix",
    "format": "prettier --check \"**/*.{ts,json,md,css}\"",
    "format:fix": "prettier --write \"**/*.{ts,json,md,css}\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('_data/combined',{recursive:true,force:true})\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.0",
    "@redocly/cli": "^2.30.6",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.8.3",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.11"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.1",
    "@uppy/xhr-upload": "^5.2.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-dayjs-4": "^1.0.4",
    "datatables.net": "^2.3.8",
    "datatables.net-dt": "^2.3.8",
    "dayjs": "^1.11.20",
    "flatpickr": "^4.6.13",
    "glightbox": "^3.3.1",
    "js-cookie": "^3.0.5",
    "nouislider": "^15.8.1",
    "tippy.js": "^6.3.7",
    "tom-select": "^2.6.0"
  }
}
