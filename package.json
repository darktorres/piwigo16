{
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "cd tests && bun install && cd ../themes/bootstrap_darkroom && bun install --omit=dev",
    "reinstall": "bunx rimraf node_modules tests/node_modules themes/bootstrap_darkroom/node_modules && bun install && cd tests && bun install && cd ../themes/bootstrap_darkroom && bun install --omit=dev",
    "build": "vite build",
    "test": "cd tests && bunx playwright test",
    "test:headed": "cd tests && bunx playwright test --headed",
    "test:report": "cd tests && bunx playwright show-report",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:tests": "cd tests && bunx tsc --noEmit",
    "lint": "bunx eslint admin themes plugins",
    "lint:tests": "cd tests && bunx eslint src",
    "lint:css": "bunx stylelint \"**/*.css\"",
    "lint:ox": "bunx oxlint admin themes plugins --deny-warnings --ignore-pattern \"**/node_modules/**\" --ignore-pattern \"**/dist/**\"",
    "format": "bunx prettier --write \"admin/**/*.{ts,js,css}\" \"themes/**/*.{ts,js,css}\" \"plugins/**/*.{ts,js,css}\" --ignore-path .gitignore",
    "format:check": "bunx prettier --check \"admin/**/*.{ts,js,css}\" \"themes/**/*.{ts,js,css}\" \"plugins/**/*.{ts,js,css}\" --ignore-path .gitignore",
    "knip": "bunx knip"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "chart.js": "4.5.1",
    "chartjs-adapter-moment": "^1.0.1",
    "codemirror": "6.0.2",
    "cropperjs": "^2.1.1",
    "datatables.net-dt": "^2.3.7",
    "dropzone": "^6.0.0-beta.2",
    "flatpickr": "^4.6.13",
    "glightbox": "^3.3.1",
    "moment": "~2.30.1",
    "mousetrap": "1.6.5",
    "nouislider": "^15.8.1",
    "photoswipe": "5.4.4",
    "piecon": "github:lipka/piecon#0.5.0",
    "sortablejs": "^1.15.7",
    "tippy.js": "^6.3.7",
    "tom-select": "^2.6.0",
    "underscore": "1.13.8"
  },
  "patchedDependencies": {
    "photoswipe@5.4.4": "patches/photoswipe@5.4.4.patch"
  },
  "devDependencies": {
    "@eslint/css": "^1.1.0",
    "@eslint/js": "^10.0.1",
    "@types/chart.js": "^4.0.1",
    "@types/codemirror": "^5.60.17",
    "@types/dropzone": "^5.7.9",
    "@types/mousetrap": "^1.6.15",
    "@types/node": "^25.6.0",
    "@types/sortablejs": "^1.15.9",
    "@types/underscore": "^1.13.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.2.1",
    "eslint-plugin-no-jquery": "^3.1.1",
    "globals": "^17.5.0",
    "knip": "^6.4.1",
    "oxlint": "^1.60.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "stylelint": "^17.8.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.8"
  }
}
