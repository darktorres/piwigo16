{
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "cd tests && bun install && cd ../themes/bootstrap_darkroom && bun install --omit=dev",
    "reinstall": "bunx rimraf node_modules tests/node_modules themes/bootstrap_darkroom/node_modules && bun install && cd tests && bun install && cd ../themes/bootstrap_darkroom && bun install --omit=dev",
    "build": "vite build",
    "test": "cd tests && bunx playwright test",
    "test:headed": "cd tests && bunx playwright test --headed",
    "test:report": "cd tests && bunx playwright show-report",
    "typecheck": "cd tests && bunx tsc --noEmit",
    "lint": "bunx eslint admin themes plugins --max-warnings=0",
    "lint:tests": "cd tests && bunx eslint src"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "chart.js": "2.9.3",
    "codemirror": "2.33.0",
    "cropperjs": "1",
    "datatables.net-dt": "^2.3.7",
    "dropzone": "5",
    "flatpickr": "^4.6.13",
    "glightbox": "^3.3.1",
    "photoswipe": "5.4.4",
    "jgrowl": "1.3.0",
    "moment": "~2.26.0",
    "mousetrap": "1.4.6",
    "nouislider": "^15.8.1",
    "piecon": "github:lipka/piecon#0.5.0",
    "sortablejs": "^1.15.7",
    "tippy.js": "^6.3.7",
    "tom-select": "^2.5.2",
    "underscore": "1.5.2"
  },
  "patchedDependencies": {
    "photoswipe@5.4.4": "patches/photoswipe@5.4.4.patch"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-plugin-no-jquery": "^3.1.1",
    "globals": "^16.2.0",
    "rimraf": "^6.0.1",
    "vite": "^8.0.8"
  }
}
