+        // pg_transaction_status() reports a stale ACTIVE status here
+        // unless something first prompts libpq to process the pending
+        // server response -- pg_connection_busy() does exactly that as
+        // a side effect. Without this, a transaction aborted by an
+        // earlier failed query (a real, common case: any caller that
+        // catches a query exception and lets this Statement go out of
+        // scope during unwinding) makes this DEALLOCATE call itself
+        // fail with "current transaction is aborted, commands ignored
+        // until end of transaction block" -- skip it in that case,
+        // since PostgreSQL discards every prepared statement anyway
+        // once the connection closes.
+        pg_connection_busy($this->connection);
+
+        $status = pg_transaction_status($this->connection);
+        if ($status === PGSQL_TRANSACTION_INERROR || $status === PGSQL_TRANSACTION_UNKNOWN) {
+            return;
+        }
