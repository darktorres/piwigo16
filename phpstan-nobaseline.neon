parameters:
    level: 7
    paths:
        - include
        - admin
        - src
        - install.php
        - upgrade.php
        - index.php
        - ws.php
        - picture.php
        - identification.php
        - profile.php
        - register.php
        - password.php
        - search.php
        - tags.php
        - comments.php
        - notification.php
        - feed.php
        - i.php
    excludePaths:
        analyseAndScan:
            - install/db/*.php
            - language/*.php
            - include/smarty/*
            - include/pwgsession_php7.class.php
            - vendor/*
        analyse:
            # Vendored third-party libraries bundled in include/ — scanned for types, not analysed.
            - include/feedcreator.class.php
            - include/pclzip.lib.php (?)
            - include/jshrink.class.php
            - include/minify/**
            - include/php_compat/**
            - include/phpmailer/**
            - include/phpqrcode.php
            - include/emogrifier.class.php
            - include/mdetect.php
            - include/passwordhash.class.php
            - admin/include/pclzip.lib.php (?)
    bootstrapFiles:
        - tools/phpstan-bootstrap.php
        - tools/phpstan-types.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # local/config/config.inc.php and local/config/database.inc.php are gitignored runtime
        # files. Linux CI (lint job) never has them; Windows dev has them after install/setup.
        # reportUnmatched: false silently skips entries on platforms that don't produce the error.
        - message: '#^Path in include\(\) "\./local/config/config\.inc\.php" is not a file or it does not exist\.$#'
          reportUnmatched: false
        - message: '#^Path in include\(\) "\./local/config/database\.inc\.php" is not a file or it does not exist\.$#'
          reportUnmatched: false
rules:
    - Piwigo\Tools\PhpStan\NoDynamicNewRule
    - Piwigo\Tools\PhpStan\NoGlobalInSrcRule
includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
