parameters:
    level: 9
    paths:
        - include
        - admin
        - src
        - tools/phpstan
        - install.php
        - upgrade.php
        - index.php
        - ws.php
        - picture.php
        - identification.php
        - profile.php
        - register.php
        - password.php
        - search.php
        - tags.php
        - comments.php
        - notification.php
        - feed.php
        - i.php
    excludePaths:
        analyseAndScan:
            - install/db/*.php
            - language/*.php
            - vendor/*
    bootstrapFiles:
        - tools/phpstan-bootstrap.php
        - tools/phpstan-types.php
    ignoreErrors:
        # local/config/database.inc.php is created by the installer, not committed.
        # Both call sites guard the include with a file_exists() check.
        -
            identifier: include.fileNotFound
            message: '#local/config/database\.inc\.php#'
            paths:
                - install.php
                - upgrade.php
rules:
    - Piwigo\Tools\PhpStan\ConfigKeyExistsRule
    - Piwigo\Tools\PhpStan\NoDynamicNewRule
    - Piwigo\Tools\PhpStan\NoGlobalInSrcRule
    - Piwigo\Tools\PhpStan\StrictTypesRequiredRule
services:
    -
        class: Piwigo\Tools\PhpStan\TriggerChangeDynamicReturnType
        tags: [phpstan.broker.dynamicFunctionReturnTypeExtension]
    -
        class: Piwigo\Tools\PhpStan\PwgGetSessionVarDynamicReturnType
        tags: [phpstan.broker.dynamicFunctionReturnTypeExtension]
includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
