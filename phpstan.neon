includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 10
    # Defaults to the machine-wide sys_get_temp_dir()/phpstan, shared by
    # every worktree on this box -- the dead-code-detector extension's own
    # UsageCacheStorage keys its cache purely by content hash and garbage-
    # collects entries its own process didn't read, so two worktrees
    # analysing overlapping content concurrently race on the same cache
    # files ("DCD cache file not found for hash ..." is the symptom).
    # %currentWorkingDirectory% (already used below for analysisDir)
    # embedded in a /tmp path -- not a path *inside* this repo -- gives
    # each worktree a distinct, real filesystem path (e.g. /tmp/phpstan
    # /home/torres/piwigo17-rewrite) with zero collision risk, and avoids
    # needing every other tool (ECS, etc.) to also learn to exclude it --
    # a first attempt using _analysis/phpstan-tmp inside the repo made
    # ECS's own file-count balloon from ~290 to ~9700, since a single
    # PHPStan run seeds tens of thousands of tiny dead-code-detector cache
    # files there.
    tmpDir: /tmp/phpstan%currentWorkingDirectory%
    bootstrapFiles:
        - tests/phpstan-dba-bootstrap.php
    doctrine:
        objectManagerLoader: tests/phpstan-object-manager.php
    stubFiles:
        - phpstan-stubs/Imagick.stub.php
        - phpstan-stubs/LatteCachingIterator.stub.php
    paths:
        - .
    excludePaths:
        analyseAndScan:
            - vendor/*
            # JS dependency tree — some npm packages ship stray .php files
            # (e.g. flatted's PHP port) that aren't part of this project.
            - node_modules/*
            # stubFiles content above -- a fake `class Imagick` redeclaration
            # that exists purely to override one bundled-stub method
            # signature, not real application code to lint/scan.
            - phpstan-stubs/*
            # Runtime-compiled Latte templates + combined JS/CSS cache, not
            # source (verified real: temporarily un-excluding produces
            # 1000+ errors in generated template code).
            - _data/*
            # Standalone maintenance script; its own header comment documents
            # that knplabs/github-api must be `composer require`d manually
            # before running it — it's not one of this project's own deps.
            - tools/github_issues.php
            # Part II (web-root isolation): these are symlinks bridging
            # public/ (the new DocumentRoot) back to already-scanned real
            # directories (themes/, dist/, _data/combined/). PHPStan follows
            # symlinked directories when scanning `.` -- without this, the
            # exact same PHP files get analysed twice under two different
            # path strings -- wasted work today, and would double-report any
            # future error under both paths. (No longer about baseline
            # path-matching -- the PHPStan baseline was retired; verified
            # by temporarily removing this exclusion and re-running: file
            # count rose with the analysis otherwise unchanged.) The former
            # separate public/admin/themes symlink (and its own 8 PHP files)
            # is gone -- include/+admin/ deletion batch relocated
            # admin/themes/ to themes/admin/, so those 8 files are already
            # covered by the public/themes/* exclusion below, nested one
            # level deeper.
            - public/themes/*
            - public/dist/*
            - public/_data/combined/*
            # ECS config: references PhpCsFixer\Fixer\...\*Fixer::class
            # constants that only exist nested inside
            # vendor/symplify/easy-coding-standard/vendor/friendsofphp/
            # php-cs-fixer (bundled, not a direct composer.json dependency —
            # confirmed via `find vendor -iname '*php-cs-fixer*'`, nothing at
            # the top level). ECS's own bootstrap resolves them fine at
            # runtime (this file runs clean on every `composer lint:php`),
            # but our root autoloader can't see them, so PHPStan types every
            # ::class reference here as plain class-string instead of
            # class-string<FixerInterface>. Tooling config, not application
            # code.
            - ecs.php
    ignoreErrors:
        -
            # Queries here target an in-memory sqlite scratch table created
            # fresh per test, never the live DB the bootstrap connects to.
            identifier: dba.syntaxError
            path: tests/Unit/Db/BatchWriterTest.php
        -
            # Queries here target a throwaway table this file's own
            # setUp()/tearDown() drops and recreates, never the live
            # reflector's persistent schema.
            identifier: dba.syntaxError
            path: tests/Integration/BatchWriterTest.php
        -
            # No usage provider for this codebase's own event-dispatch/
            # plugin-hook system -- these are public payload DTOs for an
            # extension-point system, correctly unread in-tree when no
            # listener is registered yet.
            identifier: shipmonk.deadProperty.neverRead
            path: '*/Event/*'
        -
            # tearDown()/finally restores a runtime-captured snapshot row via
            # $conn->insert($table, $row), $row built from a prior
            # fetchAssociative() call -- inherently a dynamically-shaped
            # array, not a literal one. dba.keyValue requires a constant
            # array by design; this pattern can't satisfy it by any code
            # change.
            identifier: dba.keyValue
            path: tests/Integration/Admin/UserActivityPageRendererTest.php
        -
            # Same runtime-captured-snapshot-restore shape as
            # UserActivityPageRendererTest.php above.
            identifier: dba.keyValue
            path: tests/Integration/DerivativeSizeRepositoryTest.php
        -
            # Same runtime-captured-snapshot-restore shape as
            # UserActivityPageRendererTest.php above.
            identifier: dba.keyValue
            path: tests/Integration/ImageStdParamsTest.php
        -
            # MySQL's `ON DUPLICATE KEY UPDATE` / Postgres's `ON CONFLICT`
            # inside driver-conditional code (own comment documents the
            # split) -- phpstan-dba validates the string literal from BOTH
            # branches against whichever one connection it currently has;
            # only the branch matching the configured driver ever actually
            # executes.
            identifier: dba.syntaxError
            path: tests/Integration/NoPhotoYetRendererTest.php
        -
            # MySQL-only `REPLACE INTO` inside driver-conditional code,
            # validated against whichever one connection phpstan-dba has
            # (own comment documents the ON CONFLICT portable equivalent)
            # -- same shape as ContractTestCase.php above.
            identifier: dba.syntaxError
            path: tests/Integration/SessionRepositoryTest.php
        -
            # Postgres's `::text` cast (needed because the target column is
            # json/jsonb, which rejects a bare LIKE, or to disambiguate a
            # bound parameter's type inside a function call) is misread by
            # phpstan-dba's own placeholder-scanning regex as a bound
            # parameter named "text".
            identifier: dba.syntaxError
            path: tests/Integration/GroupServiceTest.php
        -
            # pg_advisory_unlock()/pg_try_advisory_lock() are Postgres-only
            # functions, validated against whichever one connection
            # phpstan-dba has -- only the branch matching the configured
            # driver ever actually executes (own docblock documents the
            # MySQL GET_LOCK()/RELEASE_LOCK() split).
            identifier: dba.syntaxError
            path: src/Piwigo/Db/AdvisorySessionLock.php
        -
            # fetchTomorrow()/fetchFutureDatesFor() each branch across 3
            # real platforms (MySQL/Postgres/SQLite) -- validated against
            # whichever one connection phpstan-dba has, only the branch
            # matching the configured driver ever actually executes (own
            # class docblock documents the per-platform split). A 3-way
            # branch on one query line can surface more than one distinct
            # dba.syntaxError instance, which is why this lives here
            # (path-level, unlimited occurrences) rather than as an inline
            # per-line ignore comment (matches a single reported error).
            identifier: dba.syntaxError
            path: src/Piwigo/Db/SqlDialectExecutor.php
        -
            # version()/currentDateTime()/getTableFingerprint() each branch
            # across the same 3 real platforms -- sqlite_version()/
            # datetime('now')/strftime() are SQLite-only, validated against
            # whichever one connection phpstan-dba has (own docblock
            # documents the per-platform split), matching
            # SqlDialectExecutor.php's own identical reasoning above.
            identifier: dba.syntaxError
            path: src/Piwigo/Db/DbInfo.php
        -
            # setval()/pg_get_serial_sequence() are Postgres-only, validated
            # against whichever one connection phpstan-dba has -- only the
            # branch matching the configured driver ever actually executes
            # (own comment documents the MySQL AUTO_INCREMENT equivalent).
            identifier: dba.syntaxError
            path: tests/Integration/HistoryServiceTest.php
        -
            # history.ip is genuinely `ip` on Postgres but `IP` on MySQL
            # (a pre-existing cross-platform column-name-case discrepancy
            # baked into the migrations, confirmed live) -- MySQL's own
            # column-name matching is case-insensitive regardless, so the
            # lowercase literal here is correct and works at runtime; only
            # phpstan-dba's schema lookup does exact-case matching against
            # its currently-configured mysqli connection.
            identifier: dba.keyValue
            path: tests/Integration/HistoryServiceTest.php
        -
            # comments.validated/user_mail_notification.enabled are real
            # boolean columns on Postgres but MySQL's native tinyint(1) has
            # no true boolean type -- a raw insert()/fetch() array must
            # stay portable across both (PHP bool binds/reads correctly on
            # either platform's driver), but phpstan-dba only ever
            # resolves the schema type for whichever one connection it
            # currently has, flagging the other platform's representation
            # as a type mismatch.
            identifier: dba.keyValue
            path: tests/Integration/CommentServiceTest.php
        -
            # Same cross-driver boolean-vs-tinyint(1) portability
            # requirement as CommentServiceTest.php above, but on the read
            # side: a raw (unmapped) fetch returns a native PHP bool on
            # Postgres, a numeric 1/0 on MySQL (own comment already
            # documents this) -- the (int) cast is required for Postgres
            # portability even though phpstan-dba's currently-configured
            # mysqli connection already reports the column as int, making
            # the cast look redundant from that one connection's view alone.
            identifier: cast.useless
            path: tests/Integration/NotificationByMailSenderTest.php
        -
            # ImageRepository::findIdsGroupedByDuplicateFields() is inferred
            # as returning `array{}` -- but only when called with an inline
            # literal naming Md5sum. Narrowed by experiment: the identical
            # call returns `list<int>` for [File] and for [Width, Height],
            # and also for [Md5sum] the moment the argument is assigned to a
            # variable first. What differs is the one conditional
            # `->where('i.md5sum IS NOT NULL')` that argument switches on, so
            # this is constant-argument folding interacting with a
            # conditionally-built query, not a property of the method body.
            #
            # The body itself analyses correctly: dumpType() reports $groups
            # as array<string, non-empty-list<int>> and the returned $ids as
            # list<int>. Runtime disagrees with the folded result outright --
            # the three findIdsGroupedByDuplicateFields tests pass with 408
            # assertions, and a direct probe confirms array hydration applies
            # the custom Doctrine types (id => ImageId, md5sum => Md5Sum,
            # both Stringable), which is exactly what the method expects.
            #
            # Scoped to this one assertion's file: no code change can satisfy
            # an inference that contradicts the verified runtime value, and
            # weakening the assertion would drop the real coverage.
            identifier: staticMethod.impossibleType
            path: tests/Integration/ImageRepositoryTest.php

        # ------------------------------------------------------------------
        # Generated Latte analysis files (_analysis/phpstan-latte/, written
        # by `bin/piwigo phpstan-latte:compile`). Every identifier below was
        # individually triaged against a full-census real run (6,152
        # findings, zero left unbucketed) -- three dispositions, each entry
        # scoped to the analysis dir only, never repo-wide. reportUnmatched
        # stays on, so an entry whose category empties out fails the run
        # until removed.
        #
        # (1) PERMANENT -- Latte's own codegen calling Latte's own @internal
        # runtime API (HtmlHelpers::escape*, Template::createTemplate,
        # CachingIterator, WhitespaceMinifier, ...). The generated code IS
        # Latte-authored; @internal means "not for user code", and compiled
        # templates are the intended caller. No app change can exist.
        -
            identifier: staticMethod.internalClass
            path: _analysis/phpstan-latte/*
        -
            identifier: method.internal
            path: _analysis/phpstan-latte/*
        -
            identifier: method.internalClass
            path: _analysis/phpstan-latte/*
        -
            identifier: new.internalClass
            path: _analysis/phpstan-latte/*
        -
            identifier: property.internalClass
            path: _analysis/phpstan-latte/*
        -
            # {layout '...'} (P41, docs/PLAN.md)'s own compiled prepare()
            # writes `$this->parentName = '...'` -- Latte's own codegen for
            # its own {extends}/{layout} tag, assigning Latte\Runtime\
            # Template's own @internal $parentName property. Confirmed by
            # reading the generated
            # _analysis/phpstan-latte/themes-default-template-redirect.latte.php
            # directly: the flagged line is `$this->parentName =
            # 'layout.latte';` inside prepare(), never written by hand.
            # Ignore-path matching runs against the real scanned file (this
            # dir), same as every other entry in this block -- the *.latte
            # path PHPStan displays the error under is only a
            # position-remapped label for humans. Every current and future
            # {layout}-using template compiles to the identical pattern.
            identifier: property.internal
            path: _analysis/phpstan-latte/*
        -
            # Latte's compiled {block} methods: its own codegen declares
            # `array $ʟ_args` bare, and dispatch goes through a runtime
            # string table shipmonk's call-graph cannot see.
            identifier: missingType.iterableValue
            path: _analysis/phpstan-latte/*
        -
            identifier: shipmonk.deadMethod
            path: _analysis/phpstan-latte/*
        -
            # Latte's compiled {block}/{include} guard, emitted verbatim as
            # `if (!$this->getReferringTemplate() || $this->getReferenceType()
            # === 'extends')` -- a negation of its own API's own
            # `Latte\Runtime\Template|null` return. Read directly at
            # _analysis/phpstan-latte/themes-admin-default-template-admin.latte.php:362,
            # not inferred. Every {block}-declaring template compiles to it,
            # so this is the same "Latte-authored codegen, no app change can
            # exist" disposition as the entries above.
            #
            # Scoped by message rather than by identifier deliberately: the
            # same identifier also fires on real template source (`{if !$x}`
            # where $x is mixed), which is Campaign A's and must keep
            # reporting. Only this one operand type is codegen, and no
            # template variable is ever typed Latte\Runtime\Template|null.
            # Placed here, ahead of Campaign A's identifier-wide entry: the
            # first matching ignore wins, so this takes the codegen findings
            # and that entry keeps the real ones.
            message: '#^Only booleans are allowed in a negated boolean, Latte\\Runtime\\Template\|null given\.$#'
            path: _analysis/phpstan-latte/*
        -
            # Latte's {foreach} codegen for templates that use $iterator: it
            # emits `foreach ($iterator = $ʟ_it = new Latte\Essential\
            # CachingIterator($rows, $ʟ_it ?? null) as $row)`, chaining each
            # loop to the enclosing one through its own codegen temporary.
            # The `mixed` is that temporary, $ʟ_it, whose own
            # variable.undefined is already permanently ignored by group (3)
            # below. Read directly at _analysis/phpstan-latte/
            # themes-admin-default-template-check_integrity.latte.php.
            # 20 findings across the 13 templates that use $iterator.
            #
            # Message-scoped, like the entry above and for the same reason:
            # argument.type is Campaign A's largest identifier after
            # offsetAccess, so an identifier-wide ignore would bury real
            # work. In particular it must NOT catch the sibling
            # `Parameter #1 $iterator … expects iterable<TKey, TValue>`,
            # which fires where the *collection* is still untyped and is
            # exactly what this campaign exists to fix.
            #
            # The `<mixed, mixed>` is the stub's doing (stubFiles above):
            # before it, the class was non-generic and this message named a
            # bare CachingIterator.
            #
            # Both the expected and the given side are left open: as this
            # campaign typed the collections these loops run over, Latte's
            # own chaining started reporting concrete generics
            # (`CachingIterator<int, list<int>>`) where it used to report
            # `mixed`. Same codegen, better inference. Parameter #2 is the
            # codegen one either way -- it is the `$ʟ_it ?? null` chain --
            # and stays distinct from the Parameter #1 $iterator sibling
            # this must not catch.
            message: '#^Parameter \#2 \$parent of class Latte\\Essential\\CachingIterator constructor expects Latte\\Essential\\CachingIterator<.+>\|null, .+ given\.$#'
            path: _analysis/phpstan-latte/*
        -
            # The matching {foreach} epilogue for the same codegen:
            # `$iterator = $ʟ_it = $ʟ_it->getParent();` unwinds the chain on
            # loop exit. Same disposition, same class-naming guarantee.
            # 2 findings.
            message: '#^Cannot call method getParent\(\) on Latte\\Essential\\CachingIterator<.+>\|null\.$#'
            path: _analysis/phpstan-latte/*
        -
            # Latte's {capture} codegen. `{capture $x}...{/capture}` compiles
            # to an output-buffer round trip whose epilogue is
            # `$ʟ_tmp = ob_get_length() ? new LR\Html(ob_get_clean())
            # : ob_get_clean();` -- so the ternary condition is
            # ob_get_length()'s own int|false, and the Html constructor is
            # handed ob_get_clean()'s own string|false. Neither function
            # appears in any template or app source: read directly at
            # _analysis/phpstan-latte/themes-admin-default-template-rating_user.latte.php:320.
            # One {capture} in the tree, one finding each.
            #
            # P58's plan called for restructuring that {capture} instead,
            # because `ternary.condNotBoolean`'s message was then
            # character-identical to a real finding on
            # mainpage_categories.latte's `$cat['SELECTED'] ? ...`. That
            # collision is gone -- typing the category row removed it -- so
            # the message is now specific to the codegen and this is the
            # same disposition as the entries above rather than a weaker
            # substitute for the rewrite.
            #
            # count-pinned, unlike the entries above: `int|false` is a type
            # a template expression could plausibly have one day (strpos(),
            # say), which the class-naming guarantees elsewhere in this
            # group rule out by construction. A second finding of either
            # shape fails the build instead of being absorbed.
            message: '#^Only booleans are allowed in a ternary operator condition, int\|false given\.$#'
            path: _analysis/phpstan-latte/*
            count: 1
        -
            # The other half of the same {capture} epilogue; see above.
            message: '#^Parameter \#1 \$value of class Latte\\Runtime\\Html constructor expects string\|Stringable\|null, string\|false given\.$#'
            path: _analysis/phpstan-latte/*
            count: 1

        # (2) PERMANENT while the @var injection asserts presence -- the
        # compile step declares every known variable as defined (extract()
        # semantics can't express "maybe absent"), so templates' own
        # defensive isset()/??/empty() checks for genuinely-conditional
        # variables read as dead code. The defensive template code is
        # CORRECT; the assertion is the approximation.
        #
        # `empty.variable` is no longer among them: P58-B2 removed the last
        # empty() from the template tree, so the presence checks that remain
        # are all spelled isset(), which is the honest spelling anyway --
        # empty() answers two questions at once and the campaign's job was
        # to separate them. A new empty() on a conditional variable now
        # fails the build rather than landing here silently.
        -
            identifier: isset.variable
            path: _analysis/phpstan-latte/*
        -
            identifier: nullCoalesce.expr
            path: _analysis/phpstan-latte/*
        -
            identifier: nullCoalesce.variable
            path: _analysis/phpstan-latte/*
        -
            identifier: nullCoalesce.unnecessary
            path: _analysis/phpstan-latte/*
        # month_calendar.latte's `$chronology_calendar->calendarBars ?? []`.
        # Same approximation one level down: the property really is
        # non-nullable, but the VARIABLE holding it is only assigned for a
        # calendar view, and month_calendar.latte also renders for the list
        # view -- so the ?? is suppressing an undefined variable, not a null
        # property. It replaced an empty() doing the same job less legibly
        # (P58-B2).
        -
            identifier: nullCoalesce.property
            path: _analysis/phpstan-latte/*

        # (3) Variables the static model cannot see yet: {include}-passed
        # parameters (cross-file arg flow -- a scoped future extension of
        # the compile step) and Latte codegen temporaries (ʟ_tmp across
        # block-method boundaries). 93 instances at census time, mostly
        # $block/$grp_id/$themes-style include args.
        -
            identifier: variable.undefined
            path: _analysis/phpstan-latte/*

        # ------------------------------------------------------------------
        # P58 -- CLOSED. This is where the CAMPAIGN-PENDING block stood: 26
        # identifier-wide `ignoreErrors` entries over _analysis/phpstan-latte,
        # 20 for Campaign A and 6 for Campaign B, each suppressing a true
        # positive whose real fix was source work. Every one came out as its
        # own count reached zero, and every one was forced out by
        # reportUnmatchedIgnoredErrors rather than noticed.
        #
        # Campaign A (843 findings) typed the producer -> View -> template
        # chain: values arrived as `mixed` because the View property carrying
        # them was `array<string, mixed>`, overwhelmingly a producer calling
        # ->toArray() on an already-typed VO one line before handing it over.
        # Campaign B (376) modernized the template source itself -- loose
        # ==/!=, empty(), always-true/false conditions.
        #
        # Two entries also left the PERMANENT groups above, which is the part
        # worth remembering: `empty.variable` (group 2), because B2 removed
        # the last empty() from the template tree and every presence check
        # left is spelled isset(); and `foreach.valueOverwrite`, which had
        # been filed as Smarty-conversion style and turned out to be two live
        # bugs. Twenty-two live bugs surfaced across the two campaigns, none
        # of them type work -- they were what the blanket ignores were
        # hiding. A blanket identifier ignore assumes every finding under it
        # is the same kind of finding; for several of these it was not.
        #
        # tools/p58/census.php still measures both campaigns (it strips this
        # block -- now empty -- and re-runs PHPStan). It reads
        # Campaign A: 0, Campaign B: 0.

services:
    # A second, plain TableErrorFormatter instance for the override below
    # to delegate to. Explicit name-references where PHPStan's own
    # attribute-registered services are not type-autowirable
    # (simpleRelativePathHelper is #[NonAutowiredService]); the
    # RelativePathHelper and CiDetectedErrorFormatter parameters autowire
    # by type.
    piwigoLatteInnerTableFormatter:
        class: PHPStan\Command\ErrorFormatter\TableErrorFormatter
        arguments:
            simpleRelativePathHelper: @simpleRelativePathHelper
            showTipsOfTheDay: %tipsOfTheDay%
            editorUrl: %editorUrl%
            editorUrlTitle: %editorUrlTitle%
            usedLevel: %usedLevel%
        autowired: no

    # Replaces the default table formatter (the same override hook
    # efabrica/phpstan-latte's own TableErrorFormatter used): errors
    # reported against the generated analysis files under
    # _analysis/phpstan-latte/ (written by `bin/piwigo
    # phpstan-latte:compile`, chained ahead of the analysis in composer's
    # analyse:phpstan script) are remapped to their real .latte
    # file/line before display.
    errorFormatter.table!:
        class: Piwigo\Tools\PhpStan\Latte\TemplateErrorFormatter
        arguments:
            inner: @piwigoLatteInnerTableFormatter
            analysisDir: %currentWorkingDirectory%/_analysis/phpstan-latte

    # Gesso's own OpenApiSpecResolver (vendor, excluded from
    # analyseAndScan above) calls hook methods like openApiSpec() back
    # via $this->, invisible to shipmonk/dead-code-detector -- Gesso
    # isn't in that tool's own supported-library list, so this project
    # supplies the equivalent recognition itself. See the provider's own
    # docblock.
    piwigoGessoHookMethodUsageProvider:
        class: Piwigo\Tools\PhpStan\GessoHookMethodUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider

    # P40's "contract-only" View-adjacent classes (e.g.
    # Menu\Projection\MenubarBlockView) are never Renderer::render()-ed
    # and so never constructed by any in-tree PHP code -- their sole
    # reader is VariableMapBuilder's own ReflectionClass(...)
    # ->getProperties() walk over a runtime class-name string read back
    # from a {templateType} scan, invisible to shipmonk's own built-in
    # ReflectionUsageProvider (which only tracks a statically-known
    # class name reaching ReflectionClass::getProperties()). See the
    # provider's own docblock.
    piwigoTypedViewPropertyUsageProvider:
        class: Piwigo\Tools\PhpStan\TypedViewPropertyUsageProvider
        arguments:
            projectRoot: %currentWorkingDirectory%
        tags:
            - shipmonk.deadCode.memberUsageProvider
