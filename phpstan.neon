parameters:
    level: 10
    paths:
        - src
        - tests
        - tools/phpstan
        - tools/phpstan-latte/src
        - index.php
    excludePaths:
        analyse:
            # Scan-only: cache invalidation tracks edits to the local
            # phpstan-latte package, but its third-party source isn't
            # held to our project's rules.
            - tools/phpstan-latte/src/*
        analyseAndScan:
            - install/db/*.php
            - language/*.php
            - vendor/*
            # Fixture used by tools/plugin-lint.php tests — intentionally
            # written with the legacy globals and functions plugin-lint
            # must reject. PHPStan would flag every line, so exclude.
            - tests/Fixtures/Plugins/DirtyPlugin/*
    bootstrapFiles:
        - tools/phpstan-bootstrap.php
        - tools/phpstan-types.php
    type_perfect:
        narrow_param: true
        narrow_return: true
        no_mixed: true
        null_over_false: true
    latte:
        engineBootstrap: tools/phpstan-latte-engine.php
        errorPatternsToIgnore:
            # phpstan-latte's compiler emits PHPDoc array shapes that
            # mention bare `array` and `iterable` for some Latte 3.x
            # runtime filter signatures (e.g. column, sort). Our strict
            # rules flag those as missing iterable value type — the
            # noise is in Latte runtime signatures, not in user
            # template code.
            - '/PHPDoc tag @var for variable \$__(filters|functions|variables)__ has no value type specified in iterable type/'

            # LatteEngine itself is the dispatcher wrapper around
            # Latte\Engine::renderToString — it forwards a $template
            # parameter, which phpstan-latte's built-in collector flags
            # as unresolvable. Resolution happens on the call sites
            # OUTSIDE LatteEngine (PiwigoLatteEngineResolver picks up
            # `$engine->render('foo.latte')` from controllers); the
            # wrapper-internal forwarding is not a real bug.
            - '/Cannot automatically resolve latte template from expression\./'

            # PiwigoLatteEngineResolver registers .latte paths but
            # doesn't yet extract typed variables from the params
            # array — that lands once typed page-context DTOs flow
            # through controllers. Until then, every `{$varName}` in a
            # converted template appears as undefined / mixed to
            # phpstan-latte. The patterns below are all the noise
            # families that derive from this single root cause; once
            # the resolver extracts types they all lift together.
            - '/Undefined variable: \$/'
            - '/Variable \$\w+ might not be defined/'
            - '/Variable \$\w+ in isset\(\) is never defined/'
            - '/Parameter #\d+ \(mixed\) of echo cannot be converted to string\./'
            - '/Parameter #\d+ \$\w+ of function \w+ expects [^,]+, mixed given/'
            - '/Cannot access offset [^ ]+ on mixed/'
            - '/Argument of an invalid type mixed supplied for foreach/'
            - '/If condition is always (true|false)/'
            - '/Result of (&&|and|or|\|\|) is always (true|false)/'
rules:
    - Piwigo\Tools\PhpStan\ConfigKeyExistsRule
    - Piwigo\Tools\PhpStan\NoDynamicNewRule
    - Piwigo\Tools\PhpStan\NoErrorSuppressionRule
    - Piwigo\Tools\PhpStan\NoGlobalInSrcRule
    - Piwigo\Tools\PhpStan\SerializeAllowedRule
    - Piwigo\Tools\PhpStan\StrictTypesRequiredRule
services:
    - Piwigo\Tools\PhpStan\PiwigoLatteEngineResolver
includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/rector/type-perfect/config/extension.neon
    - vendor/rector/mockstan/config/phpunit-mocks-rules.neon
    - vendor/efabrica/phpstan-latte/rules.neon
