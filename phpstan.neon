includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 10
    bootstrapFiles:
        - tests/phpstan-dba-bootstrap.php
    doctrine:
        objectManagerLoader: tests/phpstan-object-manager.php
    stubFiles:
        - phpstan-stubs/Imagick.stub.php
    paths:
        - .
    excludePaths:
        analyseAndScan:
            - vendor/*
            # JS dependency tree — some npm packages ship stray .php files
            # (e.g. flatted's PHP port) that aren't part of this project.
            - node_modules/*
            # stubFiles content above -- a fake `class Imagick` redeclaration
            # that exists purely to override one bundled-stub method
            # signature, not real application code to lint/scan.
            - phpstan-stubs/*
            # Runtime-compiled Smarty templates + combined JS/CSS cache, not
            # source (verified real: temporarily un-excluding produces
            # 1000+ errors in generated template code).
            - _data/*
            # Standalone maintenance script; its own header comment documents
            # that knplabs/github-api must be `composer require`d manually
            # before running it — it's not one of this project's own deps.
            - tools/github_issues.php
            # Standalone CLI tool (own getopt() interface, CLI-only guard)
            # that curls a real running install and then reads the
            # database.inc.php the install just generated -- that path
            # genuinely doesn't exist at analysis time, and its other
            # findings (loose comparisons) are the same "not part of the
            # analyzed application" story as github_issues.php above.
            - tools/test_piwigo.php
            # Part II (web-root isolation): these are symlinks bridging
            # public/ (the new DocumentRoot) back to already-scanned real
            # directories (themes/, dist/, _data/combined/). PHPStan follows
            # symlinked directories when scanning `.` -- without this, the
            # exact same PHP files get analysed twice under two different
            # path strings -- wasted work today, and would double-report any
            # future error under both paths. (No longer about baseline
            # path-matching -- the PHPStan baseline was retired; verified
            # by temporarily removing this exclusion and re-running: file
            # count rose with the analysis otherwise unchanged.) The former
            # separate public/admin/themes symlink (and its own 8 PHP files)
            # is gone -- include/+admin/ deletion batch relocated
            # admin/themes/ to themes/admin/, so those 8 files are already
            # covered by the public/themes/* exclusion below, nested one
            # level deeper.
            - public/themes/*
            - public/dist/*
            - public/_data/combined/*
            # ECS config: references PhpCsFixer\Fixer\...\*Fixer::class
            # constants that only exist nested inside
            # vendor/symplify/easy-coding-standard/vendor/friendsofphp/
            # php-cs-fixer (bundled, not a direct composer.json dependency —
            # confirmed via `find vendor -iname '*php-cs-fixer*'`, nothing at
            # the top level). ECS's own bootstrap resolves them fine at
            # runtime (this file runs clean on every `composer lint:php`),
            # but our root autoloader can't see them, so PHPStan types every
            # ::class reference here as plain class-string instead of
            # class-string<FixerInterface>. Tooling config, not application
            # code.
            - ecs.php
    ignoreErrors:
        -
            # staabm/phpstan-dba's DoctrineKeyValueStyleRule validates
            # insert()/update()/delete()'s table-name argument only when
            # it's a compile-time string literal, so it can look up real
            # column names/types against the live schema. This codebase
            # never passes a literal table name to those calls -- every
            # real call site goes through Piwigo\Db\Tables::xxx() (39
            # methods, one per table), which builds `$prefix . 'tablename'`
            # at runtime from PIWIGO_DB_PREFIX (see that class's own
            # docblock) precisely so the table prefix stays configurable.
            # That's a deliberate, permanent architectural pattern, not an
            # oversight -- every insert/update/delete call in the whole
            # codebase would trip this rule, so a per-site @phpstan-ignore
            # would just mean the same comment repeated at 60+ call sites
            # with zero added value. The rest of phpstan-dba (real SQL
            # syntax/schema validation via executeQuery/fetchAssociative/
            # etc.) stays fully active; this disables only the one sub-rule
            # whose premise doesn't fit this codebase.
            identifier: dba.keyValue
        -
            # Every query in this file targets an in-memory pdo_sqlite
            # scratch table (t/t2/t3, see the file's own docblock) created
            # fresh inline by each test -- never the live DB
            # tests/phpstan-dba-bootstrap.php connects to, so
            # staabm/phpstan-dba always reports "table does not exist".
            identifier: dba.syntaxError
            path: tests/Unit/Db/BatchWriterTest.php
        -
            # Every query in this file targets self::TABLE
            # ('batchwriter_test_scratch', see the file's own docblock) or
            # a quoted variant of it -- a throwaway table this file's own
            # setUp()/tearDown() drops and recreates around each test, so
            # it never matches the live reflector's persistent schema.
            identifier: dba.syntaxError
            path: tests/Integration/BatchWriterTest.php
        -
            # shipmonk/dead-code-detector has no usage provider for this
            # codebase's own event-dispatch/plugin-hook system
            # (Piwigo\PluginConfig\EventDispatcher) the way it does for
            # Symfony/Laravel/Nette's -- these typed event DTOs are public
            # payload data for a plugin extension-point system (see
            # project memory: all plugins get rewritten against this new
            # typed-event surface), not internal state. Every one of these
            # classes already carries its own docblock, written during the
            # dedicated typed-event conversion, stating plainly whether it
            # has a real handler today -- "never read in-tree" is the
            # correct, documented, intentional state for a
            # notify/filter-style hook with no listener yet, not dead
            # code. Spot-checked several: UserLogin (dispatched nowhere
            # yet), DeleteCategories (dispatched by CategoryService, zero
            # listeners), UploadImageResize (dead-but-harmless legacy
            # registration, already documented) -- all consistent with
            # this being the whole directory's own architecture, not
            # per-class bugs.
            identifier: shipmonk.deadProperty.neverRead
            path: '*/Event/*'
