includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 10
    bootstrapFiles:
        - tests/phpstan-dba-bootstrap.php
    doctrine:
        objectManagerLoader: tests/phpstan-object-manager.php
    stubFiles:
        - phpstan-stubs/Imagick.stub.php
    paths:
        - .
    excludePaths:
        analyseAndScan:
            - vendor/*
            # JS dependency tree — some npm packages ship stray .php files
            # (e.g. flatted's PHP port) that aren't part of this project.
            - node_modules/*
            # stubFiles content above -- a fake `class Imagick` redeclaration
            # that exists purely to override one bundled-stub method
            # signature, not real application code to lint/scan.
            - phpstan-stubs/*
            # Runtime-compiled Smarty templates + combined JS/CSS cache, not
            # source (verified real: temporarily un-excluding produces
            # 1000+ errors in generated template code).
            - _data/*
            # Standalone maintenance script; its own header comment documents
            # that knplabs/github-api must be `composer require`d manually
            # before running it — it's not one of this project's own deps.
            - tools/github_issues.php
            # Standalone CLI tool (own getopt() interface, CLI-only guard)
            # that curls a real running install and then reads the
            # database.inc.php the install just generated -- that path
            # genuinely doesn't exist at analysis time, and its other
            # findings (loose comparisons) are the same "not part of the
            # analyzed application" story as github_issues.php above.
            - tools/test_piwigo.php
            # Part II (web-root isolation): these are symlinks bridging
            # public/ (the new DocumentRoot) back to already-scanned real
            # directories (themes/, dist/, _data/combined/). PHPStan follows
            # symlinked directories when scanning `.` -- without this, the
            # exact same PHP files get analysed twice under two different
            # path strings -- wasted work today, and would double-report any
            # future error under both paths. (No longer about baseline
            # path-matching -- the PHPStan baseline was retired; verified
            # by temporarily removing this exclusion and re-running: file
            # count rose with the analysis otherwise unchanged.) The former
            # separate public/admin/themes symlink (and its own 8 PHP files)
            # is gone -- include/+admin/ deletion batch relocated
            # admin/themes/ to themes/admin/, so those 8 files are already
            # covered by the public/themes/* exclusion below, nested one
            # level deeper.
            - public/themes/*
            - public/dist/*
            - public/_data/combined/*
            # ECS config: references PhpCsFixer\Fixer\...\*Fixer::class
            # constants that only exist nested inside
            # vendor/symplify/easy-coding-standard/vendor/friendsofphp/
            # php-cs-fixer (bundled, not a direct composer.json dependency —
            # confirmed via `find vendor -iname '*php-cs-fixer*'`, nothing at
            # the top level). ECS's own bootstrap resolves them fine at
            # runtime (this file runs clean on every `composer lint:php`),
            # but our root autoloader can't see them, so PHPStan types every
            # ::class reference here as plain class-string instead of
            # class-string<FixerInterface>. Tooling config, not application
            # code.
            - ecs.php
    ignoreErrors:
        -
            # Queries here target an in-memory sqlite scratch table created
            # fresh per test, never the live DB the bootstrap connects to.
            identifier: dba.syntaxError
            path: tests/Unit/Db/BatchWriterTest.php
        -
            # Queries here target a throwaway table this file's own
            # setUp()/tearDown() drops and recreates, never the live
            # reflector's persistent schema.
            identifier: dba.syntaxError
            path: tests/Integration/BatchWriterTest.php
        -
            # No usage provider for this codebase's own event-dispatch/
            # plugin-hook system -- these are public payload DTOs for an
            # extension-point system, correctly unread in-tree when no
            # listener is registered yet.
            identifier: shipmonk.deadProperty.neverRead
            path: '*/Event/*'
        -
            # tearDown()/finally restores a runtime-captured snapshot row via
            # $conn->insert($table, $row), $row built from a prior
            # fetchAssociative() call -- inherently a dynamically-shaped
            # array, not a literal one. dba.keyValue requires a constant
            # array by design; this pattern can't satisfy it by any code
            # change.
            identifier: dba.keyValue
            path: tests/Integration/Admin/UserActivityPageRendererTest.php
        -
            # Same runtime-captured-snapshot-restore shape as
            # UserActivityPageRendererTest.php above.
            identifier: dba.keyValue
            path: tests/Integration/DerivativeSizeRepositoryTest.php
        -
            # Same runtime-captured-snapshot-restore shape as
            # UserActivityPageRendererTest.php above.
            identifier: dba.keyValue
            path: tests/Integration/ImageStdParamsTest.php
        -
            # MySQL's `ON DUPLICATE KEY UPDATE` / Postgres's `ON CONFLICT`
            # inside driver-conditional code (upsertConfig()'s own docblock
            # documents the split) -- phpstan-dba validates the string
            # literal from BOTH branches against whichever one connection
            # it currently has; only the branch matching the configured
            # driver ever actually executes.
            identifier: dba.syntaxError
            path: tests/Contract/ContractTestCase.php
        -
            # Same MySQL-dialect-vs-Postgres-connection limitation as
            # ContractTestCase.php above (seedFlag()'s own comment
            # documents the ON DUPLICATE KEY UPDATE / ON CONFLICT split).
            identifier: dba.syntaxError
            path: tests/Integration/NoPhotoYetRendererTest.php
        -
            # MySQL-only `REPLACE INTO` inside driver-conditional code,
            # validated against whichever one connection phpstan-dba has
            # (own comment documents the ON CONFLICT portable equivalent)
            # -- same shape as ContractTestCase.php above.
            identifier: dba.syntaxError
            path: tests/Integration/SessionRepositoryTest.php
        -
            # Postgres's `::text` cast (needed because the target column is
            # json/jsonb, which rejects a bare LIKE, or to disambiguate a
            # bound parameter's type inside a function call) is misread by
            # phpstan-dba's own placeholder-scanning regex as a bound
            # parameter named "text".
            identifier: dba.syntaxError
            path: tests/Contract/WsCategoriesMutationTest.php
        -
            # Same `::text`-cast-misread-as-placeholder limitation as
            # WsCategoriesMutationTest.php above.
            identifier: dba.syntaxError
            path: tests/Integration/GroupServiceTest.php
        -
            # Same `::text`-cast-misread-as-placeholder limitation as
            # WsCategoriesMutationTest.php above.
            identifier: dba.syntaxError
            path: tests/Integration/PluginLoaderTest.php
        -
            # Same `::text`-cast-misread-as-placeholder limitation as
            # WsCategoriesMutationTest.php above.
            identifier: dba.syntaxError
            path: tests/Integration/RequestBootstrapConnectTest.php
        -
            # pg_advisory_unlock()/pg_try_advisory_lock() are Postgres-only
            # functions, validated against whichever one connection
            # phpstan-dba has -- only the branch matching the configured
            # driver ever actually executes (own docblock documents the
            # MySQL GET_LOCK()/RELEASE_LOCK() split).
            identifier: dba.syntaxError
            path: src/Piwigo/Db/AdvisorySessionLock.php
        -
            # setval()/pg_get_serial_sequence() are Postgres-only, validated
            # against whichever one connection phpstan-dba has -- only the
            # branch matching the configured driver ever actually executes
            # (own comment documents the MySQL AUTO_INCREMENT equivalent).
            identifier: dba.syntaxError
            path: tests/Integration/HistoryServiceTest.php
        -
            # history.ip is genuinely `ip` on Postgres but `IP` on MySQL
            # (a pre-existing cross-platform column-name-case discrepancy
            # baked into the migrations, confirmed live) -- MySQL's own
            # column-name matching is case-insensitive regardless, so the
            # lowercase literal here is correct and works at runtime; only
            # phpstan-dba's schema lookup does exact-case matching against
            # its currently-configured mysqli connection.
            identifier: dba.keyValue
            path: tests/Integration/HistoryServiceTest.php
        -
            # comments.validated/user_mail_notification.enabled are real
            # boolean columns on Postgres but MySQL's native tinyint(1) has
            # no true boolean type -- a raw insert()/fetch() array must
            # stay portable across both (PHP bool binds/reads correctly on
            # either platform's driver), but phpstan-dba only ever
            # resolves the schema type for whichever one connection it
            # currently has, flagging the other platform's representation
            # as a type mismatch.
            identifier: dba.keyValue
            path: tests/Integration/CommentServiceTest.php
        -
            # Same cross-driver boolean-vs-tinyint(1) portability
            # requirement as CommentServiceTest.php above, but on the read
            # side: a raw (unmapped) fetch returns a native PHP bool on
            # Postgres, a numeric 1/0 on MySQL (own comment already
            # documents this) -- the (int) cast is required for Postgres
            # portability even though phpstan-dba's currently-configured
            # mysqli connection already reports the column as int, making
            # the cast look redundant from that one connection's view alone.
            identifier: cast.useless
            path: tests/Integration/NotificationByMailSenderTest.php
        -
            # images.rating_score is declared FLOAT on MySQL (DBAL returns
            # a native float) but numeric(5,4) on Postgres (DBAL returns a
            # string, to preserve exact decimal precision) -- the (float)
            # cast is required for Postgres portability even though
            # phpstan-dba's currently-configured mysqli connection already
            # reports the column as float, making the cast look redundant
            # from that one connection's view alone.
            identifier: cast.useless
            path: tests/Contract/WsHelperTest.php
