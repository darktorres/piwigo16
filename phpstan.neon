parameters:
    level: 9
    paths:
        - include
        - admin
        - src
        - install.php
        - upgrade.php
        - index.php
        - ws.php
        - picture.php
        - identification.php
        - profile.php
        - register.php
        - password.php
        - search.php
        - tags.php
        - comments.php
        - notification.php
        - feed.php
        - i.php
    excludePaths:
        analyseAndScan:
            - install/db/*.php
            - language/*.php
            - vendor/*
    bootstrapFiles:
        - tools/phpstan-bootstrap.php
        - tools/phpstan-types.php
rules:
    - Piwigo\Tools\PhpStan\NoDynamicNewRule
    - Piwigo\Tools\PhpStan\NoGlobalInSrcRule
includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
