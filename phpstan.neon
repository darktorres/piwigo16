parameters:
    level: 10
    paths:
        - src
        - tests
        - tools/phpstan
        - index.php
    excludePaths:
        analyseAndScan:
            - install/db/*.php
            - language/*.php
            - vendor/*
    bootstrapFiles:
        - tools/phpstan-bootstrap.php
        - tools/phpstan-types.php
    type_perfect:
        narrow_param: true
        narrow_return: true
        no_mixed: true
        null_over_false: true
    latte:
        engineBootstrap: tools/phpstan-latte-engine.php
        # phpstan-latte's compiler emits PHPDoc array shapes that mention
        # bare `array` and `iterable` for some Latte 3.x runtime filter
        # signatures (e.g. column, sort). Our strict rules flag those as
        # missing iterable value type — the noise is in Latte runtime
        # signatures, not in user template code, so silence the pattern.
        errorPatternsToIgnore:
            - '/PHPDoc tag @var for variable \$__(filters|functions|variables)__ has no value type specified in iterable type/'
rules:
    - Piwigo\Tools\PhpStan\ConfigKeyExistsRule
    - Piwigo\Tools\PhpStan\NoDynamicNewRule
    - Piwigo\Tools\PhpStan\NoErrorSuppressionRule
    - Piwigo\Tools\PhpStan\NoGlobalInSrcRule
    - Piwigo\Tools\PhpStan\StrictTypesRequiredRule
services:
    -
        class: Piwigo\Tools\PhpStan\TriggerChangeDynamicReturnType
        tags: [phpstan.broker.dynamicStaticMethodReturnTypeExtension]
    -
        class: Piwigo\Tools\PhpStan\PwgGetSessionVarDynamicReturnType
        tags: [phpstan.broker.dynamicFunctionReturnTypeExtension]
    - Piwigo\Tools\PhpStan\PiwigoLatteEngineResolver
includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/rector/type-perfect/config/extension.neon
    - vendor/rector/mockstan/config/phpunit-mocks-rules.neon
    - vendor/efabrica/phpstan-latte/rules.neon
