includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 10
    doctrine:
        objectManagerLoader: tests/phpstan-object-manager.php
    stubFiles:
        - phpstan-stubs/Imagick.stub.php
    paths:
        - .
    excludePaths:
        analyseAndScan:
            - vendor/*
            # JS dependency tree — some npm packages ship stray .php files
            # (e.g. flatted's PHP port) that aren't part of this project.
            - node_modules/*
            # stubFiles content above -- a fake `class Imagick` redeclaration
            # that exists purely to override one bundled-stub method
            # signature, not real application code to lint/scan.
            - phpstan-stubs/*
            # Runtime-compiled Smarty templates + combined JS/CSS cache, not
            # source (verified real: temporarily un-excluding produces
            # 1000+ errors in generated template code).
            - _data/*
            # Standalone maintenance script; its own header comment documents
            # that knplabs/github-api must be `composer require`d manually
            # before running it — it's not one of this project's own deps.
            - tools/github_issues.php
            # Standalone CLI tool (own getopt() interface, CLI-only guard)
            # that curls a real running install and then reads the
            # database.inc.php the install just generated -- that path
            # genuinely doesn't exist at analysis time, and its other
            # findings (loose comparisons) are the same "not part of the
            # analyzed application" story as github_issues.php above.
            - tools/test_piwigo.php
            # Part II (web-root isolation): these are symlinks bridging
            # public/ (the new DocumentRoot) back to already-scanned real
            # directories (themes/, dist/, _data/combined/). PHPStan follows
            # symlinked directories when scanning `.` -- without this, the
            # exact same PHP files get analysed twice under two different
            # path strings -- wasted work today, and would double-report any
            # future error under both paths. (No longer about baseline
            # path-matching -- the PHPStan baseline was retired; verified
            # by temporarily removing this exclusion and re-running: file
            # count rose with the analysis otherwise unchanged.) The former
            # separate public/admin/themes symlink (and its own 8 PHP files)
            # is gone -- include/+admin/ deletion batch relocated
            # admin/themes/ to themes/admin/, so those 8 files are already
            # covered by the public/themes/* exclusion below, nested one
            # level deeper.
            - public/themes/*
            - public/dist/*
            - public/_data/combined/*
            # ECS config: references PhpCsFixer\Fixer\...\*Fixer::class
            # constants that only exist nested inside
            # vendor/symplify/easy-coding-standard/vendor/friendsofphp/
            # php-cs-fixer (bundled, not a direct composer.json dependency —
            # confirmed via `find vendor -iname '*php-cs-fixer*'`, nothing at
            # the top level). ECS's own bootstrap resolves them fine at
            # runtime (this file runs clean on every `composer lint:php`),
            # but our root autoloader can't see them, so PHPStan types every
            # ::class reference here as plain class-string instead of
            # class-string<FixerInterface>. Tooling config, not application
            # code.
            - ecs.php

    ignoreErrors:
        # Pest's expect(...)->toBe()-style fluent assertion chain is
        # intentionally public -- it's the framework's documented, primary
        # way to write every test -- but Pest tags the underlying classes
        # @internal upstream anyway. PHPStan's core "no calling @internal
        # members from outside their root namespace" check has no way to
        # know that; every hit is inside tests/, calling Pest's own API
        # exactly the way Pest tells you to. Not fixable in application
        # code since we don't control Pest's docblocks -- same class of
        # tooling/visibility mismatch as the ecs.php exclusion above.
        -
            identifier: method.internalClass
            path: tests/*
        # Same root cause, one level removed: Pest binds test-local state
        # (e.g. `$this->service = ...` inside beforeEach()) dynamically via
        # closure binding, which PHPStan can't see through, surfacing as
        # property/method access on Pest's internal call-forwarding
        # classes. Scoped to the exact files confirmed to hit this -- not a
        # blanket tests/* -- so it can't swallow unrelated real errors
        # (e.g. tools/i18n/*.php's genuine method.nonObject hits on
        # SplFileInfo iteration). Split one entry per identifier (rather
        # than combining into a single identifiers+paths cross-product)
        # because each identifier only actually occurs in a subset of these
        # files -- a combined entry left reportUnmatchedIgnoredErrors
        # permanently failing on the identifier/path pairs that never
        # co-occur.
        -
            identifier: property.notFound
            paths:
                - tests/Unit/Admin/Maintenance/ServerInfoServiceTest.php
                - tests/Unit/Bootstrap/CliBootstrapTest.php
                - tests/Unit/Core/EnvTest.php
                - tests/Unit/Core/FilesystemHelperTest.php
                - tests/Unit/Core/LangTest.php
                - tests/Unit/Core/LoggerTest.php
                - tests/Unit/Lang/LangServiceTest.php
                - tests/Unit/Lang/TranslatorTest.php
                - tests/Unit/Search/Inflector/Inflector_frTest.php
                - tests/Unit/Session/SessionServiceTest.php
                - tests/Unit/Site/LocalSiteReaderTest.php
        # Same root cause one level further downstream than property.notFound
        # above: once $this->root/$this->langRoot's type is unresolvable
        # (Pest's dynamic closure-bound state), every string concatenation
        # against it also surfaces as a binaryOp.invalid hit. Scoped to
        # just these files, whose only binaryOp.invalid occurrences are
        # this exact pattern (confirmed by reading every hit before adding
        # this entry) -- not a blanket allowance for real string/mixed
        # concatenation bugs elsewhere.
        -
            identifier: binaryOp.invalid
            paths:
                - tests/Unit/Core/EnvTest.php
                - tests/Unit/Core/FilesystemHelperTest.php
                - tests/Unit/Core/LangTest.php
                - tests/Unit/Core/LoggerTest.php
                - tests/Unit/Site/LocalSiteReaderTest.php
        # Same root cause again: $this->root passed straight into
        # LocalSiteReader's constructor / get_elements() -- confirmed this
        # file's only argument.type hits are this exact pattern.
        # tests/Unit/Db/TablePrefixListenerTest.php's own argument.type hit
        # is a different instance of the same Pest-binding root cause:
        # $this->createStub()'s return type is unresolvable for the same
        # reason $this->root is (Pest's PendingCalls\TestCall stand-in), so
        # the resulting mixed can't satisfy EntityManagerInterface either.
        -
            identifier: argument.type
            paths:
                - tests/Unit/Db/TablePrefixListenerTest.php
                - tests/Unit/Site/LocalSiteReaderTest.php
        -
            identifier: method.notFound
            path: tests/Unit/Db/TablePrefixListenerTest.php
        -
            identifier: method.nonObject
            paths:
                - tests/Arch/StructuralTest.php
                - tests/Unit/Admin/Maintenance/ServerInfoServiceTest.php
                - tests/Unit/Bootstrap/CliBootstrapTest.php
                - tests/Unit/Lang/LangServiceTest.php
                - tests/Unit/Search/Inflector/Inflector_frTest.php
                - tests/Unit/Session/SessionServiceTest.php
        -
            identifier: method.notFound
            path: tests/Arch/StructuralTest.php
        -
            identifier: classConstant.internalClass
            path: tests/Unit/SmokeTest.php
        # RawCodeCoverageData is entirely @internal upstream, but its
        # fromXdebugWithoutPathCoverage() static factory is the only way
        # (public or otherwise) to turn a raw pcov/xdebug-format coverage
        # array into what CodeCoverage::append() requires -- it's exactly
        # how the library's own PcovDriver::stop()/XdebugDriver::stop()
        # build one, just called from outside the package because our raw
        # array was captured by a *separate* PHP process (a live web
        # request, via Piwigo\Core\CoverageCollector's own pcov\collect()
        # call) and handed to this merge script as a serialized .raw dump
        # rather than produced by a driver running in-process. Same
        # tooling/visibility mismatch as the Pest entries above -- not
        # fixable in application code since we don't control the
        # library's docblocks.
        -
            identifier: staticMethod.internalClass
            path: tools/coverage-merge.php
