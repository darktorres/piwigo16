includes:
    - phpstan-baseline.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 10
    paths:
        - .
    excludePaths:
        analyseAndScan:
            - vendor/*
            # JS dependency tree — some npm packages ship stray .php files
            # (e.g. flatted's PHP port) that aren't part of this project.
            - node_modules/*
            # Translation data files (arrays of strings), not logic.
            - language/*.php
            # Runtime-compiled Smarty templates + combined JS/CSS cache, not source.
            - _data/*
            # Standalone maintenance script; its own header comment documents
            # that knplabs/github-api must be `composer require`d manually
            # before running it — it's not one of this project's own deps.
            - tools/github_issues.php
            # Part II (web-root isolation): these 4 are symlinks bridging
            # public/ (the new DocumentRoot) back to already-scanned real
            # directories (themes/, admin/themes/, dist/, _data/combined/).
            # PHPStan follows symlinked directories when scanning `.` --
            # without this, the exact same file content gets analysed twice
            # under two different path strings, and any existing baseline
            # entry (keyed to the real path) doesn't match the symlinked
            # duplicate, surfacing as a spurious "new" error.
            - public/themes/*
            - public/admin/themes/*
            - public/dist/*
            - public/_data/combined/*
            # ECS config: references PhpCsFixer\Fixer\...\*Fixer::class
            # constants that only exist nested inside
            # vendor/symplify/easy-coding-standard/vendor/friendsofphp/
            # php-cs-fixer (bundled, not a direct composer.json dependency —
            # confirmed via `find vendor -iname '*php-cs-fixer*'`, nothing at
            # the top level). ECS's own bootstrap resolves them fine at
            # runtime (this file runs clean on every `composer lint:php`),
            # but our root autoloader can't see them, so PHPStan types every
            # ::class reference here as plain class-string instead of
            # class-string<FixerInterface>. Tooling config, not application
            # code.
            - ecs.php

rules:
    - Piwigo\Tools\PhpStan\ConfigKeyExistsRule
