<?xml version="1.0"?>
<psalm
    errorLevel="2"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedCode="false"
    findUnusedVariables="true"
    strictBinaryOperands="true"
    allowPhpStormGenerics="false"
    checkForThrowsDocblock="false"
    phpVersion="8.5"
>
    <stubs>
        <file name="tools/psalm-stubs.phpstub"/>
    </stubs>

    <projectFiles>
        <directory name="src"/>
        <directory name="tests"/>
        <ignoreFiles>
            <directory name="vendor"/>
            <directory name="install/db"/>
            <directory name="language"/>
            <!-- Fixture used by PluginLintTest — intentionally uses
                 the legacy globals and helpers plugin-lint must flag.
                 Psalm has no business analyzing forbidden-pattern bait. -->
            <directory name="tests/fixtures/plugins/dirty_plugin"/>
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <!-- Dynamic include paths (plugin / theme / language file loaders) resolve
             at runtime; Psalm cannot follow them statically. -->
        <MissingFile errorLevel="suppress"/>

        <!-- Reference assignments to nested static-array slots (EventDispatcher
             handler buckets, LoadedPluginRegistry plugin_data) are the registry
             pattern, not a legacy bridge. Psalm cannot model them but they are
             correct. -->
        <UnsupportedPropertyReferenceUsage errorLevel="suppress"/>
    </issueHandlers>
<plugins><pluginClass class="Psalm\PhpUnitPlugin\Plugin"/></plugins></psalm>
