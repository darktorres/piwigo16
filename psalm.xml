<?xml version="1.0"?>
<psalm
    errorLevel="8"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedCode="false"
    findUnusedVariables="true"
    strictBinaryOperands="true"
    allowPhpStormGenerics="false"
    checkForThrowsDocblock="false"
    phpVersion="8.5"
    allConstantsGlobal="true"
    allFunctionsGlobal="true"
>
    <projectFiles>
        <directory name="."/>
        <ignoreFiles>
            <!-- Generated Latte analysis files (_analysis/phpstan-latte/, written by
                 `bin/piwigo phpstan-latte:compile`), analyzed only for PHPStan's own
                 Latte-typing pipeline. phpstan.neon carries ~7500 lines of per-identifier
                 ignores individually triaged for this directory (internal Latte-runtime
                 API calls, compiler-generated methods with no Override attribute, etc.);
                 Psalm has no equivalent triage, so it flags the same expected pattern as
                 noise. Excluded wholesale rather than per-identifier since Psalm doesn't
                 gate this codebase (PHPStan/ECS/deptrac/Pest are the real gates). -->
            <directory name="_analysis"/>
            <!-- Runtime-compiled Latte templates + combined JS/CSS cache, not source. -->
            <directory name="_data"/>
            <directory name="language"/>
            <!-- JS dependency tree — some npm packages ship stray .php files
                 (e.g. flatted's PHP port) that aren't part of this project. -->
            <directory name="node_modules"/>
            <!-- A fake `class Imagick` redeclaration that exists purely to
                 override one bundled-stub method signature for PHPStan's
                 own stubFiles: config, not real application code to
                 lint/scan — mirrors phpstan.neon's own excludePaths entry
                 for this same reason. Scanning it as a normal project file
                 shadowed the full jetbrains/phpstorm-stubs Imagick class
                 loaded via <stubs> above with this file's much smaller
                 one-method version, causing every real Imagick constant
                 usage project-wide to misreport as undefined (confirmed:
                 excluding this directory alone dropped ImageImagick.php's
                 5 UndefinedConstant errors to 0). -->
            <directory name="phpstan-stubs"/>
            <directory name="vendor"/>
            <!-- Standalone maintenance script; its own header comment
                 documents that knplabs/github-api must be `composer
                 require`d manually before running it — mirrors
                 phpstan.neon's own excludePaths entry for this file. -->
            <file name="tools/github_issues.php"/>
        </ignoreFiles>
    </projectFiles>
    <stubs>
        <!-- ext-imagick IS loaded in this dev environment (verified via
             extension_loaded('imagick')/reflection), but imagick isn't in
             Psalm's own curated enableExtensions enum (a fixed internal
             list Psalm reflects extensions from — see php_extensions in
             vendor/vimeo/psalm/src/Psalm/Config.php), so Psalm can't
             auto-reflect it regardless of whether it's actually installed
             on the machine running Psalm (production/CI may not have it
             either). Loading the bundled jetbrains/phpstorm-stubs file
             directly is the supported workaround either way. -->
        <file name="vendor/jetbrains/phpstorm-stubs/imagick/imagick.php"/>
        <!-- Same "not in Psalm's curated extension list" reasoning for
             ext-pcov (CoverageCollector.php's own optional fast path,
             guarded by extension_loaded('pcov')) — also actually loaded
             here, and the same bundled jetbrains/phpstorm-stubs package
             ships a stub for it too. -->
        <file name="vendor/jetbrains/phpstorm-stubs/pcov/pcov.php"/>
        <!-- CacheFactory::buildRedis() forwards RedisAdapter::createConnection()'s
             return value (a union of six optional Redis client libraries)
             straight into `new RedisAdapter(...)` without calling any of its
             own members; only whichever one a real deployment installs
             matters at runtime. Redis/RedisArray/RedisCluster/Relay\Relay
             are covered by the same bundled jetbrains/phpstorm-stubs
             package; the remaining two (Relay\Cluster, Predis\ClientInterface)
             have no bundled stub anywhere, so phpstan-stubs/RedisPeerClients.stub.php
             supplies minimal markers for just those two. -->
        <file name="vendor/jetbrains/phpstorm-stubs/redis/Redis.php"/>
        <file name="vendor/jetbrains/phpstorm-stubs/redis/RedisArray.php"/>
        <file name="vendor/jetbrains/phpstorm-stubs/redis/RedisCluster.php"/>
        <file name="vendor/jetbrains/phpstorm-stubs/relay/Relay.php"/>
        <file name="phpstan-stubs/RedisPeerClients.stub.php"/>
    </stubs>
    <issueHandlers>
        <!-- These 5 issue types are Psalm's "always an error, immune to
             errorLevel" category (see vendor/vimeo/psalm/docs/running_psalm/
             error_levels.md's "Always treated as errors" list) — they
             suggest adding @psalm-pure/@psalm-immutable annotations
             wherever structurally possible, a documentation-completeness
             feature orthogonal to the errorLevel tightening ladder, not a
             correctness check. Blanket-suppressed (~4487 of the ~4724
             errors at a fresh minimal config) so the incremental
             errorLevel-driven fix pass surfaces only real, level-sensitive
             signal; re-enabling this is a separate, deliberate campaign. -->
        <MissingPureAnnotation>
            <errorLevel type="suppress">
                <directory name="."/>
            </errorLevel>
        </MissingPureAnnotation>
        <MissingAbstractPureAnnotation>
            <errorLevel type="suppress">
                <directory name="."/>
            </errorLevel>
        </MissingAbstractPureAnnotation>
        <MissingImmutableAnnotation>
            <errorLevel type="suppress">
                <directory name="."/>
            </errorLevel>
        </MissingImmutableAnnotation>
        <MissingInterfaceImmutableAnnotation>
            <errorLevel type="suppress">
                <directory name="."/>
            </errorLevel>
        </MissingInterfaceImmutableAnnotation>
        <InvalidScope>
            <errorLevel type="suppress">
                <directory name="."/>
            </errorLevel>
        </InvalidScope>
        <!-- The bundled jetbrains/phpstorm-stubs ImagickKernel::fromMatrix()
             declares $origin as a required 2nd param; this environment's
             real ext-imagick reflection (ReflectionMethod::getParameters(),
             verified live) confirms the actual signature is
             `fromMatrix(array $matrix, ?array $origin = null)`, so the call
             below is genuinely safe. phpstan-stubs/Imagick.stub.php already
             carries the corrected signature for PHPStan's own stubFiles:
             (which patches individual members), but Psalm's <stubs> loading
             doesn't merge member-by-member across two files declaring the
             same class — a second declaration is simply ignored, tested
             both load orders — so patching this one method here would
             require fully re-declaring the entire bundled Imagick/
             ImagickKernel API instead of touching just the wrong method. -->
        <TooFewArguments>
            <errorLevel type="suppress">
                <file name="src/Piwigo/Admin/Image/ImageImagick.php"/>
            </errorLevel>
        </TooFewArguments>
        <!-- ECS bundles its own PHP-Scoper-prefixed copy of
             squizlabs/php_codesniffer nested inside its own vendor/ dir;
             CamelCapsMethodNameSniff resolves fine at ECS's own runtime
             (verified: `vendor/bin/ecs check` runs clean with this exact
             config) via ECS's internal class-alias/scoping machinery, but
             the real, unprefixed class only lives under a nested vendor/
             path Psalm's own <ignoreFiles> vendor exclusion can't see
             into, and Composer's autoloader doesn't expose it either
             (confirmed: class_exists() is false even with the project's
             real autoloader loaded) — a Psalm/Composer visibility gap in
             ECS's own boxing, not a broken config reference. -->
        <UndefinedClass>
            <errorLevel type="suppress">
                <file name="ecs.php"/>
            </errorLevel>
        </UndefinedClass>
        <!-- CheckIntegrity::check()'s own dispatchListCheckIntegrity()
             docblock already documents the root cause for PHPStan: a
             registered event handler may call back into this same instance
             and mutate $retrieve_list via addAnomaly(), invisible to static
             analysis through the dispatch() call. PHPStan is satisfied by
             extracting that dispatch into its own method (forcing a
             re-widen on any $this method call); Psalm's flow analysis
             still collapses count($this->retrieve_list) inside the
             `if (count(...) > 0)` body it's already inside to an
             impossible/never type — same root cause, a stricter Psalm
             narrowing quirk PHPStan doesn't share, not dead code (this
             line executes on every real anomaly-detected request). -->
        <NoValue>
            <errorLevel type="suppress">
                <file name="src/Piwigo/Admin/Integrity/CheckIntegrity.php"/>
            </errorLevel>
        </NoValue>
        <!-- $_SESSION superglobal narrowing doesn't account for a called
             method mutating it (same family as this project's own
             documented $_POST/$_SERVER stub-optimism gaps): Psalm keeps
             treating $_SESSION as the literal array{}/array assigned a few
             lines earlier even after an intervening service-method call
             that really does write to the real superglobal at runtime. -->
        <EmptyArrayAccess>
            <errorLevel type="suppress">
                <file name="tests/Unit/Session/SessionServiceTest.php"/>
            </errorLevel>
        </EmptyArrayAccess>
        <!-- Same $_SESSION-narrowing gap as above, but via a by-ref helper
             (upload_service_unset_key()) rather than a direct assignment —
             this file's own header comment on that helper already documents
             the equivalent PHPStan narrowing workaround it exists for. -->
        <NullReference>
            <errorLevel type="suppress">
                <file name="tests/Unit/Admin/Upload/UploadServiceTest.php"/>
            </errorLevel>
        </NullReference>
        <!-- tests/Arch/StructuralTest.php's own
             'findMissingOverrideAttributes() flags a missing #[\Override]'
             test deliberately constructs a fixture method WITHOUT the
             attribute, to assert its own hand-rolled reflection-based
             checker (see that function's own docblock: PHPStan/pest-arch
             had no equivalent when it was written) correctly flags it as a
             violation — adding the attribute there would break the very
             thing the test verifies. An inline `@psalm-suppress
             MissingOverrideAttribute` docblock directly above that one
             method does NOT suppress this specific issue there (verified;
             unclear why — possibly an anonymous-class-scoped Psalm
             limitation), so file-scoped is the only working option. -->
        <MissingOverrideAttribute>
            <errorLevel type="suppress">
                <file name="tests/Arch/StructuralTest.php"/>
            </errorLevel>
        </MissingOverrideAttribute>
    </issueHandlers>
</psalm>
