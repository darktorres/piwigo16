<?xml version="1.0"?>
<psalm
    errorLevel="2"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedCode="false"
    findUnusedVariables="true"
    strictBinaryOperands="true"
    allowPhpStormGenerics="false"
    checkForThrowsDocblock="false"
    phpVersion="8.5"
    allConstantsGlobal="true"
    allFunctionsGlobal="true"
>
    <projectFiles>
        <directory name="."/>
        <ignoreFiles>
            <directory name="vendor"/>
            <!-- JS dependency tree — some npm packages ship stray .php files
                 (e.g. flatted's PHP port) that aren't part of this project. -->
            <directory name="node_modules"/>
            <directory name="language"/>
            <!-- Runtime-compiled Smarty templates + combined JS/CSS cache, not source. -->
            <directory name="_data"/>
        </ignoreFiles>
    </projectFiles>
    <stubs>
        <!-- ext-imagick isn't loaded in this environment, but pwg_image.php
             and MaintenanceActionsPageRenderer.php reference \Imagick;
             load the bundled stub directly since imagick isn't in Psalm's
             curated enableExtensions enum. -->
        <file name="vendor/jetbrains/phpstorm-stubs/imagick/imagick.php"/>
    </stubs>
    <issueHandlers>
        <!-- Pest\Expectation re-exports Pest\Mixins\Expectation via @mixin,
             but the mixin source class is marked @internal wholesale; Psalm
             doesn't reconcile the two, flagging every expect()->toBe() call
             in test files as calling an internal method. No psalm-plugin-pest
             is installed to teach Psalm the @mixin re-export. -->
        <InternalMethod>
            <errorLevel type="suppress">
                <directory name="tests"/>
            </errorLevel>
        </InternalMethod>
        <!-- Same root cause as InternalMethod above, one level over: Pest's
             fluent expect()->toBe()/$page->assertSee() API and its own
             test()/it() closure-rebinding of $this aren't visible to Psalm
             without a psalm-plugin-pest (not installed). Not fixable in
             application code — we don't control Pest's stubs. -->
        <UndefinedMagicMethod>
            <errorLevel type="suppress">
                <directory name="tests"/>
            </errorLevel>
        </UndefinedMagicMethod>
        <InvalidScope>
            <errorLevel type="suppress">
                <directory name="tests"/>
            </errorLevel>
        </InvalidScope>
        <!-- Every hit is `include $expr;`-style code with a dynamically-built
             path (Paths::$root . '...', a scanned plugin/theme file, a
             site-local config.inc.php, ...) that Psalm can't resolve
             statically. This is a deliberate, structural pattern throughout
             the app (bootstrap, extension loading, legacy per-site config
             reads, the i18n tooling's own PO-conversion scripts) — not
             fixable without giving up dynamic paths entirely. -->
        <UnresolvableInclude>
            <errorLevel type="suppress">
                <directory name="public"/>
                <directory name="include"/>
                <directory name="src"/>
                <directory name="tools"/>
            </errorLevel>
        </UnresolvableInclude>
        <!-- Version20260711150857 is a frozen, already-applied DB migration
             (see feedback_no_hand_edit_autogenerated_files precedent) —
             Doctrine\DBAL\Schema\Table::setPrimaryKey() being deprecated in
             the installed DBAL version doesn't change what already ran
             against real installs; hand-editing it after the fact risks
             snapshot/DB drift for no benefit. -->
        <DeprecatedMethod>
            <errorLevel type="suppress">
                <directory name="src/Piwigo/Migrations"/>
            </errorLevel>
        </DeprecatedMethod>
        <!-- StructuralTest.php/ContainerTest.php each declare an anonymous
             class deliberately WITHOUT #[\Override] as a fixture for a test
             that verifies findMissingOverrideAttributes() itself catches
             that exact case — Psalm is correctly flagging the fixture's
             intentional omission, not a real gap. Every other
             MissingOverrideAttribute hit (e.g. MessengerFactory.php,
             tools/phpstan/ConfigKeyExistsRule.php) was fixed for real
             instead of suppressed. -->
        <MissingOverrideAttribute>
            <errorLevel type="suppress">
                <file name="tests/Arch/StructuralTest.php"/>
                <file name="tests/Unit/Core/ContainerTest.php"/>
            </errorLevel>
        </MissingOverrideAttribute>
        <!-- $val is a by-ref foreach variable (`foreach ($range as $i =>
             &$val)`) narrowed to definitely-float by two prior branches
             (floatval() assignment or an empty-string assignment that
             is_numeric() then excludes) — PHPStan's flow analysis confirms
             this (a redundant (float) cast here is flagged cast.useless),
             but Psalm's by-ref narrowing is weaker and still sees a
             possible numeric-string, hence InvalidOperand under
             strictBinaryOperands. This is the project's known "by-ref
             loses narrowing" limitation, not a real type gap.
             Version20260711150900 gets the same treatment as
             DeprecatedMethod above: a frozen, already-applied migration
             (see feedback_no_hand_edit_autogenerated_files precedent) —
             $totalDeleted += $deleted (DBAL Connection::executeStatement()
             returns int|string depending on driver) is real, already-ran
             behavior not hand-edited after the fact for the same
             snapshot/DB-drift reason. -->
        <InvalidOperand>
            <errorLevel type="suppress">
                <file name="src/Piwigo/Search/QNumericRangeScope.php"/>
                <directory name="src/Piwigo/Migrations"/>
            </errorLevel>
        </InvalidOperand>
        <!-- ConfigurationSubController's $_POST-derived array shape gets
             progressively refined by Psalm across the many `?? null`
             guards in this switch's 'main'/'display'/'search' cases (each
             emptyValue($_POST['x'] ?? null) check narrows Psalm's inferred
             $_POST shape further); by the 4 flagged lines, Psalm's
             super-precise array-shape type still marks that specific
             offset optional even though the guard a few lines above it
             already proved otherwise — PHPStan's flow analysis (which
             flags the equivalent `?? null` as redundant at these exact
             sites) confirms this is a Psalm precision gap, not a real
             missing-key bug. SizingParams::$min_size at line 721 is the
             same kind of disagreement: PHPStan proves it non-null inside
             the max_crop>0 branch (the class's own documented invariant),
             Psalm's property-level nullability tracking doesn't follow
             that branch-specific guarantee. -->
        <PossiblyUndefinedArrayOffset>
            <errorLevel type="suppress">
                <!-- Frozen, already-applied DbPatch scripts (same
                     feedback_no_hand_edit_autogenerated_files precedent as
                     src/Piwigo/Migrations/* above) — $dbconf here is a
                     legacy config array the patch already reads
                     defensively (is_scalar()/is_numeric() guards);
                     composer analyse:phpstan is clean on this directory
                     with zero changes, confirming this is Psalm-specific
                     array-shape imprecision, not a real gap. -->
                <directory name="src/Piwigo/Admin/Install/DbPatch"/>
                <file name="src/Piwigo/Controller/Admin/ConfigurationSubController.php"/>
                <!-- Same $_POST-shape-narrowing disagreement as
                     ConfigurationSubController above, same
                     `is_array($_POST['x'] ?? null)` guard-then-bare-access
                     idiom throughout this file's action switch. -->
                <file name="src/Piwigo/Admin/BatchManagerGlobalPageRenderer.php"/>
                <!-- Same guard-then-bare-access disagreement, this time on
                     the $comm in/out parameter (and $_SERVER['REMOTE_ADDR']/
                     ['HTTP_USER_AGENT'], the plan's own explicitly-flagged
                     superglobal-guard bucket) throughout insertComment()'s
                     validation chain: every one of these offsets is read via
                     an `is_string(...['x'] ?? null) ? ...['x'] : default`
                     or `emptyValue(...['x'] ?? null)` guard a few tokens
                     earlier, which PHPStan's flow analysis (confirmed via
                     its own nullCoalesce.offset "always exists" complaint
                     at each of these exact sites) proves makes the bare
                     access safe — Psalm's array-shape narrowing doesn't
                     carry that guarantee through to the bare read. -->
                <file name="src/Piwigo/Comment/CommentService.php"/>
                <!-- Same guard-then-bare-access disagreement on $page
                     (populate()'s local scratch array, built up across many
                     `isset($page['x'])`/`is_string($page['x'] ?? null)`
                     guards) — PHPStan's own nullCoalesce.offset "always
                     exists" complaint at these same 4 sites confirms it. -->
                <file name="src/Piwigo/Section/SectionPopulator.php"/>
                <!-- Same disagreement on $row (a fetchAllAssociative() row),
                     via the same `is_scalar($row['x'] ?? null) ? (string)
                     $row['x'] : ''` idiom used throughout this codebase's
                     DB-row handling. -->
                <file name="src/Piwigo/Admin/BatchManagerUnitPageRenderer.php"/>
                <!-- $listOfDates mixes a cache-read assignment
                     ($cached['list_of_dates'], untyped mixed) with a
                     freshly-built [] branch, then gets deeply nested
                     dynamic-key writes ($listOfDates[$y]['months'][$y.'-'.
                     $m]['count']); Psalm's array-shape tracking can't merge
                     the two branches precisely at that depth even though
                     every read already carries its own `?? 0` fallback
                     (confirmed via composer analyse:phpstan already being
                     clean on this file with zero changes). -->
                <file name="src/Piwigo/Search/SearchFilterRenderer.php"/>
                <!-- Same $_POST-shape-narrowing disagreement as
                     ConfigurationSubController above:
                     `is_numeric($_POST['filter_level'] ?? null)` guards the
                     two bare `$_POST['filter_level']` reads a couple lines
                     below it. -->
                <file name="src/Piwigo/Controller/Admin/BatchManagerSubController.php"/>
                <!-- TagService::createTag() is declared
                     `@return array{info: string, id: int|string}|array{error:
                     string}` — a real disjoint union. After the
                     `isset($creation_output['error'])` early-return, only
                     the `array{info, id}` member remains, which PHPStan's
                     nullCoalesce.offset "always exists" check confirms;
                     Psalm's union narrowing across an isset() guard on a
                     disjoint array-shape union doesn't reach the same
                     conclusion. -->
                <file name="src/Piwigo/Ws/PwgTags.php"/>
                <!-- str2DateTime()'s `count($ymdhms) < 3` early-return
                     guarantees offsets 0-2 exist by the setDate() call;
                     PHPStan's list<T> flow-length tracking proves it
                     (nullCoalesce.offset "always exists"), Psalm's doesn't
                     carry the count() guard into a list-length guarantee. -->
                <file name="src/Piwigo/Core/DateHelper.php"/>
                <!-- Same $_POST/$params-shape-narrowing disagreement as
                     ConfigurationSubController above:
                     `is_numeric($params['max_level'] ?? null)` guards the
                     bare `$params['max_level']` reads a few tokens later. -->
                <file name="src/Piwigo/Ws/PwgUsers.php"/>
                <!-- Same $_POST-shape-narrowing disagreement, this time on
                     username/password/redirect (each guarded by its own
                     `is_string($_POST['x'] ?? null)` a few tokens earlier). -->
                <file name="src/Piwigo/Controller/IdentificationController.php"/>
                <!-- $items[$day] entries are always built with the full
                     derivative/file/dow literal shape (see the loop at
                     ~line 410 above); PHPStan's own nullCoalesce.offset
                     "always exists" complaint confirms it once a `?? 0`
                     fallback is added, same array-shape-merging
                     imprecision as the other suppressions here. -->
                <file name="src/Piwigo/Calendar/CalendarMonthly.php"/>
                <!-- Same disagreement on $_POST['date_creation'] (guarded a
                     few lines above by `in_array($_POST['date_creation'] ??
                     null, ...)`) and $row['id'] (guarded by
                     `is_numeric($row['id'] ?? null)` immediately before). -->
                <file name="src/Piwigo/Admin/PictureModifyPageRenderer.php"/>
                <!-- Same disagreement on min_width/min_height, each guarded
                     by its own `in_array($params['x'] ?? null, [...])` a
                     few lines earlier. -->
                <file name="src/Piwigo/Template/Template.php"/>
                <!-- $image['id'] is proven int by `assert(is_int($image['id']
                     ?? null))` the line before; PHPStan's assert-narrowing
                     carries through to the array-offset read that follows,
                     Psalm's doesn't. -->
                <file name="src/Piwigo/Ws/PwgImages.php"/>
                <!-- Same disagreement on login/mail_address, each guarded
                     by its own `is_string($_POST['x'] ?? null)` a few
                     tokens earlier. -->
                <file name="src/Piwigo/Controller/RegisterController.php"/>
                <!-- Same disagreement on $_SERVER['HTTPS'], guarded by
                     `in_array($_SERVER['HTTPS'] ?? null, [...])` in the
                     same expression. -->
                <file name="src/Piwigo/Admin/Install/InstallWizard.php"/>
                <!-- Same disagreement on $category['id_uppercat'], guarded
                     by `in_array($category['id_uppercat'] ?? null, [...])`
                     in the same expression. -->
                <file name="src/Piwigo/Controller/Admin/SiteUpdateSubController.php"/>
                <!-- Same disagreement on $options['language'], guarded by
                     `in_array($options['language'] ?? null, [...])` in the
                     same expression. -->
                <file name="src/Piwigo/Core/Lang.php"/>
                <!-- Same disagreement on $filter['matches'], guarded by
                     `is_array($filter['matches'] ?? null)` in the same
                     expression. -->
                <file name="src/Piwigo/Filter/FilterService.php"/>
                <!-- Same disagreement on $merged['uppercats'], guarded by
                     `is_string($merged['uppercats'] ?? null)` in the same
                     expression. -->
                <file name="src/Piwigo/Category/CategoryCatsRenderer.php"/>
                <!-- Same disagreement on $_POST['group'], guarded by
                     `in_array($_POST['group'] ?? null, [...])` in the
                     enclosing elseif condition. -->
                <file name="src/Piwigo/Admin/AlbumNotificationPageRenderer.php"/>
                <!-- Same disagreement on $_POST['virtual_name'], guarded by
                     `is_string($_POST['virtual_name'] ?? null)` in the same
                     expression. -->
                <file name="src/Piwigo/Admin/CatListPageRenderer.php"/>
                <!-- Same disagreement on $_POST['image_order_choice'],
                     guarded by `in_array($_POST['image_order_choice'] ??
                     null, [...])` in the same condition. -->
                <file name="src/Piwigo/Admin/ElementSetRanksPageRenderer.php"/>
            </errorLevel>
        </PossiblyUndefinedArrayOffset>
        <PossiblyNullArrayAccess>
            <errorLevel type="suppress">
                <file name="src/Piwigo/Controller/Admin/ConfigurationSubController.php"/>
                <!-- Same SizingParams::$min_size non-null-inside-max_crop>0
                     disagreement as ConfigurationSubController above —
                     confirmed by composer analyse:phpstan already being
                     clean at this exact line with zero changes needed. -->
                <file name="src/Piwigo/Controller/ImageDerivativeController.php"/>
                <!-- Same disagreement, this time in SizingParams::compute()
                     itself — the very method whose max_crop>0 branch
                     establishes the min_size-non-null invariant relied on
                     by the other two suppressed files above. -->
                <file name="src/Piwigo/Image/SizingParams.php"/>
            </errorLevel>
        </PossiblyNullArrayAccess>
        <!-- $row_coi is narrowed via `$row_coi !== '' && $row_coi !== '0'`
             (two literal-string comparisons); Psalm's string-literal
             narrowing collapses the remaining type to the empty string
             `''` (impossible per the guard) instead of "any non-empty,
             non-'0' string", then flags the string-offset reads below as
             indexing into `never`. composer analyse:phpstan is clean here
             with zero changes — a Psalm-only literal-narrowing quirk. -->
        <PossiblyInvalidArrayOffset>
            <errorLevel type="suppress">
                <file name="src/Piwigo/Admin/PictureCoiPageRenderer.php"/>
                <!-- $get_param is a plain `string` method parameter used as
                     an `$_GET[$get_param]` offset; Psalm wants
                     non-empty-string but every real caller passes a
                     literal, non-empty column-name string. composer
                     analyse:phpstan is clean here with zero changes. -->
                <file name="src/Piwigo/Controller/Admin/PermalinksSubController.php"/>
            </errorLevel>
        </PossiblyInvalidArrayOffset>
        <!-- `$last_rank = count($items) - 1` reads as possibly -1 to Psalm,
             but $current_rank (= $rank_of[$image_id]) was already proven to
             exist a few lines above (an isset($rank_of[$image_id]) guard
             upstream falls through to page_not_found() otherwise), which
             guarantees $items is non-empty. composer analyse:phpstan is
             clean here with zero changes. -->
        <InvalidArrayOffset>
            <errorLevel type="suppress">
                <file name="src/Piwigo/Controller/PictureController.php"/>
                <!-- Two independent imprecisions in the same file, both
                     confirmed clean by composer analyse:phpstan: (1)
                     $rating['count'] is set by an earlier `$rating += [...]`
                     merge in a separate loop, which Psalm's array-shape
                     tracking doesn't carry into the model type it infers
                     for the loop variable in this later foreach; (2)
                     $available_order_by[$i] uses a `for ($i = 0; $i <
                     count($available_order_by); ...)` bound, which Psalm
                     doesn't tie back to the literal 5-element array's
                     actual index range. -->
                <file name="src/Piwigo/Admin/RatingUserPageRenderer.php"/>
                <!-- $data_storage[$type]['total']['nb_files'] — Psalm infers
                     $data_storage[$type]['total']'s shape from only the
                     immediately-preceding `['filesize'] = ...` assignment
                     a few lines above, not the stable shape both keys build
                     up to across the two nearly-identical loops in this
                     method; each read already carries its own `?? 0`
                     fallback. composer analyse:phpstan is clean here with
                     zero changes. -->
                <file name="src/Piwigo/Controller/Admin/IntroSubController.php"/>
            </errorLevel>
        </InvalidArrayOffset>
        <!-- $searchFields is `&$mySearch['fields']` — a by-ref alias. The
             project's known "by-ref loses narrowing" limitation (see
             QNumericRangeScope.php's own InvalidOperand suppression above)
             applies here too: `if (! is_array($searchFields['tags'])) {
             $searchFields['tags'] = []; }` should leave Psalm with a union
             of the pre-existing array shape and `[]`, but the by-ref alias
             collapses it to always-`[]`, flagging the subsequent
             ['words'] read as EmptyArrayAccess. composer analyse:phpstan
             is clean here with zero changes. -->
        <EmptyArrayAccess>
            <errorLevel type="suppress">
                <file name="src/Piwigo/Search/SearchFilterRenderer.php"/>
                <file name="src/Piwigo/Admin/Install/DbPatch/LegacyDbLayer.php"/>
                <file name="src/Piwigo/Admin/Install/DbPatch/Patch153.php"/>
                <!-- $associatedTree is a by-ref-mutated tree
                     (`$the_place = &$associatedTree[...]`), same "by-ref
                     loses narrowing" class as SearchFilterRenderer.php
                     above. composer analyse:phpstan is clean here with
                     zero changes. -->
                <file name="src/Piwigo/Admin/AlbumsPageRenderer.php"/>
                <!-- Same dynamic-include $conf pattern as LegacyDbLayer.php/
                     Patch153.php above (already @phpstan-ignore'd inline
                     for the identical reason). -->
                <file name="src/Piwigo/Admin/UserListPageRenderer.php"/>
                <!-- Same dynamic config/feature-flags.php `require`. -->
                <file name="src/Piwigo/Core/FeatureFlag.php"/>
            </errorLevel>
        </EmptyArrayAccess>
    </issueHandlers>
</psalm>
