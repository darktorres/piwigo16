<?xml version="1.0"?>
<psalm
    errorLevel="4"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedCode="false"
    findUnusedVariables="true"
    strictBinaryOperands="true"
    allowPhpStormGenerics="false"
    checkForThrowsDocblock="false"
    phpVersion="8.5"
    allConstantsGlobal="true"
    allFunctionsGlobal="true"
>
    <projectFiles>
        <directory name="."/>
        <ignoreFiles>
            <!-- Generated Latte analysis files (_analysis/phpstan-latte/, written by
                 `bin/piwigo phpstan-latte:compile`), analyzed only for PHPStan's own
                 Latte-typing pipeline. phpstan.neon carries ~7500 lines of per-identifier
                 ignores individually triaged for this directory (internal Latte-runtime
                 API calls, compiler-generated methods with no Override attribute, etc.);
                 Psalm has no equivalent triage, so it flags the same expected pattern as
                 noise. Excluded wholesale rather than per-identifier since Psalm doesn't
                 gate this codebase (PHPStan/ECS/deptrac/Pest are the real gates). -->
            <directory name="_analysis"/>
            <!-- Runtime-compiled Latte templates + combined JS/CSS cache, not source. -->
            <directory name="_data"/>
            <directory name="language"/>
            <!-- JS dependency tree — some npm packages ship stray .php files
                 (e.g. flatted's PHP port) that aren't part of this project. -->
            <directory name="node_modules"/>
            <!-- A fake `class Imagick` redeclaration that exists purely to
                 override one bundled-stub method signature for PHPStan's
                 own stubFiles: config, not real application code to
                 lint/scan — mirrors phpstan.neon's own excludePaths entry
                 for this same reason. Scanning it as a normal project file
                 shadowed the full jetbrains/phpstorm-stubs Imagick class
                 loaded via <stubs> above with this file's much smaller
                 one-method version, causing every real Imagick constant
                 usage project-wide to misreport as undefined (confirmed:
                 excluding this directory alone dropped ImageImagick.php's
                 5 UndefinedConstant errors to 0). -->
            <directory name="phpstan-stubs"/>
            <directory name="vendor"/>
            <!-- Standalone maintenance script; its own header comment
                 documents that knplabs/github-api must be `composer
                 require`d manually before running it — mirrors
                 phpstan.neon's own excludePaths entry for this file. -->
            <file name="tools/github_issues.php"/>
        </ignoreFiles>
    </projectFiles>
    <stubs>
        <!-- ext-imagick IS loaded in this dev environment (verified via
             extension_loaded('imagick')/reflection), but imagick isn't in
             Psalm's own curated enableExtensions enum (a fixed internal
             list Psalm reflects extensions from — see php_extensions in
             vendor/vimeo/psalm/src/Psalm/Config.php), so Psalm can't
             auto-reflect it regardless of whether it's actually installed
             on the machine running Psalm (production/CI may not have it
             either). Loading the bundled jetbrains/phpstorm-stubs file
             directly is the supported workaround either way. -->
        <file name="vendor/jetbrains/phpstorm-stubs/imagick/imagick.php"/>
        <!-- Same "not in Psalm's curated extension list" reasoning for
             ext-pcov (CoverageCollector.php's own optional fast path,
             guarded by extension_loaded('pcov')) — also actually loaded
             here, and the same bundled jetbrains/phpstorm-stubs package
             ships a stub for it too. -->
        <file name="vendor/jetbrains/phpstorm-stubs/pcov/pcov.php"/>
        <!-- CacheFactory::buildRedis() forwards RedisAdapter::createConnection()'s
             return value (a union of six optional Redis client libraries)
             straight into `new RedisAdapter(...)` without calling any of its
             own members; only whichever one a real deployment installs
             matters at runtime. Redis/RedisArray/RedisCluster/Relay\Relay
             are covered by the same bundled jetbrains/phpstorm-stubs
             package; the remaining two (Relay\Cluster, Predis\ClientInterface)
             have no bundled stub anywhere, so phpstan-stubs/RedisPeerClients.stub.php
             supplies minimal markers for just those two. -->
        <file name="vendor/jetbrains/phpstorm-stubs/redis/Redis.php"/>
        <file name="vendor/jetbrains/phpstorm-stubs/redis/RedisArray.php"/>
        <file name="vendor/jetbrains/phpstorm-stubs/redis/RedisCluster.php"/>
        <file name="vendor/jetbrains/phpstorm-stubs/relay/Relay.php"/>
        <file name="phpstan-stubs/RedisPeerClients.stub.php"/>
    </stubs>
    <issueHandlers>
        <!-- These 5 issue types are Psalm's "always an error, immune to
             errorLevel" category (see vendor/vimeo/psalm/docs/running_psalm/
             error_levels.md's "Always treated as errors" list) — they
             suggest adding @psalm-pure/@psalm-immutable annotations
             wherever structurally possible, a documentation-completeness
             feature orthogonal to the errorLevel tightening ladder, not a
             correctness check. Blanket-suppressed (~4487 of the ~4724
             errors at a fresh minimal config) so the incremental
             errorLevel-driven fix pass surfaces only real, level-sensitive
             signal; re-enabling this is a separate, deliberate campaign. -->
        <MissingPureAnnotation>
            <errorLevel type="suppress">
                <directory name="."/>
            </errorLevel>
        </MissingPureAnnotation>
        <MissingAbstractPureAnnotation>
            <errorLevel type="suppress">
                <directory name="."/>
            </errorLevel>
        </MissingAbstractPureAnnotation>
        <MissingImmutableAnnotation>
            <errorLevel type="suppress">
                <directory name="."/>
            </errorLevel>
        </MissingImmutableAnnotation>
        <MissingInterfaceImmutableAnnotation>
            <errorLevel type="suppress">
                <directory name="."/>
            </errorLevel>
        </MissingInterfaceImmutableAnnotation>
        <InvalidScope>
            <errorLevel type="suppress">
                <directory name="."/>
            </errorLevel>
        </InvalidScope>
        <!-- tests/Arch/StructuralTest.php's own
             'findMissingOverrideAttributes() flags a missing #[\Override]'
             test deliberately constructs a fixture method WITHOUT the
             attribute, to assert its own hand-rolled reflection-based
             checker (see that function's own docblock: PHPStan/pest-arch
             had no equivalent when it was written) correctly flags it as a
             violation — adding the attribute there would break the very
             thing the test verifies. An inline `@psalm-suppress
             MissingOverrideAttribute` docblock directly above that one
             method does NOT suppress this specific issue there (verified;
             unclear why — possibly an anonymous-class-scoped Psalm
             limitation), so file-scoped is the only working option. -->
        <MissingOverrideAttribute>
            <errorLevel type="suppress">
                <file name="tests/Arch/StructuralTest.php"/>
            </errorLevel>
        </MissingOverrideAttribute>
        <!-- Pest\Expectation's fluent ->not property (returns a negated
             Expectation for chains like ->not->toContain(...)) isn't
             recognized by Psalm — no psalm-plugin-pest is installed to
             teach Psalm Pest's own magic/mixin property declarations. Not
             specific to any one test's own logic (13 call sites across 8
             unrelated files, all the identical library-integration gap),
             so scoped to the whole tests/ directory rather than repeating
             the same explanation at each site individually. -->
        <UndefinedPropertyFetch>
            <errorLevel type="suppress">
                <directory name="tests"/>
            </errorLevel>
        </UndefinedPropertyFetch>
        <!-- Pest\Expectation re-exports Pest\Mixins\Expectation via
             @mixin, but the mixin source class is marked @internal
             wholesale; Psalm doesn't reconcile the two, flagging every
             expect()->toBe()-style call in the entire test suite as
             calling an internal method (verified: 10,764 instances across
             787 test files, all the identical library-integration gap —
             no psalm-plugin-pest exists on Packagist to teach Psalm the
             @mixin re-export). Same root cause and same "not specific to
             any one test's own logic" reasoning as the ->not suppression
             above, just a much larger surface (essentially every
             expect()->method() call in the suite, not just ->not
             chains). -->
        <InternalMethod>
            <errorLevel type="suppress">
                <directory name="tests"/>
                <!-- tools/coverage-merge.php: deliberately reaches into
                     phpunit/php-code-coverage's @internal
                     RawCodeCoverageData/ProcessedCodeCoverageData/
                     CodeCoverage/Report classes to merge parallel test
                     runners' raw coverage data and render the combined
                     report — there's no public API for this; the tool's
                     own header comment documents the same tradeoff PHPUnit
                     itself makes internally. -->
                <file name="tools/coverage-merge.php"/>
            </errorLevel>
        </InternalMethod>
        <!-- $this->entityManager->getRepository(XEntity::class)->someCustomMethod()
             calls a real method the entity's own custom repositoryClass
             declares (verified per-entity/repository pair repeatedly
             throughout this project: each custom repository extends
             EntityRepository and adds its own finder/counter methods), but
             Psalm's Doctrine plugin only knows the generic
             EntityRepository<T> shape, not the narrower repositoryClass
             binding — the exact same root cause as the earlier
             InvalidArgument suppressions scattered across this codebase's
             call sites, just surfacing as "magic method doesn't exist"
             here instead of "wrong argument type" (verified: 1,288
             instances across 231 files, spanning both src/ and tests/, all
             the identical gap). PHPStan's own Doctrine extension resolves
             this correctly and remains the real gate for genuine
             method-existence typos. -->
        <UndefinedMagicMethod>
            <errorLevel type="suppress">
                <directory name="."/>
            </errorLevel>
        </UndefinedMagicMethod>
        <!-- These 15 files each have a `list<T>` return type built from
             array_map() over a Doctrine QueryBuilder/Query::getResult()
             (or, for HtmlRenderingListener, a class-string-keyed map built
             via conditional array-literal additions). PHPStan proves
             every one of these genuinely list-shaped (or genuinely
             shaped per the interface's own map contract) via its
             Doctrine-aware/DQL-aware typing — confirmed by trying the
             obvious code-level fix (wrapping the return in
             array_values(), or widening HtmlRenderingListener's local
             $events via an explicit @var) and having PHPStan itself
             reject the result: `arrayValues.list` ("already a list, call
             has no effect") for the array_values() sites, and
             `varTag.unresolvableType` for HtmlRenderingListener (its
             `impure-Closure` union is Psalm-only 7.x-dev syntax with no
             PHPStan equivalent). Psalm has no equivalent to
             phpstan-doctrine's DQL/hydration-mode-aware return-type
             resolution, so it can't see what PHPStan already proves.
             Adding a runtime no-op call (or a type override PHPStan
             can't parse) purely to satisfy Psalm — a non-blocking
             secondary tool — would make the real gate (PHPStan) itself
             worse. File-scoped rather than directory-wide: any NEW file
             hitting this exact gap needs to be added here explicitly, so
             the check stays live everywhere else. -->
        <MoreSpecificReturnType>
            <errorLevel type="suppress">
                <file name="src/Piwigo/Activity/ActivityRepository.php"/>
                <file name="src/Piwigo/Admin/Extensions/ExtensionLifecycle.php"/>
                <file name="src/Piwigo/Admin/Extensions/ExtensionRepository.php"/>
                <file name="src/Piwigo/Audit/AuditRepository.php"/>
                <file name="src/Piwigo/Auth/ApiKeyRepository.php"/>
                <file name="src/Piwigo/Category/CategoryRepository.php"/>
                <file name="src/Piwigo/Group/GroupRepository.php"/>
                <file name="src/Piwigo/Image/ImageRepository.php"/>
                <file name="src/Piwigo/Listener/HtmlRenderingListener.php"/>
                <file name="src/Piwigo/Metadata/MetadataRepository.php"/>
                <file name="src/Piwigo/Permalink/PermalinkRepository.php"/>
                <file name="src/Piwigo/PluginConfig/PluginRepository.php"/>
                <file name="src/Piwigo/Rate/RateRepository.php"/>
                <file name="src/Piwigo/Tag/TagRepository.php"/>
                <file name="src/Piwigo/Users/UserRepository.php"/>
            </errorLevel>
        </MoreSpecificReturnType>
        <LessSpecificReturnStatement>
            <errorLevel type="suppress">
                <file name="src/Piwigo/Activity/ActivityRepository.php"/>
                <file name="src/Piwigo/Admin/Extensions/ExtensionLifecycle.php"/>
                <file name="src/Piwigo/Admin/Extensions/ExtensionRepository.php"/>
                <file name="src/Piwigo/Audit/AuditRepository.php"/>
                <file name="src/Piwigo/Auth/ApiKeyRepository.php"/>
                <file name="src/Piwigo/Category/CategoryRepository.php"/>
                <file name="src/Piwigo/Group/GroupRepository.php"/>
                <file name="src/Piwigo/Image/ImageRepository.php"/>
                <file name="src/Piwigo/Listener/HtmlRenderingListener.php"/>
                <file name="src/Piwigo/Metadata/MetadataRepository.php"/>
                <file name="src/Piwigo/Permalink/PermalinkRepository.php"/>
                <file name="src/Piwigo/PluginConfig/PluginRepository.php"/>
                <file name="src/Piwigo/Rate/RateRepository.php"/>
                <file name="src/Piwigo/Tag/TagRepository.php"/>
                <file name="src/Piwigo/Users/UserRepository.php"/>
            </errorLevel>
        </LessSpecificReturnStatement>
        <!-- SectionPopulator.php's $page local starts as `array<string, mixed>`
             and is repeatedly array_merge()'d with several call sites'
             return values, including UrlService::parseWellKnownParamsUrl()'s
             own precisely-typed `array{..., chronology_style?: string,
             chronology_view?: string, chronology_date?: list<string>, ...}`.
             PHPStan tracks that merge with full confidence: it knows these
             3 keys are always string/list<string> whenever present, so any
             is_string()/is_array()/array_key_exists() guard added to satisfy
             Psalm here is flagged by PHPStan itself as dead code
             (`function.alreadyNarrowedType`/`function.impossibleType`, since
             treatPhpDocTypesAsCertain trusts the return docblock). Psalm's
             own array_merge shape-inference is looser and still shows these
             keys unioned with `mixed`, so it can't see what PHPStan already
             proves. Confirmed by trying the guard and having PHPStan reject
             it; reverted rather than adding checks the real gate calls dead. -->
        <PossiblyUndefinedArrayOffset>
            <errorLevel type="suppress">
                <file name="src/Piwigo/Section/SectionPopulator.php"/>
                <!-- DateHelper::asDateTime()'s $ymdhms is built by an
                     strtok() loop, then guarded by `count($ymdhms) < 3`
                     before indices 0-2 are read. PHPStan's flow analysis
                     narrows the array to `non-empty-list<...>` off that
                     count() check and proves offsets 0-2 always exist
                     (`nullCoalesce.offset` when a `?? 0` fallback is added:
                     "always exists ... on left side of ??"); Psalm has
                     no equivalent count()-length narrowing for a
                     dynamically-built list, so it still sees them as
                     possibly-undefined. Confirmed by trying the `?? 0`
                     guard and having PHPStan reject it as dead code. -->
                <file name="src/Piwigo/Core/DateHelper.php"/>
                <!-- DbConnection::params()'s own return type is a 3-way
                     union discriminated by the 'driver' key (mysqli/pgsql/
                     sqlite3), only the mysqli arm carrying user/password/
                     dbname/driverOptions unconditionally. Both affected
                     tests narrow with `assert($params['driver'] ===
                     'mysqli')` right after asserting the same via Pest's
                     `expect()`: confirmed PHPStan (which does support
                     assert()-based discriminated-union-by-literal-key
                     narrowing on array shapes) is already 100% clean on
                     this file with no guards added. Psalm doesn't narrow
                     the array shape off that assert(), so it still sees
                     these keys as possibly-undefined/possibly-null. -->
                <file name="tests/Unit/Db/DbConnectionTest.php"/>
                <!-- debug_backtrace()/Exception::getTrace() frame shape:
                     PHPStan's own stub declares 'function' as always-present
                     (`array{function: string, line?: int, ...}`); Psalm's
                     stub treats it as optional. Confirmed by adding a `??
                     null` guard and having PHPStan reject it
                     (`nullCoalesce.offset`, "always exists ... on left side
                     of ??"). -->
                <file name="tests/Unit/Auth/SensitiveParameterTest.php"/>
                <!-- CalendarMonthly::buildMonthCalendar()'s $items array is
                     built by one foreach loop (setting 'nb_images' for
                     every key, then 'derivative'/'file'/'dow' for that same
                     key later in the same iteration) and read back by a
                     completely separate later loop. PHPStan's flow analysis
                     proves 'derivative'/'file' always exist on every entry
                     by that second loop (confirmed: adding a `?? null`
                     guard there gets `nullCoalesce.offset`, "always exists
                     ... on left side of ??"); Psalm can't do this
                     across-loop, self-mutating-array narrowing. -->
                <file name="src/Piwigo/Calendar/CalendarMonthly.php"/>
                <!-- ImageUpdateController::patch()'s $currentValues is a
                     literal array{name, author, comment, level,
                     dateCreation} keyed by the exact same 5 strings as
                     self::INFO_COLUMNS, the const array the enclosing
                     foreach() iterates over as $key. PHPStan correlates the
                     const string-list with the literal shape's keys and
                     proves $currentValues[$key] always exists; Psalm
                     doesn't do this const-array-to-shape-key correlation.
                     Confirmed: adding a `?? null` guard gets
                     `nullCoalesce.unnecessary` from PHPStan. -->
                <file name="src/Piwigo/Controller/Api/Images/ImageUpdateController.php"/>
                <!-- PictureController::pictureAction()'s $format loop: the
                     `! isset($format['download_url'])` branch is only
                     reached for the Projection\ImageFormat::toArray() rows
                     (format_id/image_id/ext/filesize), never the
                     differently-shaped array_unshift()'d literal
                     (download_url/ext/filesize): see this exact branch's
                     own comment. PHPStan proves 'format_id' always exists
                     inside that branch; Psalm can't correlate "which of the
                     2 literal shapes this iteration's $format came from"
                     with the isset() check on a different key. Confirmed:
                     adding a `?? ''` guard gets `nullCoalesce.offset` from
                     PHPStan. -->
                <file name="src/Piwigo/Controller/PictureController.php"/>
                <!-- AdvisorySessionLock::sqliteLockFilePath(): same
                     DbConnection::params() 3-way-union-by-'driver'-key gap
                     as this file's own DbConnectionTest.php entry above,
                     just narrowed via an inline ternary condition instead
                     of assert(). PHPStan proves $params['path'] always
                     exists once `$params['driver'] === 'sqlite3'` is true;
                     Psalm doesn't narrow the array shape off that ternary
                     condition either. Confirmed: adding a `?? ''` guard
                     gets `nullCoalesce.offset` from PHPStan. -->
                <file name="src/Piwigo/Db/AdvisorySessionLock.php"/>
                <!-- actionCurlGet()'s header-parsing loop: `explode(':',
                     $line, 2)` is only reached inside `if
                     (str_contains($line, ':'))`, so it always yields
                     exactly 2 parts. PHPStan's flow analysis proves this
                     (confirmed: adding an `assert(count(...) === 2)` guard
                     gets `function.alreadyNarrowedType`/
                     `identical.alwaysTrue`, dead code); Psalm can't
                     correlate str_contains()'s boolean result with
                     explode()'s own part count. -->
                <file name="tests/Browser/ActionControllerTest.php"/>
                <!-- Same str_contains()-then-explode() gap as
                     ActionControllerTest.php above, in idcGet()'s own
                     identical header-parsing loop. -->
                <file name="tests/Browser/ImageDerivativeControllerTest.php"/>
                <!-- self::assertArrayHasKey('URL_NEXT', $navbar) right
                     before the flagged read: PHPStan's PHPUnit extension
                     narrows the array shape off assertArrayHasKey() (proves
                     'URL_NEXT' always exists afterwards); Psalm doesn't.
                     Confirmed: adding a `?? null` guard + assertIsString()
                     gets `nullCoalesce.offset`/`staticMethod.alreadyNarrowedType`
                     from PHPStan. -->
                <file name="tests/Integration/PictureCommentRendererTest.php"/>
                <!-- RecentIconResolver::getIcon()'s own return type is
                     `false|array{}|array{TITLE: string, IS_CHILD_DATE:
                     bool}`: TITLE and IS_CHILD_DATE always co-occur.
                     PHPStan narrows the whole union off the
                     array_key_exists('TITLE', ...) + fail() guard already
                     present, proving IS_CHILD_DATE also always exists once
                     TITLE is confirmed. Confirmed: adding the equivalent
                     array_key_exists('IS_CHILD_DATE', ...) guard gets
                     `function.alreadyNarrowedType` from PHPStan. -->
                <file name="tests/Integration/RecentIconResolverTest.php"/>
                <!-- triggers_list.php's `@$trigger['infos']`: the `@`
                     error-suppression operator is a deliberate existing
                     idiom here, not an oversight: confirmed replacing it
                     with a `?? ''` guard actively BREAKS PHPStan
                     (`binaryOp.invalid`, a huge pre-existing literal-string
                     union for $trigger['infos']'s value type becomes
                     concatenation-incompatible once the `@` no longer
                     masks it from PHPStan's own binary-op check). Reverted
                     rather than trading a Psalm pass for a PHPStan
                     failure. -->
                <file name="tools/triggers_list.php"/>
            </errorLevel>
        </PossiblyUndefinedArrayOffset>
        <PossiblyFalseArgument>
            <errorLevel type="suppress">
                <!-- ImageDerivativeController::handle()'s $derivative_mtime
                     (@filemtime(), int|false) sets $need_generate=true
                     whenever it's false; the later `if (! $need_generate)`
                     branch uses $derivative_mtime as an int. PHPStan's flow
                     analysis correlates the boolean flag with the other
                     variable's type and proves $derivative_mtime is never
                     false inside that branch (confirmed: adding an
                     `assert($derivative_mtime !== false)` guard there gets
                     `notIdentical.alwaysTrue`); Psalm can't do this
                     cross-variable correlation. -->
                <file name="src/Piwigo/Controller/ImageDerivativeController.php"/>
                <!-- strtotime() with a literal, always-parseable relative
                     date string ('-1 hour'): PHPStan's own strtotime()
                     stub special-cases literal-string arguments and proves
                     the result is never false (confirmed: adding an
                     `assert($x !== false)` guard gets
                     `notIdentical.alwaysTrue`); Psalm's stub doesn't do
                     this literal-string narrowing. -->
                <file name="tests/Browser/AdminShellTest.php"/>
                <!-- Same literal-relative-date strtotime() gap as
                     AdminShellTest.php above ('-30 days'/'-90 days'). -->
                <file name="tests/Browser/PictureControllerTest.php"/>
            </errorLevel>
        </PossiblyFalseArgument>
        <PossiblyNullOperand>
            <errorLevel type="suppress">
                <!-- MailService::mail()'s $errorMessage: starts null, only
                     ever set alongside $ret=false in the same catch block.
                     The trigger_error() call is itself gated behind `!
                     $ret`, so $errorMessage is never null there. PHPStan's
                     flow analysis proves this correlation (confirmed:
                     adding a `?? ''` guard gets `nullCoalesce.variable`,
                     "always exists and is not nullable"); Psalm can't do
                     this cross-variable correlation. -->
                <file name="src/Piwigo/Mail/MailService.php"/>
            </errorLevel>
        </PossiblyNullOperand>
    </issueHandlers>
</psalm>
