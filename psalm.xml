<?xml version="1.0"?>
<psalm
    errorLevel="2"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedCode="false"
    findUnusedVariables="true"
    strictBinaryOperands="true"
    allowPhpStormGenerics="false"
    checkForThrowsDocblock="false"
    phpVersion="8.5"
    allConstantsGlobal="true"
    allFunctionsGlobal="true"
>
    <projectFiles>
        <directory name="."/>
        <ignoreFiles>
            <directory name="vendor"/>
            <!-- JS dependency tree — some npm packages ship stray .php files
                 (e.g. flatted's PHP port) that aren't part of this project. -->
            <directory name="node_modules"/>
            <directory name="language"/>
            <!-- Runtime-compiled Smarty templates + combined JS/CSS cache, not source. -->
            <directory name="_data"/>
        </ignoreFiles>
    </projectFiles>
    <stubs>
        <!-- ext-imagick isn't loaded in this environment, but pwg_image.php
             and MaintenanceActionsPageRenderer.php reference \Imagick;
             load the bundled stub directly since imagick isn't in Psalm's
             curated enableExtensions enum. -->
        <file name="vendor/jetbrains/phpstorm-stubs/imagick/imagick.php"/>
    </stubs>
    <issueHandlers>
        <!-- Pest\Expectation re-exports Pest\Mixins\Expectation via @mixin,
             but the mixin source class is marked @internal wholesale; Psalm
             doesn't reconcile the two, flagging every expect()->toBe() call
             in test files as calling an internal method. No psalm-plugin-pest
             is installed to teach Psalm the @mixin re-export. -->
        <InternalMethod>
            <errorLevel type="suppress">
                <directory name="tests"/>
            </errorLevel>
        </InternalMethod>
        <!-- Same root cause as InternalMethod above, one level over: Pest's
             fluent expect()->toBe()/$page->assertSee() API and its own
             test()/it() closure-rebinding of $this aren't visible to Psalm
             without a psalm-plugin-pest (not installed). Not fixable in
             application code — we don't control Pest's stubs. -->
        <UndefinedMagicMethod>
            <errorLevel type="suppress">
                <directory name="tests"/>
            </errorLevel>
        </UndefinedMagicMethod>
        <InvalidScope>
            <errorLevel type="suppress">
                <directory name="tests"/>
            </errorLevel>
        </InvalidScope>
        <!-- Every hit is `include $expr;`-style code with a dynamically-built
             path (Paths::$root . '...', a scanned plugin/theme file, a
             site-local config.inc.php, ...) that Psalm can't resolve
             statically. This is a deliberate, structural pattern throughout
             the app (bootstrap, extension loading, legacy per-site config
             reads, the i18n tooling's own PO-conversion scripts) — not
             fixable without giving up dynamic paths entirely. -->
        <UnresolvableInclude>
            <errorLevel type="suppress">
                <directory name="public"/>
                <directory name="include"/>
                <directory name="src"/>
                <directory name="tools"/>
            </errorLevel>
        </UnresolvableInclude>
        <!-- Version20260711150857 is a frozen, already-applied DB migration
             (see feedback_no_hand_edit_autogenerated_files precedent) —
             Doctrine\DBAL\Schema\Table::setPrimaryKey() being deprecated in
             the installed DBAL version doesn't change what already ran
             against real installs; hand-editing it after the fact risks
             snapshot/DB drift for no benefit. -->
        <DeprecatedMethod>
            <errorLevel type="suppress">
                <directory name="src/Piwigo/Migrations"/>
            </errorLevel>
        </DeprecatedMethod>
        <!-- StructuralTest.php/ContainerTest.php each declare an anonymous
             class deliberately WITHOUT #[\Override] as a fixture for a test
             that verifies findMissingOverrideAttributes() itself catches
             that exact case — Psalm is correctly flagging the fixture's
             intentional omission, not a real gap. Every other
             MissingOverrideAttribute hit (e.g. MessengerFactory.php,
             tools/phpstan/ConfigKeyExistsRule.php) was fixed for real
             instead of suppressed. -->
        <MissingOverrideAttribute>
            <errorLevel type="suppress">
                <file name="tests/Arch/StructuralTest.php"/>
                <file name="tests/Unit/Core/ContainerTest.php"/>
            </errorLevel>
        </MissingOverrideAttribute>
        <!-- $val is a by-ref foreach variable (`foreach ($range as $i =>
             &$val)`) narrowed to definitely-float by two prior branches
             (floatval() assignment or an empty-string assignment that
             is_numeric() then excludes) — PHPStan's flow analysis confirms
             this (a redundant (float) cast here is flagged cast.useless),
             but Psalm's by-ref narrowing is weaker and still sees a
             possible numeric-string, hence InvalidOperand under
             strictBinaryOperands. This is the project's known "by-ref
             loses narrowing" limitation, not a real type gap.
             Version20260711150900 gets the same treatment as
             DeprecatedMethod above: a frozen, already-applied migration
             (see feedback_no_hand_edit_autogenerated_files precedent) —
             $totalDeleted += $deleted (DBAL Connection::executeStatement()
             returns int|string depending on driver) is real, already-ran
             behavior not hand-edited after the fact for the same
             snapshot/DB-drift reason. -->
        <InvalidOperand>
            <errorLevel type="suppress">
                <file name="src/Piwigo/Search/QNumericRangeScope.php"/>
                <directory name="src/Piwigo/Migrations"/>
            </errorLevel>
        </InvalidOperand>
    </issueHandlers>
</psalm>
