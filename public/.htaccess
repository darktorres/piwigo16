# See docs/PLAN.md P4 (SEC-01, SEC-04, SEC-05, SEC-06). Mirrors
# docker/Caddyfile (FrankenPHP) — see docs/REFERENCE.md for the nginx
# equivalent. Not anchored to the root: REQUEST_URI includes any subdirectory
# the app is mounted under (e.g. /piwigo17/...), so these match anywhere.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # SEC-01: deny directories that must never be served directly.
    # install.php itself (the routed install entry point) stays reachable;
    # only the install/ directory (SQL dumps, upgrade scripts) is denied.
    # vendor/node_modules/docs/deploy/.git were found still 200-ing during
    # the P4 audit (composer/npm dependency trees, the master plan doc with
    # its own threat model, and Helm manifests all being fully readable) —
    # none of the original 6 named dirs happened to cover them. vendor is
    # handled by its own rule below, not this one.
    RewriteCond %{REQUEST_URI} /(config|tools|dev|src|tests|install|node_modules|docs|deploy|\.git)/ [NC]
    RewriteRule ^ - [F,L]

    # SEC-01 gap-closure, docs/PLAN.md: the Composer vendor/
    # dir needs its own rule, same unanchored reasoning as above (REQUEST_URI
    # includes any mount-point subdirectory) -- but excluding vendor/ nested
    # under themes/*/ or plugins/*/, which are real, publicly-servable
    # bundled theme/plugin assets (e.g. themes/default/vendor/fontello/'s
    # icon font), unrelated to PHP dependency source. Found live: the
    # combined rule above used to match ANY `/vendor/` occurrence anywhere
    # in the path, 403ing every gallery-icon glyph sitewide the moment
    # .htaccess enforcement was active (AllowOverride All) -- confirmed via
    # a real curl 403 + Apache access log entry, root-caused before
    # assuming a browser-timing flake. docker/Caddyfile's own `/vendor/*`
    # path matcher is anchored to the start of the URI and doesn't share
    # this bug -- checked, no change needed there.
    RewriteCond %{REQUEST_URI} /vendor/ [NC]
    RewriteCond %{REQUEST_URI} !/(themes|plugins)/[^/]+/vendor/ [NC]
    RewriteRule ^ - [F,L]

    # SEC-01: deny direct access to sensitive root-level tooling configs and
    # dependency manifests too — not just the directories above. These have
    # no reason to ever be fetched by a browser and would help fingerprint
    # the stack. Matched by basename (not anchored to root), so this also
    # covers a nested vendored copy, not just the repo root.
    RewriteCond %{REQUEST_URI} /(composer\.(json|lock)|package\.json|bun\.lock|phpstan\.neon|psalm\.xml|rector\.php|ecs\.php|knip\.json|lefthook\.yml|tsconfig\.json|\.stylelintrc\.json|\.prettierrc\.json|\.markdownlint-cli2\.jsonc|lighthouserc\.json|\.size-limit\.json|renovate\.json|release-please-config\.json|\.release-please-manifest\.json|eslint-suppressions\.json|\.editorconfig|\.gitignore|\.dockerignore|Dockerfile|docker-compose\.ya?ml|justfile|\.env[^/]*|[^/]+\.ts)$ [NC]
    RewriteRule ^ - [F,L]

    # Stable external contract for health/ready probes (Dockerfile
    # HEALTHCHECK, compose, Helm) even though there's no real router yet —
    # these currently resolve to the plain health.php/ready.php scripts.
    RewriteRule ^health$ health.php [L]
    RewriteRule ^ready$ ready.php [L]

    # web-vitals RUM beacon (docs/PLAN.md P1, item 11b). Clean-URL
    # target for build/vitals.ts's navigator.sendBeacon() call; the real
    # entry point is analytics_vitals.php (Piwigo\Controller\VitalsController
    # via config/routes.php), which needs the full bootstrap unlike
    # health.php/ready.php above.
    RewriteRule ^analytics/vitals$ analytics_vitals.php [L]

    # Test-mode-only error drain (docs/PLAN.md finding #7) --
    # Piwigo\Controller\TestErrorsController itself 404s outside test mode,
    # so no extra guard is needed here.
    RewriteRule ^__test/errors$ __test_errors.php [L]

    # Public API v1 (P27) -- clean /api/v1/... URLs (arbitrary path depth,
    # e.g. /api/v1/tags/5) all resolve to the one real entry point,
    # api.php; RouteDefinitions's own routes match the clean path (see
    # Piwigo\Routing\Router's own "falls back to raw REQUEST_URI" doc),
    # not this rewrite target.
    RewriteRule ^api/v1/ api.php [L]
</IfModule>

# SEC-05: Brotli compression (15-20% better than gzip for text assets).
# Falls back to mod_deflate (gzip) for clients/servers without it.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# SEC-06: hashed Vite output (app.abc12345.js) never needs revalidation.
<IfModule mod_headers.c>
    <FilesMatch "\.[0-9a-f]{8}\.(js|css|woff2|avif|webp|png|jpg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# [SEC-21] uploaded SVG/HTML must never render inline -- a genuinely-named
# "photo.svg"/"photo.html" (upload_form_all_types config) is otherwise
# served by the web server with its real content-type, letting an embedded
# <script> execute in the visitor's origin. Piwigo\Admin\Upload\
# UploadService::sanitizeSvgIfNeeded() already strips <script>/on*= content
# from SVGs at upload time (the other SEC-21 half); this forces a download
# instead of inline rendering as defense-in-depth for anything that slips
# through (e.g. HTML, which isn't sanitized the same way).
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} /upload/.*\.(svg|html?)$ [NC]
    RewriteRule ^ - [E=UPLOADED_SVG_HTML:1]
</IfModule>
<IfModule mod_headers.c>
    Header set Content-Disposition attachment env=UPLOADED_SVG_HTML
</IfModule>
