{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "piwigo/ws/categories.getList",
  "description": "pwg.categories.getList",
  "type": "object",
  "required": ["stat", "result"],
  "additionalProperties": false,
  "properties": {
    "stat": { "const": "ok" },
    "result": {
      "type": "object",
      "required": ["categories"],
      "additionalProperties": true,
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "nb_images",
              "total_nb_images",
              "nb_categories",
              "url"
            ],
            "additionalProperties": true,
            "properties": {
              "id": { "type": ["integer", "string"] },
              "name": { "type": "string" },
              "nb_images": { "type": ["integer", "string"] },
              "total_nb_images": { "type": ["integer", "string"] },
              "nb_categories": { "type": ["integer", "string"] },
              "url": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["public", "private"] },
              "id_uppercat": { "type": ["integer", "string", "null"] }
            }
          }
        }
      }
    }
  }
}
