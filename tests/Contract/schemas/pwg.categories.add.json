{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "piwigo/ws/categories.add",
  "description": "pwg.categories.add — returns {info, id}",
  "type": "object",
  "required": ["stat", "result"],
  "additionalProperties": false,
  "properties": {
    "stat": { "const": "ok" },
    "result": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id":   { "type": ["integer", "string"] },
        "info": { "type": "string" }
      }
    }
  }
}
