{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "piwigo/ws/getInfos",
  "description": "pwg.getInfos — installation statistics",
  "type": "object",
  "required": ["stat", "result"],
  "additionalProperties": false,
  "properties": {
    "stat": { "const": "ok" },
    "result": {
      "type": "object",
      "required": ["infos"],
      "additionalProperties": true,
      "properties": {
        "infos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": {}
            }
          }
        }
      }
    }
  }
}
