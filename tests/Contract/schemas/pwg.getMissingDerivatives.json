{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "piwigo/ws/getMissingDerivatives",
  "description": "pwg.getMissingDerivatives — admin only",
  "type": "object",
  "required": ["stat", "result"],
  "additionalProperties": false,
  "properties": {
    "stat": { "const": "ok" },
    "result": {
      "type": "object",
      "required": ["urls"],
      "additionalProperties": true,
      "properties": {
        "urls": { "type": "array" },
        "next_page": { "type": ["integer", "string"] }
      }
    }
  }
}
