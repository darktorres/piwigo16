{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "piwigo/ws/history.search",
  "description": "pwg.history.search — admin only",
  "type": "object",
  "required": ["stat", "result"],
  "additionalProperties": false,
  "properties": {
    "stat": { "const": "ok" },
    "result": {
      "type": "object",
      "required": ["lines"],
      "additionalProperties": true,
      "properties": {
        "lines": { "type": "array" },
        "maxPage": { "type": ["integer", "string"] }
      }
    }
  }
}
