{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "piwigo/ws/images.addComment",
  "description": "pwg.images.addComment — returns {comment:{id,validation}}",
  "type": "object",
  "required": ["stat", "result"],
  "additionalProperties": false,
  "properties": {
    "stat": { "const": "ok" },
    "result": {
      "type": "object",
      "required": ["comment"],
      "additionalProperties": true,
      "properties": {
        "comment": {
          "type": "object",
          "required": ["id"],
          "additionalProperties": true,
          "properties": {
            "id": { "type": ["integer", "string"] },
            "validation": { "type": "boolean" }
          }
        }
      }
    }
  }
}
