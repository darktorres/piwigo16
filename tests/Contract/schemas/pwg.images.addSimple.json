{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "piwigo/ws/images.addSimple",
  "description": "pwg.images.addSimple — returns {image_id, url}",
  "type": "object",
  "required": ["stat", "result"],
  "additionalProperties": false,
  "properties": {
    "stat": { "const": "ok" },
    "result": {
      "type": "object",
      "required": ["image_id", "url"],
      "additionalProperties": true,
      "properties": {
        "image_id": { "type": ["integer", "string"] },
        "url": { "type": "string", "minLength": 1 }
      }
    }
  }
}
