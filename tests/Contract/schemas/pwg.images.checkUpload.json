{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "piwigo/ws/images.checkUpload",
  "description": "pwg.images.checkUpload — admin only",
  "type": "object",
  "required": ["stat", "result"],
  "additionalProperties": false,
  "properties": {
    "stat": { "const": "ok" },
    "result": {
      "type": "object",
      "required": ["ready_for_upload"],
      "additionalProperties": true,
      "properties": {
        "ready_for_upload": { "type": "boolean" },
        "message":          { "type": ["string", "null"] }
      }
    }
  }
}
