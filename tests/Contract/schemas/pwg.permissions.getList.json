{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "piwigo/ws/permissions.getList",
  "description": "pwg.permissions.getList — admin only; result key is 'categories'",
  "type": "object",
  "required": ["stat", "result"],
  "additionalProperties": false,
  "properties": {
    "stat": { "const": "ok" },
    "result": {
      "type": "object",
      "required": ["categories"],
      "additionalProperties": true,
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": true,
            "properties": {
              "id":             { "type": ["integer", "string"] },
              "groups":         { "type": "array" },
              "users":          { "type": "array" },
              "users_indirect": { "type": "array" }
            }
          }
        }
      }
    }
  }
}
