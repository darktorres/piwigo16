{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "piwigo/ws/tags.getAdminList",
  "description": "pwg.tags.getAdminList — admin only; returns all tags regardless of visibility",
  "type": "object",
  "required": ["stat", "result"],
  "additionalProperties": false,
  "properties": {
    "stat": { "const": "ok" },
    "result": {
      "type": "object",
      "required": ["tags"],
      "additionalProperties": true,
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": ["integer", "string"] },
              "name": { "type": "string", "minLength": 1 },
              "url_name": { "type": "string" },
              "counter": { "type": ["integer", "string"] }
            }
          }
        }
      }
    }
  }
}
