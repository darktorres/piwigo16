{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "piwigo/ws/tags.getImages",
  "description": "pwg.tags.getImages — paged image list for given tags",
  "type": "object",
  "required": ["stat", "result"],
  "additionalProperties": false,
  "properties": {
    "stat": { "const": "ok" },
    "result": {
      "type": "object",
      "required": ["paging", "images"],
      "additionalProperties": true,
      "properties": {
        "paging": {
          "type": "object",
          "required": ["page", "per_page", "count"],
          "additionalProperties": true
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "file"],
            "additionalProperties": true,
            "properties": {
              "id":   { "type": ["integer", "string"] },
              "file": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
