{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "piwigo/ws/users.api_key.get",
  "description": "pwg.users.api_key.get — returns array of API keys or a message string when empty",
  "type": "object",
  "required": ["stat", "result"],
  "additionalProperties": false,
  "properties": {
    "stat": { "const": "ok" },
    "result": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["auth_key", "apikey_name"],
            "additionalProperties": true,
            "properties": {
              "auth_key": { "type": "string" },
              "apikey_name": { "type": "string" },
              "apikey_secret": { "type": "string" }
            }
          }
        },
        { "type": "string" }
      ]
    }
  }
}
