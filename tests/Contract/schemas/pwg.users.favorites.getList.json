{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "piwigo/ws/users.favorites.getList",
  "description": "pwg.users.favorites.getList — authenticated user only",
  "type": "object",
  "required": ["stat", "result"],
  "additionalProperties": false,
  "properties": {
    "stat": { "const": "ok" },
    "result": {
      "type": "object",
      "required": ["paging", "images"],
      "additionalProperties": true,
      "properties": {
        "paging": {
          "type": "object",
          "required": ["page", "per_page", "count"],
          "additionalProperties": true
        },
        "images": { "type": "array" }
      }
    }
  }
}
