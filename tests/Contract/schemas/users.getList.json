{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "piwigo/ws/users.getList",
  "description": "pwg.users.getList with display=basics — admin only",
  "type": "object",
  "required": ["stat", "result"],
  "additionalProperties": false,
  "properties": {
    "stat": { "const": "ok" },
    "result": {
      "type": "object",
      "required": ["users"],
      "additionalProperties": true,
      "properties": {
        "users": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "username"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": ["integer", "string"] },
              "username": { "type": "string", "minLength": 1 },
              "email": { "type": ["string", "null"] },
              "status": {
                "type": "string",
                "enum": ["webmaster", "admin", "normal", "generic", "guest"]
              },
              "level": { "type": ["integer", "string"] },
              "groups": { "type": "array" }
            }
          }
        }
      }
    }
  }
}
