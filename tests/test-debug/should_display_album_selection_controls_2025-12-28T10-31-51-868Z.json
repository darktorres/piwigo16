  "pageHtml": "<!DOCTYPE html><html lang=\"en\" dir=\"ltr\"><head>\n<meta name=\"apple-itunes-app\" content=\"app-id=472225196\">\n<meta charset=\"utf-8\">\n<title>Just another Piwigo gallery :: Piwigo Administration</title>\n<link rel=\"icon\" type=\"image/svg+xml\" href=\"themes/default/icon/piwigo.org-icon 1.svg\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"admin/themes/default/fonts/open-sans/open-sans.css\">\n\n  \n\n<!-- BEGIN get_combined -->\n<link rel=\"stylesheet\" type=\"text/css\" href=\"themes/default/vendor/fontello/css/gallery-icon.css?v16.0.0\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"admin/themes/default/fontello/css/fontello.css?v16.0.0\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"admin/themes/default/theme.css?v16.0.0\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"admin/themes/clear/theme.css?v16.0.0\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"admin/themes/default/css/components/general.css?v16.0.0\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"admin/themes/clear/css/components/general.css?v16.0.0\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"themes/default/js/plugins/jquery-confirm.min.css?v16.0.0\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"themes/default/js/plugins/plupload/jquery.plupload.queue/css/jquery.plupload.queue.css?v16.0.0\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"themes/default/js/plugins/colorbox/style2/colorbox.css?v16.0.0\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"themes/default/js/plugins/selectize.clear.css?v16.0.0\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"admin/themes/default/css/components/album_selector.css?v16.0.0\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"admin/themes/default/fontello/css/animation.css?v16.0.0\">\n\n<script type=\"text/javascript\" src=\"themes/default/js/jquery.min.js?v16.0.0\"></script>\n<!-- END get_combined -->\n\n<style type=\"text/css\">\n.addAlbumFormParent { display: none; } /* specific to this page, do not move in theme.css */</style>\n</head>\n\n<body id=\"theAdminPage\">\n\n<div id=\"the_page\">\n\n\n<div id=\"pwgHead\">\n  <a href=\"/piwigo16/\" class=\"visit-gallery tiptip\"><i class=\"icon-left-open\"></i>Visit</a>\n  <div class=\"pwgHead-gallery-title\">Just another Piwigo gallery</div>\n\n  <div id=\"headActions\">\n    <span class=\"admin-head-username\"><i class=\"icon-user\"></i>darktorres</span>\n\n<a href=\"./admin.php?page=photos_add&amp;change_theme=1\" class=\"tiptip\"><i class=\"icon-moon-inv\"></i><span>Dark</span></a>\n\n    <a class=\"tiptip\" href=\"./admin.php?page=help\"><i class=\"icon-help-circled\"></i><span>Help me</span></a>\n    <a href=\"./index.php?act=logout\"><i class=\"icon-logout\"></i><span>Logout</span></a>\n  </div>\n</div>\n\n<div style=\"clear:both;\"></div>\n\n\n<div id=\"pwgMain\">\n\n<div id=\"menubar\">\n  <div id=\"adminHome\"><a href=\"./admin.php\" class=\"admin-main\"><i class=\"icon-television\"></i> Dashboard</a></div>\n\n\t<dl>\n\t\t<dt><i class=\"icon-picture\"> </i><span>Photos&nbsp;</span><i class=\"icon-down-open open-menu\"></i></dt>\n\t\t<dd>\n\t\t\t<ul>\n\t\t\t\t<li><a href=\"./admin.php?page=photos_add\"><i class=\"icon-plus-circled\"></i>Add</a></li>\n\t\t\t\t<li><a href=\"./admin.php?page=tags\"><i class=\"icon-tags\"></i>Keywords</a></li>\n\t\t\t\t<li><a href=\"./admin.php?page=batch_manager&amp;filter=prefilter-last_import\"><i class=\"icon-clock\"></i>Recent photos</a></li>\n\t\t\t\t<li><a href=\"./admin.php?page=batch_manager\"><i class=\"icon-th\"></i>Batch Manager</a></li>\n\t\t\t\t<li><a href=\"./admin.php?page=batch_manager&amp;filter=prefilter-no_album\"><i class=\"icon-heart-broken\"></i>Orphans<span class=\"adminMenubarCounter\">1</span></a></li>\n\t\t\t</ul>\n\t\t</dd>\n  </dl>\n  <dl>\n\t\t<dt><i class=\"icon-sitemap\"> </i><span>Albums&nbsp;</span><i class=\"icon-down-open open-menu\"></i></dt>\n    <dd style=\"display: none;\">\n      <ul>\n        <li><a href=\"./admin.php?page=albums\"><i class=\"icon-folder-open\"></i>Manage</a></li>\n        <li><a href=\"./admin.php?page=cat_options\"><i class=\"icon-pencil\"></i>Properties</a></li>\n      </ul>\n    </dd>\n  </dl>\n  <dl>\n\t\t<dt><i class=\"icon-users\"> </i><span>Users&nbsp;</span><i class=\"icon-down-open open-menu\"></i></dt>\n\t\t<dd style=\"display: none;\">\n      <ul>\n        <li><a href=\"./admin.php?page=user_list\"><i class=\"icon-user-add\"></i>Manage</a></li>\n        <li><a href=\"./admin.php?page=group_list\"><i class=\"icon-group\"></i>Groups</a></li>\n\t\t\t\t<li><a href=\"./admin.php?page=notification_by_mail\"><i class=\"icon-mail-1\"></i>Notification</a></li>\n      </ul>\n\t\t</dd>\n  </dl>\n  <dl>\n\t\t<dt><a href=\"./admin.php?page=plugins\" class=\"admin-main\"><i class=\"icon-puzzle\"> </i><span>Plugins&nbsp;</span></a></dt>\n  </dl>\n  <dl>\n\t\t<dt><i class=\"icon-wrench\"> </i><span>Tools&nbsp;</span><i class=\"icon-down-open open-menu\"></i></dt>\n\t\t<dd style=\"display: none;\">\n      <ul>\n        <li><a href=\"./admin.php?page=site_update&amp;site=1\"><i class=\"icon-exchange\"></i>Synchronise</a></li>\n\t\t\t\t<li><a href=\"./admin.php?page=stats&amp;year=2025&amp;month=12\"><i class=\"icon-signal\"></i>History</a></li>\n\t\t\t\t<li><a href=\"./admin.php?page=maintenance\"><i class=\"icon-tools\"></i>Maintenance</a></li>\n\t\t\t\t<li><a href=\"./admin.php?page=comments\"><i class=\"icon-chat\"></i>Comments\n</a></li>\n        <li><a href=\"./admin.php?page=updates\"><i class=\"icon-arrows-cw\"></i>Updates</a></li>\n      </ul>\n\t\t</dd>\n  </dl>\n  <dl>\n\t\t<dt><i class=\"icon-cog\"> </i><span>Configuration&nbsp;</span><i class=\"icon-down-open open-menu\"></i></dt>\n\t\t<dd style=\"display: none;\">\n      <ul>\n        <li><a href=\"./admin.php?page=configuration\"><i class=\"icon-cog-alt\"></i>Options</a></li>\n        <li><a href=\"./admin.php?page=menubar\"><i class=\"icon-menu\"></i>Menus</a></li>\n        \t\t\t\t<li><a href=\"./admin.php?page=languages\"><i class=\"icon-language\"></i>Languages</a></li>\n        <li><a href=\"./admin.php?page=themes\"><i class=\"icon-brush\"></i>Themes</a></li>\n      </ul>\n    </dd>\n  </dl>\n</div> <!-- menubar -->\n\n<div id=\"content\" class=\"content\">\n\n  <h1>Upload photos<span class=\"admin-object-id\"></span></h1>\n\n  <div id=\"tabsheet\">\n<ul class=\"tabsheet\">\n  <li class=\"selected_tab\">\n    <a href=\"admin.php?page=photos_add&amp;section=direct\"><span><span class=\"icon-upload\"></span>Web Form</span></a>\n  </li>\n  <li class=\"normal_tab\">\n    <a href=\"admin.php?page=photos_add&amp;section=applications\"><span><span class=\"icon-network\"></span>Applications</span></a>\n  </li>\n  <li class=\"normal_tab\">\n    <a href=\"admin.php?page=photos_add&amp;section=ftp\"><span><span class=\"icon-exchange\"></span>FTP + Synchronisation</span></a>\n  </li>\n</ul>\n</div>\n\n<div class=\"eiw\">\n</div> \n  \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n \n\n\n<div style=\"display:none\">\n  <div id=\"addAlbumForm\">\n    <form>\n      <div class=\"popinField addAlbumFormParent\">\n        <span class=\"popinFieldLabel\">Parent album</span>\n        <select name=\"category_parent\"></select>\n      </div>\n\n      <div class=\"popinField\">\n        <span class=\"popinFieldLabel\">Album name</span>\n        <input name=\"category_name\" type=\"text\" maxlength=\"255\">\n        <span id=\"categoryNameError\" style=\"color:red;\">The name of an album must not be empty</span>\n      </div>\n\n      <div class=\"popinButtons\">\n        <input type=\"submit\" value=\"Create\" class=\"albumCreationButton\">\n        <span id=\"albumCreationLoading\"><span class=\"icon-spin6 animate-spin\"></span></span>\n      </div>\n    </form>\n  </div>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n<div id=\"photosAddContent\">\n\n     \n  <div class=\"addAlbumEmptyCenter\" style=\"display:none;\">\n    <div class=\"addAlbumEmpty\">\n      <div class=\"addAlbumEmptyTitle\">Welcome!</div>\n      <p class=\"addAlbumEmptyInfos\">Piwigo requires an album to add photos.</p>\n      <a class=\"buttonLike\" id=\"btnFirstAlbum\">Create a first album</a>\n    </div>\n  </div>\n<div class=\"infos\" style=\"display:none\"><i class=\"eiw-icon icon-ok\"></i></div>\n<div class=\"errors\" style=\"display:none\"><i class=\"eiw-icon icon-cancel\"></i><ul></ul></div>\n\n<p class=\"afterUploadActions\" style=\"margin:10px; display:none;\"> \n    <a class=\"batchLink icon-pencil\"></a><span class=\"buttonSeparator\">or</span><a href=\"admin.php?page=photos_add\" class=\"secondary_button icon-plus-circled\">Add another set of photos</a>\n</p>\n\n  <form id=\"uploadForm\" class=\"\" enctype=\"multipart/form-data\" method=\"post\" action=\"admin.php?page=photos_add\" style=\"position: relative;\">\n    <fieldset class=\"selectAlbum\">\n      <legend><span class=\"icon-folder-open icon-red\"></span>Select an album</legend>\n      <div class=\"selectedAlbum\" style=\"display: none\" id=\"selectedAlbum\">\n        <span class=\"icon-sitemap\" id=\"selectedAlbumName\"></span>\n        <a class=\"icon-pencil\" id=\"selectedAlbumEdit\"></a>\n      </div>\n      <div class=\"selectAlbumSelector\" id=\"addPhotosAS\">\n        <p class=\"head-button-1 icon-folder-open\" id=\"btnPhotosAS\">Select or create an album</p>\n      </div>\n    </fieldset>\n    <fieldset class=\"selectFiles\">\n\n      <legend>\n        <div style=\"display:flex;align-items: center;\">\n          <span class=\"icon-file-image icon-yellow\"></span>Select files\n          <div id=\"uploadOptions\" class=\"upload-options\">\n            <span class=\"icon-equalizer rotate-element upload-options-icon\"></span>Options\n          </div>\n        </div>\n      <div class=\"upload-options-content\" id=\"uploadOptionsContent\" style=\"display: none;\">\n        <label class=\"switch\">\n          <input type=\"checkbox\" id=\"toggleUpdateMode\">\n          <span class=\"slider round\"></span>\n        </label>\n        <div style=\"margin-left: 6px;\">\n          <p>If a photo in this album has the same filename, update the file without changing the photo's properties</p>\n        </div>\n      </div>\n      </legend>\n\n      <div class=\"selectFilesButtonBlock\">\n        <button id=\"addFiles\" class=\"buttonLike icon-plus-circled\" disabled=\"\" style=\"position: relative; z-index: 1;\">\n          Add Photos        </button>\n        <div class=\"selectFilesinfo\">\n            <p id=\"uploadWarningsSummary\">\n              Allowed file types: jpg, jpeg, png, gif, webp.\n            </p>\n          <p></p>\n          <p></p>\n        </div>\n      </div>\n      <div class=\"photosUploader\" id=\"uploader\" style=\"display: none;\"><div class=\"plupload_wrapper plupload_scroll\"><div id=\"uploader_container\" class=\"plupload_container\"><div class=\"plupload\"><div class=\"plupload_header\"><div class=\"plupload_header_content\"><div class=\"plupload_header_title\">Select files</div><div class=\"plupload_header_text\">Add files to the upload queue and click the start button.</div></div></div><div class=\"plupload_content\"><div class=\"plupload_filelist_header\"><div class=\"plupload_file_name\">Filename</div><div class=\"plupload_file_action\">&nbsp;</div><div class=\"plupload_file_status\"><span>Status</span></div><div class=\"plupload_file_size\">Size</div><div class=\"plupload_clearer\">&nbsp;</div></div><ul id=\"uploader_filelist\" class=\"plupload_filelist\" style=\"position: relative;\"><li class=\"plupload_droptext\">Drag files here.</li></ul><div class=\"plupload_filelist_footer\"><div class=\"plupload_file_name\"><div class=\"plupload_buttons\"><a href=\"#\" class=\"plupload_button plupload_add\" id=\"uploader_browse\">Add Files</a><a href=\"#\" class=\"plupload_button plupload_start plupload_disabled\">Start Upload</a></div><span class=\"plupload_upload_status\"></span></div><div class=\"plupload_file_action\"></div><div class=\"plupload_file_status\"><span class=\"plupload_total_status\">0%</span></div><div class=\"plupload_file_size\"><span class=\"plupload_total_file_size\">0 b</span></div><div class=\"plupload_progress\"><div class=\"plupload_progress_container\"><div class=\"plupload_progress_bar\"></div></div></div><div class=\"plupload_clearer\">&nbsp;</div></div></div></div></div><input type=\"hidden\" id=\"uploader_count\" name=\"uploader_count\" value=\"0\"></div></div>\n      <div class=\"selectAlbumFirst\" id=\"chooseAlbumFirst\">\n        <p>First choose an album, then add your files</p>\n      </div>\n    </fieldset>\n    \n    <div id=\"uploadingActions\" style=\"display:none\">\n      <div class=\"big-progressbar\" style=\"max-width:98%;margin-bottom: 10px;\">\n        <div class=\"progressbar\" style=\"width:0%\"></div>\n      </div>\n      <button id=\"cancelUpload\" class=\"buttonLike icon-cancel-circled\">Cancel</button>\n    </div>\n\n    <button id=\"startUpload\" class=\"buttonLike icon-upload\" disabled=\"\">Start upload</button>\n\n  <div id=\"html5_1jdi876l4n2d1bi7a2o1vth12sh3_container\" class=\"moxie-shim moxie-shim-html5\" style=\"position: absolute; top: 181px; left: 31px; width: 111px; height: 46px; overflow: hidden; z-index: 0;\"><input id=\"html5_1jdi876l4n2d1bi7a2o1vth12sh3\" type=\"file\" style=\"font-size: 999px; opacity: 0; position: absolute; top: 0px; left: 0px; width: 100%; height: 100%;\" multiple=\"\" accept=\"image/jpeg,image/png,image/gif,.webp\"></div></form>\n\n  <fieldset style=\"display:none\" class=\"Addedphotos\">\n    <div id=\"uploadedPhotos\"></div>\n  </fieldset>\n\n</div> <!-- photosAddContent -->\n<div class=\"bg-modal\" id=\"addFirstAlbum\">\n  <div class=\"new-album-modal-content\">\n     <a class=\"icon-cancel close-modal\" id=\"closeFirstAlbum\"></a>\n\n    <div class=\"AddIconContainer\">\n     <span class=\"AddIcon icon-blue icon-add-album\"></span>\n    </div>\n    <div class=\"AddIconTitle\">\n      <span>Create your first album</span>\n    </div>\n    <div class=\"AddAlbumInputContainer\">\n      <label class=\"user-property-label AddAlbumLabelUsername\">Album name\n        <input class=\"user-property-input\" id=\"inputFirstAlbum\">\n      </label>\n    </div>\n    <a class=\"buttonLike icon-plus\" id=\"btnAddFirstAlbum\">Create and select</a>\n\n  </div>\n</div>\n\n\n\n\n\n\n\n\n<div id=\"addLinkedAlbum\" class=\"linkedAlbumPopIn\">\n  <div class=\"linkedAlbumPopInContainer\">\n    <a class=\"gallery-icon-cancel ClosePopIn\" id=\"closeAlbumPopIn\"></a>\n\n    <div class=\"AddIconContainer\">\n      <span class=\"AddIcon icon-blue gallery-icon-plus-circled\"></span>\n    </div>\n    <div class=\"AddIconTitle\">\n      <span id=\"linkedModalTitle\"></span>\n    </div>\n\n    <div class=\"album-selector\" id=\"linkedAlbumSelector\">\n      \n      \n\n      <div id=\"linkedAlbumSearch\">\n        <span class=\"icon-search search-icon\"> </span>\n        <span class=\"icon-cancel search-cancel-linked-album\" style=\"display: none;\"></span>\n        <input class=\"search-input\" type=\"text\" id=\"search-input-ab\" placeholder=\"\">\n      </div>\n      <div class=\"limitReached\"></div>\n      <div class=\"noSearch\"></div>\n      <div class=\"searching gallery-icon-spin6 animate-spin\"> </div>\n    </div>\n\n    <div id=\"searchResult\">\n    </div>\n\n    <div class=\"album-create\" id=\"linkedAlbumCreate\" style=\"display: none;\">\n      <div class=\"linked-album-subtitle\">\n        <p id=\"linkedAlbumSubtitle\">Add a sub-album of “Album 3”</p>\n      </div>\n\n      <div class=\"linked-album-input-container album-name\">\n        <label class=\"user-property-label\">Album name\n          <input class=\"user-property-input\" id=\"linkedAlbumInput\">\n        </label>\n      </div>\n\n      <div class=\"linked-album-input-container\">\n        <label class=\"user-property-label\">Position\n          <div class=\"linked-add-radio-input\">\n            <input type=\"radio\" id=\"place-start\" name=\"position\" value=\"first\" checked=\"\">\n            <label for=\"place-start\">Place first</label>\n          </div>\n          <div class=\"linked-add-radio-input\">\n            <input type=\"radio\" id=\"place-end\" name=\"position\" value=\"last\">\n            <label for=\"place-end\">Place last</label>\n          </div>\n        </label>\n      </div>\n\n      <div class=\"AddAlbumErrors\">\n        <p class=\"icon-cancel\" id=\"linkedAddAlbumErrors\">omg big big error</p>\n      </div>\n\n      <div class=\"linked-album-create-btn\">\n        <p class=\"linked-button-cancel\" id=\"linkedAlbumCancel\">Cancel</p>\n        <p class=\"buttonLike icon-plus\" id=\"linkedAddNewAlbum\">Create and select</p>\n      </div>\n    </div>\n\n    <div class=\"album-switch-bottom\" id=\"linkedAlbumSwitch\">\n      <div class=\"album-switch-container\">\n        <div class=\"switch-input\">\n          <label class=\"switch\">\n            <input type=\"checkbox\" name=\"locked\" id=\"album-create-check\" value=\"true\">\n            <span class=\"slider round\"></span>\n          </label>\n          <label class=\"switch-label\" for=\"album-create-check\"><span>Creation mode</span> <i class=\"icon-help-circled tiptip\" style=\"cursor:help\"></i></label>\n        </div>\n        <p class=\"head-button-2 icon-plus-circled linked-add-album\" id=\"linkedAddAlbum\">\n          Create a root album</p>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n</div>\n</div>\n\n\n<div id=\"footer\">\n  <div>\n    <a class=\"externalLink tiptip piwigo-logo\" href=\"https://piwigo.org\"><img src=\"admin/themes/default/images/piwigo-grey.svg\"></a>\n    <span id=\"whats_new_notification\" class=\"icon-blue tiptip\" onclick=\"show_user_whats_new()\">\n      <i class=\"icon-bell\"></i>\n    </span>\n  </div>\n  <div id=\"pageInfos\">\n    Contact\n    <a href=\"mailto:updated_1766915672523@test.local?subject=A%20comment%20on%20your%20site\">Webmaster</a>\n  </div>\n</div></div>\n<div id=\"whats_new\">\n    <div id=\"whats_new_popin\">\n      <a class=\"icon-cancel close_whats_new\" onclick=\"hide_user_whats_new()\"></a>\n      <h3>What's new in version 16?</h3>\n      <div>\n        <div class=\"whats_new_block_container\">\n          <div class=\"whats_new_block icon-blue whats_new_block_w_60\">\n            <h4>Brand new login &amp; preferences with Standard pages!</h4>\n            <a href=\"https://piwigo.org/releases/16.0.0\" target=\"_blank\"><img src=\"https://ressources.piwigo.com/uploads/c/v/7/cv7jpz6hf8//2025/11/12/20251112112645-7e309b67.png\"></a>\n          </div>\n          <div class=\"whats_new_block icon-purple whats_new_block_w_40\">\n            <h4>Two factor authentication is here</h4>\n            <a href=\"https://piwigo.org/releases/16.0.0\" target=\"_blank\"><img src=\"https://ressources.piwigo.com/uploads/c/v/7/cv7jpz6hf8//2025/11/12/20251112112645-61f2fcd0.png\"></a>\n          </div>\n        </div>\n        <div class=\"whats_new_block_container\">\n          <div class=\"whats_new_block icon-green whats_new_block_w_100\">\n            <h4>UI redesigns that make a difference</h4>\n            <a href=\"https://piwigo.org/releases/16.0.0\" target=\"_blank\"><img src=\"https://ressources.piwigo.com/uploads/c/v/7/cv7jpz6hf8//2025/11/12/20251112112646-b322153b.png\"></a>\n          </div>\n                </div>\n      <div class=\"whats_new_buttons\">\n        <button onclick=\"hide_user_whats_new()\"><i class=\"icon-thumbs-up\"></i> Ok, got it!</button>\n        <a class=\"buttonLike\" href=\"https://piwigo.org/releases/16.0.0\" target=\"_blank\"><i class=\"icon-book\"></i> Read the release note</a>\n      </div>\n    </div>\n</div>\n\n<style>\n\n\n</style>\n\n\n\n\n<!-- BEGIN get_combined -->\n<script type=\"text/javascript\" src=\"admin/themes/default/js/LocalStorageCache.js?v16.0.0\"></script>\n<script type=\"text/javascript\" src=\"admin/themes/default/js/addAlbum.js?v16.0.0\"></script>\n<script type=\"text/javascript\" src=\"admin/themes/default/js/photos_add_direct.js?v16.0.0\"></script>\n<script type=\"text/javascript\" src=\"admin/themes/default/js/album_selector.js?v16.0.0\"></script>\n<script type=\"text/javascript\" src=\"admin/themes/default/js/common.js?v16.0.0\"></script>\n<script type=\"text/javascript\" src=\"themes/default/js/plugins/piecon.js?v16.0.0\"></script>\n<script type=\"text/javascript\" src=\"themes/default/js/plugins/jquery.colorbox.min.js?v16.0.0\"></script>\n<script type=\"text/javascript\" src=\"themes/default/js/plugins/jquery-confirm.min.js?v16.0.0\"></script>\n<script type=\"text/javascript\" src=\"themes/default/js/plugins/plupload/plupload.full.min.js?v16.0.0\"></script>\n<script type=\"text/javascript\" src=\"themes/default/js/plugins/plupload/jquery.plupload.queue/jquery.plupload.queue.min.js?v16.0.0\"></script>\n<script type=\"text/javascript\" src=\"themes/default/js/plugins/selectize.min.js?v16.0.0\"></script>\n<script type=\"text/javascript\" src=\"themes/default/js/plugins/jquery.tipTip.minified.js?v16.0.0\"></script>\n<script type=\"text/javascript\" src=\"themes/default/js/plugins/plupload/i18n/en.js?v16.0.0\"></script>\n<script type=\"text/javascript\">//<![CDATA[\n\nconst formatMode = false;\nconst haveFormatsOriginal = false;\nconst originalImageId = haveFormatsOriginal? ' -1 ' : -1;\nconst imageFormatsExtensions = '';\nconst nb_albums = 6;\nconst chunk_size = '500kb';\nconst max_file_size = '1000mb';\nconst format_update_warning = \"This format already exists, it will be overwritten !\";\nconst format_remove = \"Remove\";\nvar pwg_token = 'aec1a65635564474ac3adf675b8ccb5e';\nconst photosAdded_label = \"%d photos uploaded\";\nconst photosUpdated_label = \"%d photos updated\";\nconst formatsAdded_label = \"%d formats added for %d photos\";\nconst formatsUpdated_label = \"%d formats updated for %d photos\";\nconst batch_Label = \"Manage this set of %d photos\";\nconst albumSummary_label = \"Album \\\"%s\\\" now contains %d photos\";\nconst str_format_warning =