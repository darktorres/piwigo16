{if !empty($blocks) }
<div id="menubar">
	{foreach $blocks as $id => $block}
	<dl id="{$id}">
		{if !empty($block->template)}
		{var $blockTpl = $block->template|get_extent:$id}
		{include $blockTpl, block: $block, id: $id}
		{else}
		{$block->raw_content}
		{/if}
	</dl>
	{/foreach}
</div><div id="menuSwitcher"></div>
{/if}