<dt>{='Links'|translate}</dt>
<dd>
	<ul>{spaceless}
		{foreach $block->data as $link}
			<li>
				<a href="{$link['URL']}" class="external"{if isset($link['new_window'])} data-window-open-name="{$link['new_window']['NAME']}" data-window-open-features="{$link['new_window']['FEATURES']}"{/if}>
				{$link['LABEL']}
				</a>
			</li>
		{/foreach}
	{/spaceless}</ul>
</dd>
