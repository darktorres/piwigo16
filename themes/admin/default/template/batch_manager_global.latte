{templateType Piwigo\Admin\Projection\BatchManagerGlobalView}
{* Kept -- this is real markup (the "add album" popin form), not just
   asset registration; BatchManagerGlobalView::pageAssets() already
   merges in AddAlbumView's own combineCss/combineScript contribution
   too (PageAssets::add()'s dedup makes that a harmless no-op). *}
{include 'include/add_album.inc.latte', load_mode: 'async'}

{do combineScript(id: 'common', load: 'footer', path: 'themes/admin/default/js/common.js')}

{do combineScript(id: 'jquery.progressBar', load: 'async', path: 'themes/default/js/plugins/jquery.progressbar.min.js')}
{do combineScript(id: 'jquery.ajaxmanager', load: 'async', path: 'themes/default/js/plugins/jquery.ajaxmanager.js')}

{do combineScript(id: 'batchManagerGlobal', load: 'async', require: 'jquery,datepicker,jquery.colorbox,addAlbum,doubleSlider', path: 'themes/admin/default/js/batchManagerGlobal.js')}

{do combineScript(id: 'batch_manager_global', load: 'footer', require: 'page-data', path: 'themes/admin/default/js/batch_manager_global.js')}
{do combineCss(id: 'batch_manager_global', path: 'themes/admin/default/css/pages/batch_manager_global.css')}
{do exposeData('cache_key_tags', $cacheKeys['tags'])}
{do exposeData('cache_key_categories', $cacheKeys['categories'])}
{do exposeData('cache_key_hash', $cacheKeys['_hash'])}
{do exposeData('root_url', $ROOT_URL)}
{do exposeData('associated_categories', $associated_categories)}
{do exposeData('nb_thumbs_page', $nbThumbsPage)}
{do exposeData('nb_thumbs_set', $nbThumbsSet)}
{do exposeData('all_elements', $all_elements)}
{do exposeString('Cancel')}
{do exposeString('Deletion in progress')}
{do exposeString('Synchronization in progress')}
{do exposeString('Are you sure?')}
{do exposeString('Generate multiple size images')}
{do exposeString('Create')}
{do exposeString('on the %d selected photos')}
{do exposeString('%d of %d photos selected')}
{do exposeString('No photo selected, %d photos in current set')}
{do exposeString('All %d photos are selected')}
{do exposeString('Add Album')}
{do exposeString('Select an album')}

{do combineScript(id: 'jquery.confirm', load: 'footer', require: 'jquery', path: 'themes/default/js/plugins/jquery-confirm.min.js')}
{do combineCss(path: "themes/default/js/plugins/jquery-confirm.min.css")}
{do combineCss(path: "themes/admin/default/fontello/css/animation.css", order: 10)} {* order 10 is required, see issue 1080 *}

<div id="batchManagerGlobal">
  <form action="{$F_ACTION|noescape}" method="post">
    <input type="hidden" name="start" value="{$START}">
    <input type="hidden" name="pwg_token" value="{$CSRF_TOKEN}">
    {var $filterTitle = ('Batch Manager Filter'|translate)}
    {var $filterSearchPlaceholder = ('Filters'|translate)}
    {include 'include/batch_manager_filter.inc.latte', title: $filterTitle, searchPlaceholder: $filterSearchPlaceholder}
    <fieldset>
      <legend><span
          class='icon-check icon-blue '
        ></span>{='Selection'|translate}</legend>

      {if !empty($thumbnails)}
        <p id="checkActions">
          {if $nbThumbsSet > $nbThumbsPage}
            <a href="#" id="selectAll">{='The whole page'|translate}</a>
            <a href="#" id="selectSet">{='The whole set'|translate}</a>
          {else}
            <a href="#" id="selectAll">{='All'|translate}</a>
          {/if}
          <a href="#" id="selectNone">{='None'|translate}</a>
          <a href="#" id="selectInvert">{='Invert'|translate}</a>

          <span id="selectedMessage"></span>

          <input
            type="checkbox"
            name="setSelected"
            class="u-hidden"
            {if count($selection) == $nbThumbsSet}
            checked="checked"
            {/if}
          >
          <input type="hidden" name="whole_set" value="">
        </p>

        <ul class="thumbnails" style="--tn-width:{$thumbParams->maxWidth() + 2}px; --tn-height:{$thumbParams->maxHeight() + 25}px;">
          {foreach $thumbnails as $thumbnail}
            {var $isSelected = ($thumbnail['id']|in_array:$selection)}
            <li {if $isSelected} class="thumbSelected" {/if}>
              <span class="wrap1">
                <label class="font-checkbox">
                  <span class="icon-check"></span><input
                    type="checkbox"
                    name="selection[]"
                    value="{$thumbnail['id']}"
                    {if $isSelected}
                    checked="checked"
                    {/if}
                  >
                  <span class="wrap2">
                    <div class="actions">
                      <a
                        href="{$thumbnail['U_EDIT']}"
                        target="_blank"
                        class="icon-pencil"
                        title="{='Edit photo'|translate}"
                      ></a>
                      <a
                        href="{$thumbnail['FILE_SRC']|noescape}"
                        class="preview-box icon-zoom-square"
                        title="{='Zoom'|translate}"
                      ></a>
                    </div>
                    <em
                      n:if="$thumbnail['level'] > 0"
                      class="levelIndicatorF"
                      title="{='Who can see these photos?'|translate} : "
                    >{='Level %d'|sprintf:$thumbnail['level']|translate}</em>
                    <img
                      src="{$thumbnail['thumb']->getUrl()}"
                      alt="{$thumbnail['file']}"
                      title="{$thumbnail['TITLE']}"
                      {$thumbnail['thumb']->getSizeHtm()|noescape}
                    >
                  </span>
                </label>
              </span>
            </li>
          {/foreach}
        </ul>

        <div n:if="!empty($navbar)" class="batchManager-pagination">
          <div class="pagination-per-page">
            <span>{='display'|translate}</span>
            <a href="{$U_DISPLAY|noescape}&amp;display=20">20</a>
            <a href="{$U_DISPLAY|noescape}&amp;display=50">50</a>
            <a href="{$U_DISPLAY|noescape}&amp;display=100">100</a>
            <a
              href="{$U_DISPLAY|noescape}&amp;display=all"
            >{='all'|translate}</a>
          </div>

          {include 'navigation_bar.latte', navbar: $navbar}
        </div>
      {else}
        <div
          class="selectionEmptyBlock"
        >{='No photo in the current set.'|translate}</div>
      {/if}
    </fieldset>

    <fieldset id="action">
      <legend><span
          class='icon-cog icon-red'
        ></span>{='Action'|translate}</legend>
      <div
        id="forbidAction"
        {if count($selection) != 0}
        class="u-hidden"
        {/if}
      >{='No photos selected, no actions possible.'|translate}</div>
      <div
        id="permitAction"
        {if count($selection) == 0}
        class="u-hidden"
        {/if}
      >
        <div class="permitActionListButton">
          <div>
            <select name="selectAction">
              <option value="-1">{='Choose an action'|translate}</option>
              <option disabled="disabled">------------------</option>
              <option
                value="delete"
                class="icon-trash"
              >{='Delete selected photos'|translate}</option>
              <option
                value="associate"
              >{='Associate to album'|translate}</option>
              <option value="move">{='Move to album'|translate}</option>
              <option
                n:if="!empty($associated_categories)"
                value="dissociate"
              >{='Dissociate from album'|translate}</option>
              <option value="add_tags">{='Add tags'|translate}</option>
              <option
                n:if="!empty($associatedTags)"
                value="del_tags"
              >{='remove tags'|translate}</option>
              <option value="author">{='Set author'|translate}</option>
              <option value="title">{='Set title'|translate}</option>
              <option
                value="date_creation"
              >{='Set creation date'|translate}</option>
              <option
                value="level"
                class="icon-lock"
              >{='Who can see these photos?'|translate} ({='Privacy level'|translate})</option>
              <option
                value="metadata"
              >{='Synchronize metadata'|translate}</option>
              {if $inCaddie}
                <option
                  value="remove_from_caddie"
                >{='Remove from caddie'|translate}</option>
              {else}
                <option
                  value="add_to_caddie"
                >{='Add to caddie'|translate}</option>
              {/if}
              <option
                value="delete_derivatives"
              >{='Delete multiple size images'|translate}</option>
              <option
                value="generate_derivatives"
              >{='Generate multiple size images'|translate}</option>
              {if !empty($element_set_global_plugins_actions)}
                <option
                  n:foreach="$element_set_global_plugins_actions as $action"
                  value="{$action['ID']}"
                >{$action['NAME']}</option>
              {/if}
            </select>
          </div>
          <p id="confirmDel" class="u-invisible">
            <label class="font-checkbox">
              <span class="icon-check"></span>
              <input
                type="checkbox"
                name="confirm_deletion"
                value="1"
              > {='Are you sure?'|translate}
            </label><br /><br />
            <span
              class="errors u-invisible"
            >{="You need to confirm deletion"|translate}</span>
          </p>
          <p
            id="applyActionBlock"
            class="actionButtons u-hidden"
          >
            <button
              id="applyAction"
              name="submit"
              type="submit"
              class="buttonLike"
            >
              <i class="icon-cog-alt"></i> {='Apply action'|translate}
            </button>

            <span id="applyOnDetails"></span>
          </p>
        </div>
        <div class="permitActionItem">
          <!-- delete -->
          <div id="action_delete" class="bulkAction"></div>

          <!-- associate -->
          <div id="action_associate" class="bulkAction">
            <div class="head-button-2 icon-plus-circled" id="associate_as">
              <p>{="Select an album"|translate}</p>
            </div>
            <div class="selected-associate-action"></div>
          </div>

          <!-- move -->
          <div id="action_move" class="bulkAction">
            <select
              data-selectize="categories"
              data-default=""
              name="move"
              placeholder="{='Select an album... or type it!'|translate}"
            ></select>
            <a
              href="#"
              data-add-album="move"
              title="{='create a new album'|translate}"
              class="icon-plus"
            ></a>
          </div>

          <!-- dissociate -->
          <div id="action_dissociate" class="bulkAction">
            <select
              data-selectize="categories"
              placeholder="{='Type in a search term'|translate}"
              name="dissociate"
            ></select>
          </div>

          <!-- add_tags -->
          <div id="action_add_tags" class="bulkAction">
            <select
              data-selectize="tags"
              data-create="true"
              placeholder="{='Type in a search term'|translate}"
              name="add_tags[]"
              multiple
            ></select>
          </div>

          <!-- del_tags -->
          <div id="action_del_tags" class="bulkAction">
            <select
              n:if="!empty($associatedTags)"
              data-selectize="tags"
              name="del_tags[]"
              multiple
              placeholder="{='Type in a search term'|translate}"
            >
              <option
                n:foreach="$associatedTags as $tag"
                value="{$tag['id']}"
              >{$tag['name']}</option>
            </select>
          </div>

          <!-- author -->
          <div id="action_author" class="bulkAction">
            <label class="font-checkbox"><span class="icon-check"></span><input
                type="checkbox"
                name="remove_author"
              > {='remove author'|translate}</label>
            <input
              type="text"
              class="large"
              name="author"
              placeholder="{='Type here the author name'|translate}"
            >
          </div>

          <!-- title -->
          <div id="action_title" class="bulkAction">
            <label class="font-checkbox"><span class="icon-check"></span><input
                type="checkbox"
                name="remove_title"
              > {='remove title'|translate}</label>
            <input
              type="text"
              class="large"
              name="title"
              placeholder="{='Type here the title'|translate}"
            >
          </div>

          <!-- date_creation -->
          <div id="action_date_creation" class="bulkAction">
            <label class="font-checkbox"><span class="icon-check"></span><input
                type="checkbox"
                name="remove_date_creation"
              > {='remove creation date'|translate}</label><br>
            <div id="set_date_creation">
              <input
                type="hidden"
                name="date_creation"
                value="{$dateCreation}"
              >
              <label>
                <i class="icon-calendar"></i>
                <input type="text" data-datepicker="date_creation" readonly>
              </label>
            </div>
          </div>

          <!-- level -->
          <div id="action_level" class="bulkAction">
            <select name="level" size="1">
              {=htmlOptions(options: $levelOptions, selected: $levelOptionsSelected)}
            </select>
          </div>

          <!-- metadata -->
          <div id="action_metadata" class="bulkAction"></div>

          <!-- generate derivatives -->
          <div id="action_generate_derivatives" class="bulkAction">
            <div class="deleteDerivButtons">
              <a
                href="javascript:selectGenerateDerivAll()"
              >{='All'|translate}</a>
              <a
                href="javascript:selectGenerateDerivNone()"
              >{='None'|translate}</a>
            </div>
            <br>
            <label
              n:foreach="$generateDerivativesTypes as $type => $disp"
              class="font-checkbox"
            ><span class="icon-check"></span><input
                type="checkbox"
                name="generate_derivatives_type[]"
                value="{$type}"
              > {$disp}</label>
          </div>

          <!-- delete derivatives -->
          <div id="action_delete_derivatives" class="bulkAction">
            <div class="deleteDerivButtons">
              <a href="javascript:selectDelDerivAll()">{='All'|translate}</a>
              <a href="javascript:selectDelDerivNone()">{='None'|translate}</a>
            </div>
            <br>
            <label
              n:foreach="$delDerivativesTypes as $type => $disp"
              class="font-checkbox"
            ><span class="icon-check"></span><input
                type="checkbox"
                name="del_derivatives_type[]"
                value="{$type}"
              > {$disp}</label>
          </div>

          <!-- plugins -->
          {if !empty($element_set_global_plugins_actions)}
            <div
              n:foreach="$element_set_global_plugins_actions as $action"
              id="action_{$action['ID']}"
              class="bulkAction"
            >
              {if !empty($action['CONTENT'])}{$action['CONTENT']|noescape}{/if}
            </div>
          {/if}
        </div>
      </div> <!-- #permitAction -->
      <div
        id="regenerationMsg"
        class="bulkAction u-hidden"
      >
        <div id="regenerationStatus">
          <span
            id="regenerationText"
          >{='Generate multiple size images'|translate}</span>
          <span class="badge-number"></span>
        </div>
        <input type="hidden" name="regenerateSuccess" value="0">
        <input type="hidden" name="regenerateError" value="0">
      </div>
      <!-- progress bar -->
      <div id="uploadingActions" class="u-hidden">
        <div
          class="big-progressbar"
        >
          <div class="progressbar"></div>
        </div>
      </div>
    </fieldset>
  </form>
</div> <!-- #batchManagerGlobal -->
{include 'include/album_selector.inc.latte'}
