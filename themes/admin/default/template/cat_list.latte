{templateType Piwigo\Admin\Projection\CatListView}
<div class="selectedAlbum cat-list-album-path">
  <span
    class="icon-sitemap selectedAlbum-first"
  >{$categoriesNav|noescape}</span>
  <div class="AlbumViewSelector">
    <input
      type="radio"
      name="layout"
      class="switchLayout"
      id="displayCompact"
      {if $albumViewSelected === 'compact'}
      checked
      {/if}
    /><label for="displayCompact"><span
        class="icon-th-large firstIcon tiptip"
        title="{='Compact View'|translate}"
      ></span></label><input
      type="radio"
      name="layout"
      class="switchLayout tiptip"
      id="displayLine"
      {if $albumViewSelected === 'line'}
      checked
      {/if}
    /><label for="displayLine"><span
        class="icon-th-list tiptip"
        title="{='Line View'|translate}"
      ></span></label><input
      type="radio"
      name="layout"
      class="switchLayout"
      id="displayTile"
      {if $albumViewSelected === 'tile'}
      checked
      {/if}
    /><label for="displayTile"><span
        class="icon-pause lastIcon tiptip"
        title="{='Tile View'|translate}"
      ></span></label>
  </div>
</div>
{var $color_tab = ["icon-red", "icon-blue", "icon-yellow", "icon-purple", "icon-green"]}
<div class="categoryContainer">
  <div class="addAlbum">
    <div class="addAlbumHead">
      <span class="icon-plus-circled icon-blue icon-blue-full"></span>
      <p>{='Add Album'|translate}</p>
    </div>
    <form action="{$formAction|noescape}" method="post">
      <input type="hidden" name="pwg_token" value="{$csrfToken}">
      <label for="virtual_name">{='Album name'|translate}</label>
      <input
        type="text"
        name="virtual_name"
        placeholder="{='Album name'|translate}"
      >
      <button name="submitAdd" type="submit" class="buttonLike">
        <i class="icon-plus"></i> {='Create'|translate}
      </button>
      <a class="cancelAddAlbum">{='Cancel'|translate}</a>
    </form>
  </div>
  {if $categories !== []}
    <div
      n:foreach="$categories as $category"
      class="categoryBox{if $category->isVirtual} virtual_cat{/if}"
      id="cat_{$category->id}"
    >
      <div class="albumTop">
        <div class="albumIcon">
          <span
            class="
        {if $category->nbSubAlbums === 0}icon-folder-open{else}icon-sitemap{/if}
        {$color_tab[$category->id % 5]}
        "
          ></span>
        </div>

        <div class="albumTitle">
          {$category->name}
        </div>
      </div>

      <span
        class="albumInfos"
      ><p>{$category->nbPhotos|translate_dec:'%d photo','%d photos'}</p> <p>{$category->nbSubPhotos|translate_dec:'%d photo','%d photos'} {$category->nbSubAlbums|translate_dec:'in %d sub-album','in %d sub-albums'}</p></span>

      <div class="albumActions">
        <a
          href="{$category->uEdit|noescape}"
          class="actionEdit"
          {*title="{'Edit'|@translate}"*}
        ><span
            class="icon-pencil tiptip"
            title="{='Edit'|translate}"
          ></span><span class="iconLegend">{='Edit'|translate}</span></a>
        <a
          href="{$category->uChildren|noescape}"
          class="actionTitle"
          {*title="{'sub-albums'|@translate}"*}
        ><span
            class="icon-sitemap tiptip"
            title="{='sub-albums'|translate}"
          ></span><span class="iconLegend">{='sub-albums'|translate}</span></a>
        <a href="{$category->uMove|noescape}" class="actionMove"><span
            class="icon-move tiptip"
            title="{='Move'|translate}"
          ></span><span class="iconLegend">{='Move'|translate}</span></a>
        {* Reads the per-row permission the renderer actually computes.
         The original .tpl checked a bare $CAT_ADMIN_ACCESS that nothing
         ever assigned, so this link never rendered for anyone -- Smarty
         resolved the unassigned variable to null silently, and the
         Latte conversion preserved that with an isset() guard rather than
         change behaviour mid-migration. CategoryService::catAdminAccess()
         answers "this album is not in the user's forbidden list", per row,
         which is exactly what gating a jump-to-gallery link wants. *}
        {if $category->catAdminAccess}
          <a
            href="{$category->uJumpto|noescape}"
            class="actionGalery"
            {*title="{'Visit Gallery'|@translate}"*}
          ><span
              class="icon-eye tiptip"
              title="{='Visit Gallery'|translate}"
            ></span><span
              class="iconLegend"
            >{='Visit Gallery'|translate}</span></a>
        {else}
          <span
            href="{$category->uJumpto|noescape}"
            class="actionGalery"
            {*title="{'This album is private'|@translate}"*}
          ><span
              class="icon-eye tiptip"
              title="{='This album is private'|translate}"
            ></span><span
              class="iconLegend"
            >{='Visit Gallery'|translate}</span></span>
        {/if}
        <a
          href="{$category->uAddPhotosAlbum|noescape}"
          class="actionAdd"
          {*title="{'Add Photos'|@translate}"*}
        ><span
            class="icon-plus tiptip"
            title="{='Add Photos'|translate}"
          ></span><span class="iconLegend">{='Add Photos'|translate}</span></a>
      </div>
    </div>
  {/if}
</div>
