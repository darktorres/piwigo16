{templateType Piwigo\Admin\Projection\CatListView}
{do combineScript(id: 'common', load: 'footer', path: 'themes/admin/default/js/common.js')}

{do combineScript(id: 'alternativeView', load: 'footer', path: 'themes/admin/default/js/cat_list.js')}
{do combineScript(id: 'jquery.cookie', path: 'themes/default/js/jquery.cookie.js', load: 'footer')}
{do combineCss(id: 'cat_list', path: 'themes/admin/default/css/pages/cat_list.css')}

<div class="selectedAlbum cat-list-album-path">
  <span
    class="icon-sitemap selectedAlbum-first"
  >{$categoriesNav|noescape}</span>
  <div class="AlbumViewSelector">
    <input
      type="radio"
      name="layout"
      class="switchLayout"
      id="displayCompact"
      {if ($_COOKIE['pwg_album_manager_view'] ?? null) == 'compact'}
      checked
      {/if}
    /><label for="displayCompact"><span
        class="icon-th-large firstIcon tiptip"
        title="{='Compact View'|translate}"
      ></span></label><input
      type="radio"
      name="layout"
      class="switchLayout tiptip"
      id="displayLine"
      {if ($_COOKIE['pwg_album_manager_view'] ?? null) == 'line'}
      checked
      {/if}
    /><label for="displayLine"><span
        class="icon-th-list tiptip"
        title="{='Line View'|translate}"
      ></span></label><input
      type="radio"
      name="layout"
      class="switchLayout"
      id="displayTile"
      {if ($_COOKIE['pwg_album_manager_view'] ?? null) == 'tile' || !($_COOKIE['pwg_album_manager_view'] ?? null)}
      checked
      {/if}
    /><label for="displayTile"><span
        class="icon-pause lastIcon tiptip"
        title="{='Tile View'|translate}"
      ></span></label>
  </div>
</div>
{var $color_tab = ["icon-red", "icon-blue", "icon-yellow", "icon-purple", "icon-green"]}
<div class="categoryContainer">
  <div class="addAlbum">
    <div class="addAlbumHead">
      <span class="icon-plus-circled icon-blue icon-blue-full"></span>
      <p>{='Add Album'|translate}
      </div>
    <form action="{$formAction|noescape}" method="post">
      <input type="hidden" name="pwg_token" value="{$csrfToken}">
      <label for="virtual_name">{='Album name'|translate}</label>
      <input
        type="text"
        name="virtual_name"
        placeholder="{='Album name'|translate}"
      >
      <button name="submitAdd" type="submit" class="buttonLike">
        <i class="icon-plus"></i> {='Create'|translate}
      </button>
      <a class="cancelAddAlbum">{='Cancel'|translate}</a>
    </form>
  </div>
  {if count($categories)}
    <div
      n:foreach="$categories as $category"
      class="categoryBox{if $category['IS_VIRTUAL']} virtual_cat{/if}"
      id="cat_{$category['ID']}"
    >
      <div class="albumTop">
        <div class="albumIcon">
          <span
            class="
        {if $category['NB_SUB_ALBUMS'] == 0}icon-folder-open{else}icon-sitemap{/if}
        {$color_tab[$category['ID'] % 5]}
        "
          ></span>
        </div>

        <div class="albumTitle">
          {$category['NAME']}
        </div>
      </div>

      <span
        class="albumInfos"
      ><p>{$category['NB_PHOTOS']|translate_dec:'%d photo','%d photos'}</p> <p>{$category['NB_SUB_PHOTOS']|translate_dec:'%d photo','%d photos'} {$category['NB_SUB_ALBUMS']|translate_dec:'in %d sub-album','in %d sub-albums'}</p></span>

      <div class="albumActions">
        <a
          href="{$category['U_EDIT']|noescape}"
          class="actionEdit"
          {*title="{'Edit'|@translate}"*}
        ><span
            class="icon-pencil tiptip"
            title="{='Edit'|translate}"
          ></span><span class="iconLegend">{='Edit'|translate}</span></a>
        <a
          href="{$category['U_CHILDREN']|noescape}"
          class="actionTitle"
          {*title="{'sub-albums'|@translate}"*}
        ><span
            class="icon-sitemap tiptip"
            title="{='sub-albums'|translate}"
          ></span><span class="iconLegend">{='sub-albums'|translate}</span></a>
        <a href="{$category['U_MOVE']|noescape}" class="actionMove"><span
            class="icon-move tiptip"
            title="{='Move'|translate}"
          ></span><span class="iconLegend">{='Move'|translate}</span></a>
        {* NOTE: this is a real, pre-existing bug in the original .tpl -- it
         checks a bare $CAT_ADMIN_ACCESS, but the renderer only ever sets
         $category['CAT_ADMIN_ACCESS'] (a per-row field). The bare variable
         is never assigned anywhere, so this condition is always false under
         Smarty too (its variable resolution silently treats an unassigned
         var as null, no warning) -- the isset() guard here reproduces that
         exact always-false behavior without Latte's stricter direct-PHP
         variable access surfacing a new "undefined variable" warning on
         every render. Not fixed to $category['CAT_ADMIN_ACCESS'] -- that
         would change which branch renders, a real behavior change beyond
         this migration's engine-swap scope. *}
        {if isset($CAT_ADMIN_ACCESS) && $CAT_ADMIN_ACCESS}
          <a
            href="{$category['U_JUMPTO']|noescape}"
            class="actionGalery"
            {*title="{'Visit Gallery'|@translate}"*}
          ><span
              class="icon-eye tiptip"
              title="{='Visit Gallery'|translate}"
            ></span><span
              class="iconLegend"
            >{='Visit Gallery'|translate}</span></a>
        {else}
          <span
            href="{$category['U_JUMPTO']|noescape}"
            class="actionGalery"
            {*title="{'This album is private'|@translate}"*}
          ><span
              class="icon-eye tiptip"
              title="{='This album is private'|translate}"
            ></span><span
              class="iconLegend"
            >{='Visit Gallery'|translate}</span></span>
        {/if}
        <a
          href="{$category['U_ADD_PHOTOS_ALBUM']|noescape}"
          class="actionAdd"
          {*title="{'Add Photos'|@translate}"*}
        ><span
            class="icon-plus tiptip"
            title="{='Add Photos'|translate}"
          ></span><span class="iconLegend">{='Add Photos'|translate}</span></a>
      </div>
    </div>
  {/if}
</div>
