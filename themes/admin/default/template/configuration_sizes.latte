{templateType Piwigo\Controller\Admin\Projection\ConfigurationSizesView}
{do combineScript(id: 'common', load: 'footer', path: 'themes/admin/default/js/common.js')}
{do combineScript(id: 'jquery.confirm', load: 'footer', require: 'jquery', path: 'themes/default/js/plugins/jquery-confirm.min.js')}
{do combineCss(path: "themes/default/js/plugins/jquery-confirm.min.css")}
{do exposeString('Are you sure you want to restore to default settings?')}
{do exposeString('Yes, I am sure')}
{do exposeString('No, I have changed my mind')}
{do exposeString('Maximum width')}
{do exposeString('Width')}
{do exposeString('Maximum height')}
{do exposeString('Height')}
{do combineScript(id: 'configuration_sizes', load: 'footer', require: 'common,jquery.confirm,page-data', path: 'themes/admin/default/js/configuration_sizes.js')}

{do combineCss(id: 'configuration_sizes', path: 'themes/admin/default/css/pages/configuration_sizes.css')}

<form method="post" action="{$fAction|noescape}" class="properties">
  <div id="configContent">
    <fieldset id="sizesConf">
      <legend><span
          class="icon-picture icon-red"
        ></span>{='Original Size'|translate}</legend>
      {if (isset($isGd) and $isGd)}
        <div>
          {='Resize after upload disabled due to the use of GD as graphic library'|translate}
          <input
            type="checkbox"
            name="original_resize"
            disabled="disabled"
            class="u-invisible"
          >
          <input
            type="hidden"
            name="original_resize_maxwidth"
            value="{$sizes['original_resize_maxwidth']}"
          >
          <input
            type="hidden"
            name="original_resize_maxheight"
            value="{$sizes['original_resize_maxheight']}"
          >
          <input
            type="hidden"
            name="original_resize_quality"
            value="{$sizes['original_resize_quality']}"
          >
        </div>
      {else}
        <div>
          <label class="font-checkbox">
            <span class="icon-check"></span>
            <input
              type="checkbox"
              name="original_resize"
              {if (isset($sizes['original_resize']) and $sizes['original_resize'])}
              checked="checked"
              {/if}
            >
            {='Resize after upload'|translate}
          </label>
        </div>

        <table id="sizeEdit-original">
          <tr>
            <th>{='Maximum width'|translate}</th>
            <td>
              <input
                type="text"
                name="original_resize_maxwidth"
                value="{$sizes['original_resize_maxwidth']}"
                size="4"
                maxlength="4"
                {if isset($ferrors['original_resize_maxwidth'])}
                class="dError"
                {/if}
              > {='pixels'|translate}
              <span
                n:if="isset($ferrors['original_resize_maxwidth'])"
                class="dErrorDesc"
                title="{$ferrors['original_resize_maxwidth']}"
              >!</span>
            </td>
          </tr>
          <tr>
            <th>{='Maximum height'|translate}</th>
            <td>
              <input
                type="text"
                name="original_resize_maxheight"
                value="{$sizes['original_resize_maxheight']}"
                size="4"
                maxlength="4"
                {if isset($ferrors['original_resize_maxheight'])}
                class="dError"
                {/if}
              > {='pixels'|translate}
              <span
                n:if="isset($ferrors['original_resize_maxheight'])"
                class="dErrorDesc"
                title="{$ferrors['original_resize_maxheight']}"
              >!</span>
            </td>
          </tr>
          <tr>
            <th>{='Image Quality'|translate}</th>
            <td>
              <input
                type="text"
                name="original_resize_quality"
                value="{$sizes['original_resize_quality']}"
                size="3"
                maxlength="3"
                {if isset($ferrors['original_resize_quality'])}
                class="dError"
                {/if}
              > %
              <span
                n:if="isset($ferrors['original_resize_quality'])"
                class="dErrorDesc"
                title="{$ferrors['original_resize_quality']}"
              >!</span>
            </td>
          </tr>
        </table>
      {/if}
    </fieldset>

    <fieldset id="multiSizesConf">
      <legend><span
          class="icon-th icon-purple"
        ></span>{='Multiple Size'|translate}</legend>

      <div class="showDetails">
        <a
          href="#"
          id="showDetails"
          class="{if isset($ferrors)}u-hidden{/if}"
        >{='show details'|translate}</a>
      </div>

      <table class="multi-sizes-table">
        {foreach $derivatives as $type => $d}
          <tr>
            <td>
              <label>
                {if $d['must_enable']}
                  <span class="sizeEnable">
                    <span class="icon-ok"></span>
                  </span>
                {else}
                  <span class="sizeEnable font-checkbox">
                    <span class="icon-check"></span>
                    <input
                      type="checkbox"
                      name="d[{$type}][enabled]"
                      {if $d['enabled']}
                      checked="checked"
                      {/if}
                    >
                  </span>
                {/if}
                {$type|translate}
              </label>
            </td>

            <td>
              <span
                class="sizeDetails{if isset($ferrors)} u-inline{/if}"
              >{$d['w']} x {$d['h']} {='pixels'|translate}{if $d['crop']}, {='Crop'|translate|lower}{/if}</span>
            </td>

            <td>
              <span
                class="sizeDetails{if isset($ferrors) and !isset($ferrors[$type])} u-inline{/if}"
              >
                <a
                  href="#"
                  id="sizeEditOpen-{$type}"
                  class="sizeEditOpen"
                >{='edit'|translate}</a>
              </span>
            </td>
          </tr>

          <tr
            id="sizeEdit-{$type}"
            class="sizeEdit{if isset($ferrors[$type])} u-block{/if}"
          >
            <td colspan="3">
              <table class="sizeEditForm">
                <tr n:if="!$d['must_square']">
                  <td colspan="2">
                    <label class="font-checkbox">
                      <span class="icon-check"></span>
                      <input
                        type="checkbox"
                        class="cropToggle"
                        name="d[{$type}][crop]"
                        {if $d['crop']}
                        checked="checked"
                        {/if}
                      >
                      {='Crop'|translate}
                    </label>
                  </td>
                </tr>
                <tr>
                  <td
                    class="sizeEditWidth"
                  >{if $d['must_square'] or $d['crop']}{='Width'|translate}{else}{='Maximum width'|translate}{/if}</td>
                  <td>
                    <input
                      type="text"
                      name="d[{$type}][w]"
                      maxlength="4"
                      size="4"
                      value="{$d['w']}"
                      {if isset($ferrors[$type]['w'])}
                      class="dError"
                      {/if}
                    > {='pixels'|translate}
                    <span
                      n:if="isset($ferrors[$type]['w'])"
                      class="dErrorDesc"
                      title="{$ferrors[$type]['w']}"
                    >!</span>
                  </td>
                </tr>
                <tr n:if="!$d['must_square']">
                  <td
                    class="sizeEditHeight"
                  >{if $d['crop']}{='Height'|translate}{else}{='Maximum height'|translate}{/if}</td>
                  <td>
                    <input
                      type="text"
                      name="d[{$type}][h]"
                      maxlength="4"
                      size="4"
                      value="{$d['h']}"
                      {if isset($ferrors[$type]['h'])}
                      class="dError"
                      {/if}
                    > {='pixels'|translate}
                    <span
                      n:if="isset($ferrors[$type]['h'])"
                      class="dErrorDesc"
                      title="{$ferrors[$type]['h']}"
                    >!</span>
                  </td>
                </tr>
                <tr>
                  <td>{='Sharpen'|translate}</td>
                  <td>
                    <input
                      type="text"
                      name="d[{$type}][sharpen]"
                      maxlength="4"
                      size="4"
                      value="{$d['sharpen']}"
                      {if isset($ferrors[$type]['sharpen'])}
                      class="dError"
                      {/if}
                    > %
                    <span
                      n:if="isset($ferrors[$type]['sharpen'])"
                      class="dErrorDesc"
                      title="{$ferrors[$type]['sharpen']}"
                    >!</span>
                  </td>
                </tr>
              </table> {* #sizeEdit *}
            </td>
          </tr>
        {/foreach}
      </table>

      <p
        class="sizeDetails{if isset($ferrors)} u-block{/if}"
      >
        {='Image Quality'|translate}
        <input
          type="text"
          name="resize_quality"
          value="{$resizeQuality}"
          size="3"
          maxlength="3"
          {if isset($ferrors['resize_quality'])}
          class="dError"
          {/if}
        > %
        <span
          n:if="isset($ferrors['resize_quality'])"
          class="dErrorDesc"
          title="{$ferrors['resize_quality']}"
        >!</span>
      </p>
      <p
        class="sizeDetails{if isset($ferrors)} u-block{/if}"
      >
        <a
          href="{$fAction|noescape}&action=restore_settings&pwg_token={$csrfToken}"
          class="restore-settings-button"
        >{='Reset to default values'|translate}</a>
      </p>
    </fieldset>
  </div> <!-- configContent -->

  <div class="savebar-footer">
    <div class="savebar-footer-start"></div>
    <div class="savebar-footer-end">
      <div n:if="isset($saveSuccess)" class="savebar-footer-block">
        <div class="badge info-message">
          <i class="icon-ok"></i>{$saveSuccess}
        </div>
      </div>
      <div class="savebar-footer-block">
        <button
          class="buttonLike"
          type="submit"
          name="submit"
          {if $isWebmaster != 1}
          disabled
          {/if}
        ><i class="icon-floppy"></i> {='Save Settings'|translate}</button>
      </div>
    </div>
    <input type="hidden" name="pwg_token" value="{$csrfToken}">
  </div>
</form>
