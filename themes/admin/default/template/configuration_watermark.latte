{templateType Piwigo\Controller\Admin\Projection\ConfigurationWatermarkView}
<form
  method="post"
  action="{$fAction|noescape}"
  class="properties"
  enctype="multipart/form-data"
>
  <div id="configContent">
    <fieldset id="watermarkConf" class="no-border">
      <legend></legend>
      <ul>
        <li>
          <span
            id="selectWatermark"
            class="{if isset($ferrors['watermarkImage'])}u-hidden{/if}"
          ><label>{='Select a file'|translate}</label>
            <select name="w[file]" id="wSelect">
              <option
                n:foreach="$watermarkFiles as $optKey => $optLabel"
                value="{$optKey}"
                n:attr="selected: in_array($optKey, array_map(strval(...), (array) $watermark['file']), true) ? 'selected' : null"
              >{html_entity_decode(strval($optLabel))}</option>
            </select>

            {='... or '|translate}<a
              href="#"
              class="addWatermarkOpen"
            >{='add a new watermark'|translate}</a>
            <br>
            <img id="wImg">
          </span>

          <span
            id="addWatermark"
            class="{if isset($ferrors['watermarkImage'])}u-inline{/if}"
          >
            {='add a new watermark'|translate} {='... or '|translate}<a
              href="#"
              class="addWatermarkOpen"
            >{='Select a file'|translate}</a>

            <br>
            <input
              type="file"
              size="60"
              id="watermarkImage"
              name="watermarkImage"
              {if isset($ferrors['watermarkImage'])}
              class="dError"
              {/if}
            > (png)
            <span
              n:if="isset($ferrors['watermarkImage'])"
              class="dErrorDesc"
              title="{$ferrors['watermarkImage']|htmlspecialchars|noescape}"
            >!</span>
          </span>
        </li>

        <li>
          <label>
            {='Apply watermark if width is bigger than'|translate}
            <input
              size="4"
              maxlength="4"
              type="text"
              name="w[minw]"
              value="{$watermark['minw']}"
              {if isset($ferrors['watermark']['minw'])}
              class="dError"
              {/if}
            >
          </label>
          {='pixels'|translate}
        </li>

        <li>
          <label>
            {='Apply watermark if height is bigger than'|translate}
            <input
              size="4"
              maxlength="4"
              type="text"
              name="w[minh]"
              value="{$watermark['minh']}"
              {if isset($ferrors['watermark']['minh'])}
              class="dError"
              {/if}
            >
          </label>
          {='pixels'|translate}
        </li>

        <li>
          <label>{='Position'|translate}</label>
          <br>
          <div id="watermarkPositionBox">
            <label
              class="right font-checkbox"
            >{='top right corner'|translate} <span
                class="icon-dot-circled"
              ></span><input
                name="w[position]"
                type="radio"
                value="topright"
                {if $watermark['position'] == 'topright'}
                checked="checked"
                {/if}
              ></label>
            <label class="font-checkbox"><span
                class="icon-dot-circled"
              ></span><input
                name="w[position]"
                type="radio"
                value="topleft"
                {if $watermark['position'] == 'topleft'}
                checked="checked"
                {/if}
              > {='top left corner'|translate}</label>
            <label class="middle font-checkbox"><span
                class="icon-dot-circled"
              ></span><input
                name="w[position]"
                type="radio"
                value="middle"
                {if $watermark['position'] == 'middle'}
                checked="checked"
                {/if}
              > {='middle'|translate}</label>
            <label
              class="right font-checkbox"
            >{='bottom right corner'|translate} <span
                class="icon-dot-circled"
              ></span><input
                name="w[position]"
                type="radio"
                value="bottomright"
                {if $watermark['position'] == 'bottomright'}
                checked="checked"
                {/if}
              ></label>
            <label class="font-checkbox"><span
                class="icon-dot-circled"
              ></span><input
                name="w[position]"
                type="radio"
                value="bottomleft"
                {if $watermark['position'] == 'bottomleft'}
                checked="checked"
                {/if}
              > {='bottom left corner'|translate}</label>
          </div>

          <label class="font-checkbox custom-position-label"><span
              class="icon-dot-circled"
            ></span><input
              name="w[position]"
              type="radio"
              value="custom"
              {if $watermark['position'] == 'custom'}
              checked="checked"
              {/if}
            > {='custom'|translate}</label>

          <div id="positionCustomDetails">
            <label>{='X Position'|translate}
              <input
                size="3"
                maxlength="3"
                type="text"
                name="w[xpos]"
                value="{$watermark['xpos']}"
                {if isset($ferrors['watermark']['xpos'])}
                class="dError"
                {/if}
              >%
              <span
                n:if="isset($ferrors['watermark']['xpos'])"
                class="dErrorDesc"
                title="{$ferrors['watermark']['xpos']}"
              >!</span>
            </label>

            <br>
            <label>{='Y Position'|translate}
              <input
                size="3"
                maxlength="3"
                type="text"
                name="w[ypos]"
                value="{$watermark['ypos']}"
                {if isset($ferrors['watermark']['ypos'])}
                class="dError"
                {/if}
              >%
              <span
                n:if="isset($ferrors['watermark']['ypos'])"
                class="dErrorDesc"
                title="{$ferrors['watermark']['ypos']}"
              >!</span>
            </label>

            <br>
            <label>{='X Repeat'|translate}
              <input
                size="3"
                maxlength="3"
                type="text"
                name="w[xrepeat]"
                value="{$watermark['xrepeat']}"
                {if isset($ferrors['watermark']['xrepeat'])}
                class="dError"
                {/if}
              >
              <span
                n:if="isset($ferrors['watermark']['xrepeat'])"
                class="dErrorDesc"
                title="{$ferrors['watermark']['xrepeat']}"
              >!</span>
            </label>

            <br>
            <label>{='Y Repeat'|translate}
              <input
                size="3"
                maxlength="3"
                type="text"
                name="w[yrepeat]"
                value="{$watermark['yrepeat']}"
                {if isset($ferrors['watermark']['yrepeat'])}
                class="dError"
                {/if}
              >
              <span
                n:if="isset($ferrors['watermark']['yrepeat'])"
                class="dErrorDesc"
                title="{$ferrors['watermark']['yrepeat']}"
              >!</span>
            </label>
          </div>
        </li>

        <li>
          <label>{='Opacity'|translate}</label>
          <input
            size="3"
            maxlength="3"
            type="text"
            name="w[opacity]"
            value="{$watermark['opacity']}"
            {if isset($ferrors['watermark']['opacity'])}
            class="dError"
            {/if}
          > %
          <span
            n:if="isset($ferrors['watermark']['opacity'])"
            class="dErrorDesc"
            title="{$ferrors['watermark']['opacity']}"
          >!</span>
        </li>
      </ul>
    </fieldset>
  </div> <!-- configContent -->

  <div class="savebar-footer">
    <div class="savebar-footer-start"></div>
    <div class="savebar-footer-end">
      <div n:if="isset($saveSuccess)" class="savebar-footer-block">
        <div class="badge info-message">
          <i class="icon-ok"></i>{$saveSuccess}
        </div>
      </div>
      <div class="savebar-footer-block">
        <button
          class="buttonLike"
          type="submit"
          name="submit"
          {if $isWebmaster != 1}
          disabled
          {/if}
        ><i class="icon-floppy"></i> {='Save Settings'|translate}</button>
      </div>
    </div>
    <input type="hidden" name="pwg_token" value="{$csrfToken}">
  </div>
</form>
