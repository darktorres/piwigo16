{if once('inc_album_selector')}
  {if empty($load_mode)}{var $load_mode = 'footer'}{/if}
  {include 'colorbox.inc.latte', load_mode: $load_mode}
  {do combineCss(path: "themes/admin/default/css/components/album_selector.css")}
  {do combineCss(path: "themes/default/vendor/fontello/css/gallery-icon.css", order: -10)}
  {do combineScript(id: 'albumSelector', load: $load_mode, path: 'themes/admin/default/js/album_selector.js')}
  {* {combine_script id='albumSelector' load=$load_mode path='themes/admin/default/js/test-ab.js'} *}
  {do combineScript(id: 'common', load: 'footer', path: 'themes/admin/default/js/common.js')}
  {capture $tmpFooterScript}
  const str_plus_albums_found = {=json_encode(translate('Only the first %d albums are displayed, out of %d.'), \JSON_UNESCAPED_UNICODE)|noescape}
  const str_album_selected = {=json_encode(translate('Album already selected'), \JSON_UNESCAPED_UNICODE)|noescape}
  const str_already_in_related_cats = {=json_encode(translate('This albums is already in related categories list'), \JSON_UNESCAPED_UNICODE)|noescape};
  const str_no_search_in_progress = {=json_encode(translate('No search in progress'), \JSON_UNESCAPED_UNICODE)|noescape};
  const str_albums_found = {=json_encode(translate("<b>%d</b> albums found"), \JSON_UNESCAPED_UNICODE)|noescape};
  const str_album_found = {=json_encode(translate("<b>1</b> album found"), \JSON_UNESCAPED_UNICODE)|noescape};
  const str_result_limit = {=json_encode(translate("<b>%d+</b> albums found, try to refine the search"), \JSON_UNESCAPED_UNICODE)|noescape};
  const str_add_subcat_of = {=json_encode(translate("Add a sub-album to “%s”"), \JSON_UNESCAPED_UNICODE)|noescape};
  const str_create_and_select = {=json_encode(translate("Create and select"), \JSON_UNESCAPED_UNICODE)|noescape};
  const str_root_album_select = {=json_encode(translate("Root"), \JSON_UNESCAPED_UNICODE)|noescape};
  const str_complete_name_field = {=json_encode(translate("Name field must not be empty"), \JSON_UNESCAPED_UNICODE)|noescape};
  const str_an_error_has_occured = {=json_encode(translate("An error has occured"), \JSON_UNESCAPED_UNICODE)|noescape};
  const str_album_modal_title = {=json_encode(translate('Select an album'), \JSON_UNESCAPED_UNICODE)|noescape};
  const str_album_modal_placeholder = {=json_encode(translate('Search'), \JSON_UNESCAPED_UNICODE)|noescape};
  const str_root = {=json_encode(translate('Root'), \JSON_UNESCAPED_UNICODE)|noescape};
{/capture}
  {do footerScript($tmpFooterScript)}

  <div id="addLinkedAlbum" class="linkedAlbumPopIn">
    <div class="linkedAlbumPopInContainer">
      <a class="gallery-icon-cancel ClosePopIn" id="closeAlbumPopIn"></a>

      <div class="AddIconContainer">
        <span class="AddIcon icon-blue gallery-icon-plus-circled"></span>
      </div>
      <div class="AddIconTitle">
        <span id="linkedModalTitle"></span>
      </div>

      <div class="album-selector" id="linkedAlbumSelector">
        <label
          class="head-button-2 put-to-root-container notClickable"
          id="put-to-root"
        >
          <p class="icon-home">{='Put at the root'|translate}</p>
        </label>
        <p class="put-to-root-container">{='or'|translate}</p>

        <div id="linkedAlbumSearch">
          <span class='icon-search search-icon'></span>
          <span
            class="icon-cancel search-cancel-linked-album"
            style="display: none;"
          ></span>
          <input
            class='search-input'
            type='text'
            id="search-input-ab"
            placeholder=""
          >
        </div>
        <div class="limitReached"></div>
        <div class="noSearch"></div>
        <div class="searching gallery-icon-spin6 animate-spin"></div>
      </div>

      <div id="searchResult"></div>

      <div class="album-create" id="linkedAlbumCreate" style="display: none;">
        <div class="linked-album-subtitle">
          <p id="linkedAlbumSubtitle">Add a sub-album of “Album 3”</p>
        </div>

        <div class="linked-album-input-container album-name">
          <label class="user-property-label">{='Album name'|translate}
            <input class="user-property-input" id="linkedAlbumInput" />
          </label>
        </div>

        <div class="linked-album-input-container">
          <label class="user-property-label">{='Position'|translate}
            <div class="linked-add-radio-input">
              <input
                type="radio"
                id="place-start"
                name="position"
                value="first"
                checked
              >
              <label for="place-start">{='Place first'|translate}</label>
            </div>
            <div class="linked-add-radio-input">
              <input type="radio" id="place-end" name="position" value="last">
              <label for="place-end">{='Place last'|translate}</label>
            </div>
          </label>
        </div>

        <div class="AddAlbumErrors">
          <p class="icon-cancel" id="linkedAddAlbumErrors">omg big big error</p>
        </div>

        <div class="linked-album-create-btn">
          <p
            class="linked-button-cancel"
            id="linkedAlbumCancel"
          >{='Cancel'|translate}</p>
          <p
            class="buttonLike icon-plus"
            id="linkedAddNewAlbum"
          >{='Create and select'|translate}</p>
        </div>
      </div>

      <div class="album-switch-bottom" id="linkedAlbumSwitch">
        <div class="album-switch-container">
          <div class="switch-input">
            <label class="switch">
              <input
                type="checkbox"
                name="locked"
                id="album-create-check"
                value="true"
              >
              <span class="slider round"></span>
            </label>
            <label
              class="switch-label"
              for="album-create-check"
            ><span>{='Creation mode'|translate}</span> <i
                class="icon-help-circled tiptip"
                style="cursor:help"
                title="{="Activate create mode to create and select an album"|translate}"
              ></i></label>
          </div>
          <p
            class="head-button-2 icon-plus-circled linked-add-album"
            id="linkedAddAlbum"
          >
            {="Create a root album"|translate}</p>
        </div>
      </div>
    </div>
  </div>
{/if}
