{templateType Piwigo\Admin\Install\Projection\InstallView}
<!DOCTYPE html>
<html lang="{$lang_info['code']}" dir="{$lang_info['direction']}">
  <head>
    <meta
      http-equiv="Content-Type"
      content="text/html; charset={$tContentEncoding}"
    >
    <meta http-equiv="Content-script-type" content="text/javascript">
    <meta http-equiv="Content-Style-Type" content="text/css">
    <link
      rel="shortcut icon"
      type="image/x-icon"
      href="{$ROOT_URL}{$themeconf['icon_dir']}/favicon.ico"
    >

    {=getCombinedCss()}

    {=getCombinedScripts('header')}

    <title>Piwigo {$release} - {='Installation'|translate}</title>
  </head>

  <body>
    <div id="the_page">
      <div id="theHeader"></div>
      <div id="content" class="content">
        <h2>{='Version'|translate} {$release} - {='Installation'|translate}</h2>

        <div n:if="isset($errors)" class="errors">
          <ul>
            {* The 3 checks Part 2's own JS mirrors inline near their
               field -- shown there instead, so a failed submit doesn't
               show the same message twice. $dedupErrorStrings holds the
               already-translated form of each of those 3 messages
               (computed server-side from the exact same $this->lang->t()
               calls analyzeForm() itself uses), so this stays correct in
               any locale without embedding raw string literals here. *}
            <li
              n:foreach="$errors as $error"
              n:if="! in_array($error, $dedupErrorStrings, true)"
            >{$error}</li>
          </ul>
        </div>

        <div n:if="isset($infos)" class="infos">
          <ul>
            <li n:foreach="$infos as $info">{$info}</li>
          </ul>
        </div>

        {if isset($install)}
          <div class="writable-checklist">
            <p>{='Filesystem permissions'|translate}</p>
            <ul>
              <li
                n:foreach="$writableChecks as $check"
                class="{$check['writable'] ? 'writable-ok' : 'writable-bad'}"
              >{$check['writable'] ? '✓' : '✗'} {$check['label']|translate}: <code>{$check['path']}</code></li>
            </ul>
          </div>

          <form method="POST" action="{$fAction|noescape}" name="install_form">
            <fieldset>
              <legend>{='Basic configuration'|translate}</legend>

              <table class="table2">
                <tr>
                  <td
                    class="table2-label-col"
                  >{='Default gallery language'|translate}</td>
                  <td>
                    <select
                      name="language"
                      id="language"
                    >
                      <option
                        n:foreach="$languageOptions as $optKey => $optLabel"
                        value="{$optKey}"
                        n:attr="selected: in_array($optKey, array_map(strval(...), (array) $languageSelection), true) ? 'selected' : null"
                      >{html_entity_decode(strval($optLabel))}</option>
                    </select>
                  </td>
                </tr>
              </table>
            </fieldset>

            <fieldset>
              <legend>{='Database configuration'|translate}</legend>

              <table class="table2">
                <tr>
                  <td
                    class="table2-label-col fieldname"
                  ><label for="dbdriver">{='Database type'|translate}</label></td>
                  <td>
                    <select
                      name="dbdriver"
                      id="dbdriver"
                      onchange="document.getElementById('dbport').placeholder = (this.value === 'pgsql') ? '5432' : '3306';"
                    >
                      <option
                        value="mysqli"
                        {if $fDbDriver != 'pgsql'}
                        selected
                        {/if}
                      >MySQL / MariaDB</option>
                      <option
                        value="pgsql"
                        {if $fDbDriver == 'pgsql'}
                        selected
                        {/if}
                      >PostgreSQL</option>
                    </select>
                  </td>
                  <td
                    class="fielddesc"
                  >{='MySQL/MariaDB or PostgreSQL, matching what your host provider gave you'|translate}</td>
                </tr>
                <tr>
                  <td
                    class="table2-label-col fieldname"
                  ><label for="dbhost">{='Host'|translate}</label></td>
                  <td><input
                      type="text"
                      name="dbhost"
                      id="dbhost"
                      value="{$fDbHost}"
                      required
                    ></td>
                  <td
                    class="fielddesc"
                  >{='localhost or other, supplied by your host provider'|translate}</td>
                </tr>
                <tr>
                  <td class="fieldname"><label for="dbport">{='Port'|translate}</label></td>
                  <td><input
                      type="number"
                      name="dbport"
                      id="dbport"
                      value="{$fDbPort}"
                      placeholder="{if $fDbDriver == 'pgsql'}5432{else}3306{/if}"
                      min="1"
                      max="65535"
                    ></td>
                  <td
                    class="fielddesc"
                  >{='leave empty to use the default port for your chosen database type'|translate}</td>
                </tr>
                <tr>
                  <td class="fieldname"><label for="dbuser">{='User'|translate}</label></td>
                  <td><input
                      type="text"
                      name="dbuser"
                      id="dbuser"
                      value="{$fDbUser}"
                      required
                    ></td>
                  <td
                    class="fielddesc"
                  >{='user login given by your host provider'|translate}</td>
                </tr>
                <tr>
                  <td class="fieldname"><label for="dbpasswd">{='Password'|translate}</label></td>
                  <td><input
                      type="password"
                      name="dbpasswd"
                      id="dbpasswd"
                      value=""
                    ></td>
                  <td
                    class="fielddesc"
                  >{='user password given by your host provider'|translate}</td>
                </tr>
                <tr>
                  <td class="fieldname"><label for="dbname">{='Database name'|translate}</label></td>
                  <td><input
                      type="text"
                      name="dbname"
                      id="dbname"
                      value="{$fDbName}"
                      required
                    ></td>
                  <td
                    class="fielddesc"
                  >{='also given by your host provider'|translate}</td>
                </tr>
                <tr id="db-check-row" class="install-hidden-row">
                  <td></td>
                  <td colspan="2"><span id="db-check-status"></span></td>
                </tr>
                <tr
                  id="overwrite-confirm-row"
                  n:class="$hasExistingInstall === true ? null : 'install-hidden-row'"
                >
                  <td></td>
                  <td colspan="2" class="overwrite-warning">
                    <p>{='This database already contains a Piwigo installation. This will permanently delete all existing data in this database.'|translate}</p>
                    <label>
                      <input
                        type="checkbox"
                        name="confirm_overwrite"
                        id="confirm_overwrite"
                        n:attr="checked: $hasExistingInstall === true ? 'checked' : null"
                      >
                      {='I understand, overwrite the existing installation'|translate}
                    </label>
                    <input type="hidden" name="overwrite_token" id="overwrite_token" value="{$overwriteToken}">
                  </td>
                </tr>
              </table>
            </fieldset>
            <fieldset>
              <legend>{='Admin configuration'|translate}</legend>

              <table class="table2">
                <tr>
                  <td
                    class="table2-label-col fieldname"
                  ><label for="admin_name">{='Username'|translate}</label></td>
                  <td>
                    <input
                      type="text"
                      name="admin_name"
                      id="admin_name"
                      value="{$fAdmin}"
                      required
                    >
                    <span id="admin_name-error" class="field-error"></span>
                  </td>
                  <td
                    class="fielddesc"
                  >{='It will be shown to the visitors. It is necessary for website administration'|translate}</td>
                </tr>
                <tr>
                  <td class="fieldname"><label for="admin_pass1">{='Password'|translate}</label></td>
                  <td><input
                      type="password"
                      name="admin_pass1"
                      id="admin_pass1"
                      value=""
                      required
                    ></td>
                  <td
                    class="fielddesc"
                  >{='Keep it confidential, it enables you to access administration panel'|translate}</td>
                </tr>
                <tr>
                  <td class="fieldname"><label for="admin_pass2">{='Password [confirm]'|translate}</label></td>
                  <td>
                    <input
                      type="password"
                      name="admin_pass2"
                      id="admin_pass2"
                      value=""
                      required
                    >
                    <span id="admin_pass2-error" class="field-error"></span>
                  </td>
                  <td class="fielddesc">{='verification'|translate}</td>
                </tr>
                <tr>
                  <td class="fieldname"><label for="admin_mail">{='Email address'|translate}</label></td>
                  <td>
                    <input
                      type="text"
                      name="admin_mail"
                      id="admin_mail"
                      value="{$fAdminEmail}"
                      required
                    >
                    <span id="admin_mail-error" class="field-error"></span>
                  </td>
                  <td
                    class="fielddesc"
                  >{='Visitors will be able to contact site administrator with this mail'|translate}</td>
                </tr>
                <tr>
                  <td>{='Options'|translate}</td>
                    <td colspan="2">
                      <label>
                        <input
                          type="checkbox"
                          name="newsletter_subscribe"
                          {if $fNewsletterSubscribe}
                          checked="checked"
                          {/if}
                        >
                        <span
                          class="cluetip"
                          title="{='Piwigo Announcements Newsletter'|translate}|{_ 'Keep in touch with Piwigo project, subscribe to Piwigo Announcement Newsletter. You will receive emails when a new release is available (sometimes including a security bug fix, it\'s important to know and upgrade) and when major events happen to the project. Only a few emails a year.'|htmlspecialchars|nl2br|noescape}"
                        >{='Subscribe %s to Piwigo Announcements Newsletter'|translate:$email|noescape}</span>
                      </label>
                      <br>
                      <label>
                        <input
                          type="checkbox"
                          name="send_credentials_by_mail"
                          n:attr="checked: $fSendCredentialsByMail ? 'checked' : null"
                        >
                        {='Send my connection settings by email'|translate}
                      </label>
                    </td>
                  </tr>
              </table>
            </fieldset>

            <div class="install-submit-row">
              <input
                class="submit"
                type="submit"
                name="install"
                value="{='Start Install'|translate}"
              >
            </div>
          </form>
        {else}
          <p>
            <a
              class="bigButton"
              href="index.php"
            >{='Visit Gallery'|translate}</a>
          </p>
        {/if}
      </div> {* content *}
      <div class="install-help-row">{$lInstallHelp|noescape}</div>
    </div> {* the_page *}

    {=getPageDataScript()}

    {=getCombinedScripts('footer')}
  </body>
</html>
