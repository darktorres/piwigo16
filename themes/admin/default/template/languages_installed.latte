{templateType Piwigo\Admin\Projection\LanguagesInstalledView}
{do combineScript(id: 'common', load: 'footer', path: 'themes/admin/default/js/common.js')}
{do combineScript(id: 'jquery.confirm', load: 'footer', require: 'jquery', path: 'themes/default/js/plugins/jquery-confirm.min.js')}
{do combineCss(path: "themes/default/js/plugins/jquery-confirm.min.css")}
{do exposeString('Are you sure you want to delete the language "%s"?')}
{do exposeString('Yes, I am sure')}
{do exposeString('No, I have changed my mind')}
{do combineScript(id: 'languages_installed', load: 'footer', require: 'common,jquery.confirm,page-data', path: 'themes/admin/default/js/languages_installed.js')}

<fieldset n:foreach="['active', 'inactive'] as $language_state">
  <legend>
    {if $language_state == 'active'}
      {='Active Languages'|translate}
    {elseif $language_state == 'inactive'}
      {='Inactive Languages'|translate}
    {/if}
  </legend>
  <div class="languageBoxes">
    {foreach $languages as $language}
      {if $language['state'] == $language_state}
        <div
          class="languageBox{if $language['is_default']} languageDefault{/if}"
        >
          <div class="languageName">{$language['name']}<em
              n:if="$language['is_default']"
            >({='default'|translate})</em></div>
          {if $isWebmaster == 1}
            <div class="languageActions">
              <div>
                {if $language_state == 'active'}
                  {if $language['deactivable']}
                    <a
                      href="{$language['u_action']|noescape}&amp;action=deactivate"
                      class="tiptip"
                      title="{='Forbid this language to users'|translate}"
                    >{='Deactivate'|translate}</a>
                  {else}
                    <span
                      title="{$language['deactivate_tooltip']}"
                    >{='Deactivate'|translate}</span>
                  {/if}

                  {if !$language['is_default']}
                    | <a
                      href="{$language['u_action']|noescape}&amp;action=set_default"
                      class="tiptip"
                      title="{='Set as default language for unregistered and new users'|translate}"
                    >{='Default'|translate}</a>
                  {/if}
                {/if}

                {if $language_state == 'inactive'}
                  <a
                    href="{$language['u_action']|noescape}&amp;action=activate"
                    class="tiptip"
                    title="{='Make this language available to users'|translate}"
                  >{='Activate'|translate}</a>
                  {if $enableExtensionsInstall}
                    | <a
                      href="{$language['u_action']|noescape}&amp;action=delete"
                      class="tiptip delete-lang-button"
                      title="{='Delete this language'|translate}"
                    >{='Delete'|translate}</a>
                  {/if}
                {/if}
              </div>
            </div> <!-- languageActions -->
          {/if}
        </div> <!-- languageBox -->
      {/if}
    {/foreach}
  </div> <!-- languageBoxes -->
</fieldset>
