{templateType Piwigo\Admin\Projection\MenubarView}
<form id="menuOrdering" action="{$formAction|noescape}" method="post">
  <ul class="menuUl">
    <li
      n:foreach="$blocks as $block"
      class="menuLi {if $block['pos'] < 0}menuLi_hidden{/if}"
      id="menu_{$block['reg']->getId()}"
    >
      <p>
        <span>
          <label class="font-checkbox"><strong>{='Hide'|translate}</strong><i
              class="icon-check"
            ></i><input
              type="checkbox"
              name="hide_{$block['reg']->getId()}"
              {if $block['pos'] < 0}
              checked="checked"
              {/if}
            ></label>
        </span>

        <img
          src="{$themeconf['admin_icon_dir']}/cat_move.png"
          class="drag_button u-hidden"
          alt="{='Drag to re-order'|translate}"
          title="{='Drag to re-order'|translate}"
        >
        <strong>{$block['reg']->getName()|translate}</strong> ({$block['reg']->getId()})
      </p>

      <p n:if="$block['reg']->getOwner() != 'piwigo'" class="menuAuthor">
        {='Author'|translate}: <i>{$block['reg']->getOwner()}</i>
      </p>

      <p class="menuPos">
        <label>
          {='Position'|translate} :
          <input
            type="text"
            size="4"
            name="pos_{$block['reg']->getId()}"
            maxlength="4"
            value="{=math('abs(pos)', pos: $block['pos'])}"
          >
        </label>
      </p>
    </li>
  </ul>
  <div class="savebar-footer">
    <div class="savebar-footer-start"></div>
    <div class="savebar-footer-end">
      <div n:if="isset($saveSuccess)" class="savebar-footer-block">
        <div class="badge info-message">
          <i class="icon-ok"></i>{$saveSuccess}
        </div>
      </div>
      <div class="savebar-footer-block">
        <button
          class="buttonLike"
          type="submit"
          name="submit"
          {if $isWebmaster != 1}
          disabled
          {/if}
        ><i class="icon-floppy"></i> {='Save Settings'|translate}</button>
      </div>
    </div>
  </div>
</form>
