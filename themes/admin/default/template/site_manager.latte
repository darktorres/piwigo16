{capture $tmpFooterScript}
jQuery(document).ready(function(){
  jQuery("#showCreateSite a").click(function(){
    jQuery("#showCreateSite").hide();
    jQuery("#createSite").show();
  });
});
{/capture}
{do footerScript($tmpFooterScript)}
{do combineScript(id: 'common', load: 'footer', path: 'themes/admin/default/js/common.js')}
{do combineScript(id: 'jquery.confirm', load: 'footer', require: 'jquery', path: 'themes/default/js/plugins/jquery-confirm.min.js')}
{do combineCss(path: "themes/default/js/plugins/jquery-confirm.min.css")}
{capture $tmpFooterScript2}
const title_msg = '{='Are you sure you want to delete this site?'|translate|escapeJavascript|noescape}';
const confirm_msg = '{='Yes, I am sure'|translate|noescape}';
const cancel_msg = "{='No, I have changed my mind'|translate|noescape}";
$(".delete-site-button").each(function() {
  $(this).pwg_jconfirm_follow_href({
    alert_title: title_msg,
    alert_confirm: confirm_msg,
    alert_cancel: cancel_msg
  });
});
{/capture}
{do footerScript($tmpFooterScript2)}

{if !empty($remote_output)}
  <div class="remoteOutput">
    <ul>
      {foreach $remote_output as $remote_line}
        <li class="{$remote_line['CLASS']}">{$remote_line['CONTENT']}</li>
      {/foreach}
    </ul>
  </div>
{/if}

{if !empty($sites)}
  <table class="table2">
    <tr class="throw">
      <td>{='Directory'|translate}</td>
      <td>{='Actions'|translate}</td>
    </tr>
    {foreach $sites as $site}
      <tr
        style="text-align:left"
        class="{if $iterator->counter0 % 2 !== 0}row1{else}row2{/if}"
      ><td>
          <a
            href="{$site['NAME']}"
          >{$site['NAME']}</a><br>({$site['TYPE']}, {$site['CATEGORIES']} {='Albums'|translate}, {$site['IMAGES']|translate_dec:'%d photo','%d photos'})
        </td><td>
          [<a
            href="{$site['U_SYNCHRONIZE']|noescape}"
            title="{='update the database from files'|translate}"
          >{='Synchronize'|translate}</a>]
          {if isset($site['U_DELETE'])}
            [<a
              class="delete-site-button"
              href="{$site['U_DELETE']|noescape}"
              title="{='delete this site and all its attached elements'|translate}"
            >{='delete'|translate}</a>]
          {/if}
          {if !empty($site['plugin_links'])}
            <br>
            {foreach $site['plugin_links'] as $plugin_link}
              [<a
                href="{$plugin_link['U_HREF']}"
                title='{$plugin_link['U_HINT']}'
              >{$plugin_link['U_CAPTION']}</a>]
            {/foreach}
          {/if}
        </td></tr>
    {/foreach}
  </table>
{/if}

<p id="showCreateSite" style="text-align:left;margin-left:1em;">
  <a href="#">{='create a new site'|translate}</a>
</p>

<form
  action="{$F_ACTION|noescape}"
  method="post"
  id="createSite"
  style="display:none"
>
  <input type="hidden" name="pwg_token" value="{$CSRF_TOKEN}">
  <fieldset>
    <legend>{='create a new site'|translate}</legend>

    <p style="margin-top:0;"><strong>{='Directory'|translate}</strong>
      <br><input type="text" name="galleries_url" id="galleries_url">
    </p>

    <p class="actionButtons">
      <input
        class="submit"
        type="submit"
        name="submit"
        value="{='Submit'|translate}"
      >
    </p>
  </form>
