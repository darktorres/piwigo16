{templateType Piwigo\Admin\Projection\ThemesInstalledView}

<div id="themesContent">
  {var $field_name = 'null'} {* <!-- 'counter' for fieldset management --> *}
  {foreach $tplThemes as $theme}
    {if $field_name != $theme->state}
      {if $field_name != 'null'}
        {* Closes the PREVIOUS group's <div class="themeBoxes">/<fieldset>
           (opened further down, once per group, at the loop's real,
           lexically-single opening point) -- printed as raw text, not
           real tracked HTML tags, because Latte's HTML-aware parser
           verifies element nesting statically against the source order,
           and this closing pair appears here, textually before their
           own (lexically single) opening tags later in this same file,
           even though at runtime they always pair up correctly across
           loop iterations. *}
        {="</div>\n        </fieldset>"|noescape}
      {/if}

      {* <fieldset>/<div class="themeBoxes"> below, closing this same
         way at the very end of the file (also raw text, same
         reasoning) -- both stay conceptually open past this block's own
         {/if}, spanning every remaining theme in this group, which
         Latte's HTML-aware parser can't verify statically either. *}
      {="<fieldset>"|noescape}
      <legend>
        {if $theme->state == 'active'}
          <span
            class="icon-purple icon-toggle-on"
          ></span>{='Active Themes'|translate}
        {else}
          <span
            class="icon-yellow icon-toggle-off"
          ></span>{='Inactive Themes'|translate}
        {/if}
      </legend>
      {="<div class=\"themeBoxes\">"|noescape}
      {var $field_name = $theme->state}
    {/if}

    {* Reset per iteration: {var} is a plain PHP variable, so a theme with
       no author would otherwise render the previous theme's. *}
    {var $author = null}
    {if $theme->author !== ''}
      {if $theme->authorUrl !== null}
        {var $author = ("<a href='%s'>%s</a>"|sprintf:$theme->authorUrl,$theme->author)}
      {else}
        {var $author = ('<u>' . $theme->author . '</u>')}
      {/if}
    {/if}
    {if $theme->visitUrl !== ''}
      {var $version = ("<a class='externalLink' href='" . $theme->visitUrl . "'>" . $theme->version . "</a>")}
    {else}
      {var $version = $theme->version}
    {/if}

    <div class="themeBox{if $theme->isDefault} themeDefault{/if}">
      <div class="themeShot"><a
          href="{$theme->screenshot|noescape}"
          class="preview-box"
          title="{$theme->name}"
        ><img src="{$theme->screenshot|noescape}" alt=""></a></div>
      <div class="themeName" title="{$theme->name}">
        {$theme->name} <i
          n:if="$theme->isDefault"
          class="icon-star"
          title="{='default'|translate}"
        ></i> <i
          n:if="$theme->isMobile"
          class="icon-mobile"
          title="{='Mobile'|translate}"
        ></i>
        <a n:if="$isWebmaster == 1" class="icon-ellipsis-v showInfo"></a>
      </div>
      <div class="showInfo-dropdown dropdown">
        <div class="showInfo-dropdown-header">
          {if $author !== null}
            {='By %s'|translate:$author|noescape} |
          {/if}
          {='Version'|translate} {$version|noescape}
        </div>
        <div class="showInfo-dropdown-content">
          {$theme->desc}
        </div>
        {if $theme->state != "active" and $enableExtensionsInstall}
          {if $theme->deletable}
            <a
              class="dropdown-option icon-trash delete-plugin-button delete-theme-button"
              href="{$deleteBaseUrl|noescape}{$theme->id}"
            >{='Delete'|translate}</a>
          {else}
            <span
              class="dropdown-option icon-trash delete-plugin-button"
              title="{$theme->deleteTooltip}"
            >{='Delete'|translate}</span>
          {/if}
        {/if}
        <a
          n:if="$theme->deactivable"
          href="{$deactivateBaseUrl|noescape}{$theme->id}"
          class="showInfo-dropdown-action tiptip icon-cancel-circled"
          title="{='Forbid this theme to users'|translate}"
        >{='Deactivate'|translate}</a>
      </div>
      {if $isWebmaster == 1}
        <div class="themeActions">
          {if $theme->state == 'active'}
            {if $theme->adminUri !== null}
              <a
                href="{$theme->adminUri|noescape}"
                class="icon-cog"
              >{='Configuration'|translate}</a>
            {else}
              <div
                class="pluginUnavailableAction icon-cog tiptip"
                title="{='N/A'|translate}"
              >{='Configuration'|translate}</div>
            {/if}
            {if !$theme->isDefault}
              <a
                href="{$setDefaultBaseUrl|noescape}{$theme->id}"
                class="tiptip icon-star"
                title="{='Set as default theme for unregistered and new users'|translate}"
              >{='Set as default'|translate}</a>
            {else}
              <span
                class="tiptip icon-star"
                title="{='This is already the default theme'|translate}"
              >{='Set as default'|translate}</span>
            {/if}
          {else}
            {if $theme->activable}
              <a
                href="{$activateBaseUrl|noescape}{$theme->id}"
                title="{='Make this theme available to users'|translate}"
                class="icon-plus tiptip"
              >{='Activate'|translate}</a>
            {else}
              <span
                title="{$theme->activableTooltip}"
                class="icon-plus tiptip"
              >{='Activate'|translate}</span>
            {/if}
          {/if}
        </div> <!-- themeActions -->
      {/if}
    </div>
  {/foreach}
  {="</div> <!-- themeBoxes -->\n</fieldset>"|noescape}
</div> <!-- themesContent -->
