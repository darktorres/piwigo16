{templateType Piwigo\Picture\Projection\CommentListView}
{if isset($commentDerivativeParams)}
  <div class="loader"><img
      src="{$ROOT_URL}{$themeconf['img_dir']}/ajax_loader.gif"
    ></div>
{/if}
<ul
  class="commentsList"
  style="{if isset($commentDerivativeParams)}--comment-illustration-width: {$commentDerivativeParams->maxWidth() + 5}px; --comment-description-min-height: {$commentDerivativeParams->maxHeight() + 5}px;{/if}"
>
  <li
    n:foreach="$comments as $comment"
    class="commentElement {if $iterator->counter0 % 2 !== 0}odd{else}even{/if}"
  >
    {* The two are non-null together or not at all: $commentDerivativeParams
       is null only for PictureCommentRenderer, whose rows never carry a
       srcImage. The {else} arm this replaces reached for a
       $derivative_params that nothing has assigned since CategoryDefaultResult
       started returning its own. *}
    {if $comment->srcImage !== null and $commentDerivativeParams !== null}
      {var $derivative = $pwg->derivative($commentDerivativeParams, $comment->srcImage)}
      <div class="illustration">
        <a href="{$comment->pictureUrl}">
          <img
            {if $derivative->isCached()}
            src="{$derivative->getUrl()}"
            {else}
            src="{$ROOT_URL}{$themeconf['icon_dir']}/img_small.png"
            data-src="{$derivative->getUrl()}"
            {/if}
            alt="{$comment->alt}"
          >
        </a>
      </div>
    {/if}
    <div class="description">
      <div
        n:if="$comment->deleteUrl !== null or $comment->validateUrl !== null or $comment->editUrl !== null"
        class="actions"
      >
        {if $comment->deleteUrl !== null}
          <a href="{$comment->deleteUrl}" data-confirm>
            {='Delete'|translate}
          </a>{if $comment->validateUrl !== null or $comment->editUrl !== null or $comment->cancelUrl !== null} | {/if}
        {/if}
        {if $comment->cancelUrl !== null}
          <a href="{$comment->cancelUrl}">
            {='Cancel'|translate}
          </a>{if $comment->validateUrl !== null} | {/if}
        {/if}
        {if $comment->editUrl !== null and !$comment->inEdit}
          <a
            class="editComment"
            href="{$comment->editUrl}#edit_comment"
          >
            {='Edit'|translate}
          </a>{if $comment->validateUrl !== null} | {/if}
        {/if}
        <a
          n:if="$comment->validateUrl !== null"
          href="{$comment->validateUrl}"
        >
          {='Validate'|translate}
        </a>&nbsp;
      </div>

      <span class="commentAuthor">{if $comment->websiteUrl !== null}<a
            href="{$comment->websiteUrl}"
            class="external"
            target="_blank"
            rel="nofollow"
          >{$comment->author}</a>{else}{$comment->author}{/if}</span>
      {if $comment->email !== null}- <a
          href="mailto:{$comment->email}"
        >{$comment->email}</a>{/if}
      - <span class="commentDate">{$comment->date}</span>
      {if $comment->inEdit}
        <a name="edit_comment"></a>
        <form
          method="post"
          action="{$comment->editUrl}"
          id="editComment"
        >
          <p><label
              for="contenteditid"
            >{='Edit a comment'|translate} :</label></p>
          <p><textarea
              name="content"
              id="contenteditid"
              rows="5"
              cols="80"
            >{$comment->rawContent}</textarea></p>
          <p><label for="website_url">{='Website'|translate} :</label></p>
          <p><input
              type="text"
              name="website_url"
              id="website_url"
              value="{$comment->websiteUrl}"
              size="40"
            ></p>
          <p><input type="hidden" name="key" value="{$comment->key}">
            <input type="hidden" name="pwg_token" value="{$comment->csrfToken}">
            <input type="hidden" name="image_id" value="{$comment->imageId}">
            <input type="submit" value="{='Submit'|translate}">
          </p>
        </form>
      {else}
        <blockquote><div>{$comment->content}</div></blockquote>
      {/if}
    </div>
  </li>
</ul>
