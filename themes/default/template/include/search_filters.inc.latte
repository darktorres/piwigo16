fullname_of_cat = {$fullname_of|noescape};
{/if}

{if isset($SEARCH_ID)}
search_id = '{$SEARCH_ID|noescape}';
{/if}

{if is_admin('')}
user_rank = "admin";
{elseif is_classic_user('')}
user_rank = "user";
{else}
user_rank = "none";
{/if}

str_word_widget_label = {=json_encode(translate('Search for words'), \JSON_UNESCAPED_UNICODE)|noescape};
str_tags_widget_label = {=json_encode(translate('Tag'), \JSON_UNESCAPED_UNICODE)|noescape};
