{do combineCss(path: "themes/admin/default/fontello/css/animation.css", order: 10)} {* order 10 is required, see issue 1080 *}
{do combineScript(id: 'jquery.tipTip', load: 'header', path: 'themes/default/js/plugins/jquery.tipTip.minified.js')}
{do combineCss(path: "themes/default/css/search.css", order: -100)}
{do combineCss(path: "themes/default/css/" . $themeconf['colorscheme'] . "-search.css", order: -100)}
{do combineCss(path: "themes/default/vendor/fontello/css/gallery-icon.css", order: -10)}

