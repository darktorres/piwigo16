{templateType Piwigo\Controller\Projection\SelectedTagsView}
{do combineCss(id: 'selected_tags', path: 'themes/default/css/components/selected_tags.css')}
<span id="selected-tags-container">
  <span
    n:foreach="$selectRelatedTags as $TAG"
    class="selected-related-tag {if 1 == count($selectRelatedTags)}unique-tag{/if}"
  >
    <a
      href="{$TAG['index_url']|noescape}"
      title="{='display photos linked to this tag'|translate}"
    >
      {$TAG['tag_name']}
    </a>
    <a
      n:if="count($selectRelatedTags) > 1"
      class="selected-related-tag-remove"
      href="{$TAG['remove_url']|noescape}"
      title="{='remove this tag from the list'|translate}"
    >
      <i class="gallery-icon-cancel fas fa-plus"></i>
    </a>
  </span>
</span>
