{do combineScript(id: 'core.switchbox', load: 'async', require: 'jquery', path: 'themes/default/js/switchbox.js')}
{do combineCss(path: "themes/default/vendor/fontello/css/gallery-icon.css", order: -10)}

{$MENUBAR|noescape}

{if isset($errors) or isset($infos)}
<div class="content messages{if isset($MENUBAR)} contentWithMenu{/if}">
{include 'infos_errors.latte'}
</div>
{/if}

{if !empty($PLUGIN_INDEX_CONTENT_BEFORE)}{$PLUGIN_INDEX_CONTENT_BEFORE|noescape}{/if}
<div id="content" class="content{if isset($MENUBAR)} contentWithMenu{/if}">
<div class="titrePage{if isset($chronology['TITLE'])} calendarTitleBar{/if}">
	<ul class="categoryActions">
{if isset($SEARCH_IN_SET_ACTION) and $SEARCH_IN_SET_ACTION}
    <li id="cmdSearchInSet"><a href="{$SEARCH_IN_SET_URL|noescape}" title="{='Search in this set'|translate}" class="pwg-state-default pwg-button" rel="nofollow">
      <span class="gallery-icon-search-folder"></span><span class="pwg-button-text">{='Search in this set'|translate}</span>
    </a></li>
{/if}

{* We want the related tags action icon on all pages except the index and tag pages*}
{if isset($RELATED_TAGS_ACTION) and $RELATED_TAGS_ACTION}
    <li>{spaceless}<a id="cmdRelatedTags" title="{='Related tags'|translate}" class="pwg-state-default pwg-button" rel="nofollow">
			<span class="pwg-icon gallery-icon-tag"></span><span class="pwg-button-text">{='Related tags'|translate}</span>
		</a>
		<div id="relatedTagsBox" class="switchBox">
			<div class="switchBoxTitle">{='Related tags'|translate}</div>
	{foreach $RELATED_TAGS as $tag}
			<a href=
				"{$tag['URL']|noescape}" title="{='display photos linked to this tag'|translate}">
				{$tag['name']}
      </a>
	{/foreach}
		</div>
		{capture $tmpFooterScript1}(window.SwitchBox=window.SwitchBox||[]).push("#cmdRelatedTags", "#relatedTagsBox");{/capture}
		{do footerScript($tmpFooterScript1)}
		{/spaceless}</li>
{/if}

{if !empty($image_orders)}
		<li>{spaceless}<a id="sortOrderLink" title="{='Sort order'|translate}" class="pwg-state-default pwg-button" rel="nofollow">
			<span class="pwg-icon pwg-icon-sort"></span><span class="pwg-button-text">{='Sort order'|translate}</span>
		</a>
		<div id="sortOrderBox" class="switchBox">
			<div class="switchBoxTitle">{='Sort order'|translate}</div>
			{foreach $image_orders as $image_order}{if !$iterator->first}<br>{/if}
			{if $image_order['SELECTED']}
			<span>&#x2714; </span>{$image_order['DISPLAY']|noescape}
			{else}
			<span style="visibility:hidden">&#x2714; </span><a href="{$image_order['URL']|noescape}" rel="nofollow">{$image_order['DISPLAY']|noescape}</a>
			{/if}
			{/foreach}
		</div>
		{capture $tmpFooterScript2}(window.SwitchBox=window.SwitchBox||[]).push("#sortOrderLink", "#sortOrderBox");{/capture}
		{do footerScript($tmpFooterScript2)}
		{/spaceless}</li>
{/if}
{if !empty($image_derivatives)}
		<li>{spaceless}<a id="derivativeSwitchLink" title="{='Photo sizes'|translate}" class="pwg-state-default pwg-button" rel="nofollow">
			<span class="pwg-icon pwg-icon-sizes"></span><span class="pwg-button-text">{='Photo sizes'|translate}</span>
		</a>
		<div id="derivativeSwitchBox" class="switchBox">
			<div class="switchBoxTitle">{='Photo sizes'|translate}</div>
			{foreach $image_derivatives as $image_derivative}{if !$iterator->first}<br>{/if}
			{if $image_derivative['SELECTED']}
			<span>&#x2714; </span>{$image_derivative['DISPLAY']}
			{else}
			<span style="visibility:hidden">&#x2714; </span><a href="{$image_derivative['URL']|noescape}" rel="nofollow">{$image_derivative['DISPLAY']}</a>
			{/if}
			{/foreach}
		</div>
		{capture $tmpFooterScript3}(window.SwitchBox=window.SwitchBox||[]).push("#derivativeSwitchLink", "#derivativeSwitchBox");{/capture}
		{do footerScript($tmpFooterScript3)}
		{/spaceless}</li>
{/if}

{if isset($favorite)}
		<li id="cmdFavorite"><a href="{$favorite['U_FAVORITE']|noescape}" title="{='delete all photos from your favorites'|translate}" class="pwg-state-default pwg-button" rel="nofollow">
			<span class="pwg-icon pwg-icon-favorite-del"></span><span class="pwg-button-text">{='delete all photos from your favorites'|translate}</span>
		</a></li>
{/if}
{if isset($U_CADDIE)}
		<li id="cmdCaddie"><a href="{$U_CADDIE|noescape}" title="{='Add to caddie'|translate}" class="pwg-state-default pwg-button">
			<span class="pwg-icon pwg-icon-caddie-add"></span><span class="pwg-button-text">{='Caddie'|translate}</span>
		</a></li>
{/if}
{if isset($U_EDIT)}
		<li id="cmdEditAlbum"><a href="{$U_EDIT|noescape}" title="{='Edit album'|translate}" class="pwg-state-default pwg-button">
			<span class="pwg-icon pwg-icon-category-edit"></span><span class="pwg-button-text">{='Edit'|translate}</span>
		</a></li>
{/if}
{if isset($U_SLIDESHOW)}
		<li id="cmdSlideshow">{spaceless}<a href="{$U_SLIDESHOW|noescape}" title="{='slideshow'|translate}" class="pwg-state-default pwg-button" rel="nofollow">
			<span class="pwg-icon pwg-icon-slideshow"></span><span class="pwg-button-text">{='slideshow'|translate}</span>
		</a>{/spaceless}</li>
{/if}
{if isset($U_MODE_FLAT)}
		<li>{spaceless}<a href="{$U_MODE_FLAT|noescape}" title="{='display all photos in all sub-albums'|translate}" class="pwg-state-default pwg-button" rel="nofollow">
			<span class="pwg-icon pwg-icon-category-view-flat"></span><span class="pwg-button-text">{='display all photos in all sub-albums'|translate}</span>
		</a>{/spaceless}</li>
{/if}
{if isset($U_MODE_NORMAL)}
		<li>{spaceless}<a href="{$U_MODE_NORMAL|noescape}" title="{='return to normal view mode'|translate}" class="pwg-state-default pwg-button">
			<span class="pwg-icon pwg-icon-category-view-normal"></span><span class="pwg-button-text">{='return to normal view mode'|translate}</span>
		</a>{/spaceless}</li>
{/if}
{if isset($U_MODE_POSTED)}
		<li>{spaceless}<a href="{$U_MODE_POSTED|noescape}" title="{='display a calendar by posted date'|translate}" class="pwg-state-default pwg-button" rel="nofollow">
			<span class="pwg-icon pwg-icon-calendar"></span><span class="pwg-button-text">{='Calendar'|translate}</span>
		</a>{/spaceless}</li>
{/if}
{if isset($U_MODE_CREATED)}
		<li>{spaceless}<a href="{$U_MODE_CREATED|noescape}" title="{='display a calendar by creation date'|translate}" class="pwg-state-default pwg-button" rel="nofollow">
			<span class="pwg-icon pwg-icon-camera-calendar"></span><span class="pwg-button-text">{='Calendar'|translate}</span>
		</a>{/spaceless}</li>
{/if}
{if !empty($PLUGIN_INDEX_BUTTONS)}{foreach $PLUGIN_INDEX_BUTTONS as $button}<li>{$button|noescape}</li>{/foreach}{/if}
{if !empty($PLUGIN_INDEX_ACTIONS)}{$PLUGIN_INDEX_ACTIONS|noescape}{/if}
	</ul>

<div id="breadcrumb">
  <h2>{$TITLE|noescape}
    {if $NB_ITEMS > 0}<span class="badge nb_items">{$NB_ITEMS}</span>{/if}
  </h2>

{$SELECTED_TAGS_TEMPLATE|noescape}
</div>

{if isset($chronology_views)}
<div class="calendarViews">{='View'|translate}:
	<a id="calendarViewSwitchLink" href="#">
	{foreach $chronology_views as $view}{if $view['SELECTED']}{$view['CONTENT']}{/if}{/foreach}
	</a>
	<div id="calendarViewSwitchBox" class="switchBox">
		{foreach $chronology_views as $view}{if !$iterator->first}<br>{/if}
		<span{if !$view['SELECTED']} style="visibility:hidden"{/if}>&#x2714; </span><a href="{$view['VALUE']|noescape}">{$view['CONTENT']}</a>
		{/foreach}
	</div>
	{capture $tmpFooterScript4}(window.SwitchBox=window.SwitchBox||[]).push("#calendarViewSwitchLink", "#calendarViewSwitchBox");{/capture}
	{do footerScript($tmpFooterScript4)}
</div>
{/if}

{if isset($chronology['TITLE'])}
<h2 class="calendarTitle">{$chronology['TITLE']|noescape}</h2>
{/if}

</div>{* <!-- titrePage --> *}

{if !empty($PLUGIN_INDEX_CONTENT_BEGIN)}{$PLUGIN_INDEX_CONTENT_BEGIN|noescape}{/if}

{if !empty($no_search_results)}
<p class="search_results">{='No results for'|translate} :
	<em><strong>
	{foreach $no_search_results as $res}
	{if !$iterator->first} &mdash; {/if}
	{$res|noescape}
	{/foreach}
	</strong></em>
</p>
{/if}

{if !empty($category_search_results)}
<p class="search_results">{='Album results for'|translate} <strong>{$QUERY_SEARCH|noescape}</strong> :
	<em><strong>
	{foreach $category_search_results as $res}
	{if !$iterator->first} &mdash; {/if}
	{$res|noescape}
	{/foreach}
	</strong></em>
</p>
{/if}

{if !empty($tag_search_results)}
<p class="search_results">{='Tag results for'|translate} <strong>{$QUERY_SEARCH|noescape}</strong> :
	<em><strong>
	{foreach $tag_search_results as $tag}
	{if !$iterator->first} &mdash; {/if} <a href="{$tag['URL']|noescape}">{$tag['name']}</a>
	{/foreach}
	</strong></em>
</p>
{/if}

{if isset($FILE_CHRONOLOGY_VIEW)}
{include $FILE_CHRONOLOGY_VIEW}
{/if}

<div class="action-buttons">

{if isset($SEARCH_IN_SET_BUTTON) and $SEARCH_IN_SET_BUTTON}
  <div class="mcs-side-results search-in-set-button">
    <div>
      <p><a href="{$SEARCH_IN_SET_URL|noescape}" class="gallery-icon-search-folder" rel="nofollow">{='Search in this set'|translate}</a></p>
    </div>
  </div>
{/if}

{if isset($COMBINABLE_TAGS)}
{include 'include/related_tags.inc.latte'}
{/if}
</div>

{if !empty($CONTENT_DESCRIPTION)}
<div class="additional_info">
	{$CONTENT_DESCRIPTION|noescape}
</div>
{/if}

{if !empty($CONTENT)}{$CONTENT|noescape}{/if}

{if !empty($CATEGORIES)}{$CATEGORIES|noescape}{/if}

{if !empty($cats_navbar)}
	{include getExtent('navigation_bar.latte', 'navbar'), navbar: $cats_navbar}
{/if}

{if !empty($SEARCH_ID)}
  {include 'include/search_filters.inc.latte'}
{/if}

{if !empty($THUMBNAILS)}
<div class="loader"><img src="{$ROOT_URL}{$themeconf['img_dir']}/ajax_loader.gif"></div>

<ul class="thumbnails" id="thumbnails">
  {$THUMBNAILS|noescape}
</ul>

{elseif !empty($SEARCH_ID)}
<div class="mcs-no-result">
  <div class="text">
    <span class="top">{='No results are available.'|translate}</span>
    <span class="bot">{='You can try to edit your filters and perform a new search.'|translate}</span>
  </div>
</div>
{/if}
{if !empty($thumb_navbar)}
	{include getExtent('navigation_bar.latte', 'navbar'), navbar: $thumb_navbar}
{/if}

{if !empty($PLUGIN_INDEX_CONTENT_END)}{$PLUGIN_INDEX_CONTENT_END|noescape}{/if}
</div>{* <!-- content --> *}
{if !empty($PLUGIN_INDEX_CONTENT_AFTER)}{$PLUGIN_INDEX_CONTENT_AFTER|noescape}{/if}
