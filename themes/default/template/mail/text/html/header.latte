<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html lang="{$lang_info['code'] ?? ''}" dir="{$lang_info['direction'] ?? ''}">
  <head>
    <meta
      http-equiv="Content-Type"
      content="text/html; charset={$CONTENT_ENCODING}"
    />
    <title>Piwigo Mail</title>

    <style
      type="text/css"
    >
    {if isset($GLOBAL_MAIL_CSS)}{$GLOBAL_MAIL_CSS|noescape}{/if}
    {if isset($MAIL_CSS)}{$MAIL_CSS|noescape}{/if}
    </style>
  </head>

  <body>
    <table id="bodyTable" cellspacing="0" cellpadding="10" border="0">
      <tr><td align="center" valign="top">
          <table id="contentTable" cellspacing="0" cellpadding="0" border="0">
            <tr><td id="header">
                {* <!-- begin HEADER --> *}
                <div id="title">{$MAIL_TITLE}</div>
                <div
                  n:if="!empty($MAIL_SUBTITLE)"
                  id="subtitle"
                >{$MAIL_SUBTITLE}</div>
                {* <!-- end HEADER --> *}
              </td></tr>

            <tr><td id="content">
                {* <!-- use an invisible div with a bottom margin to force the browser
to merge the margin with the element bellow (typically h1/h2/...) --> *}
                <div id="topSpacer"></div>
                {* <!-- begin CONTENT --> *}
                {*
              One of cat_group_info.latte / notification_by_mail.latte /
              notification_admin.latte is appended here next, followed by
              footer.latte -- all three rendered independently by real
              Latte and joined by raw PHP string concatenation in
              MailService.php (parse('header.latte', true) .=
              parse($contentTemplate, true) .= parse('footer.latte', true)),
              not {include}. footer.latte closes </td></tr> (the <tr><td
              id="content"> opened above), plus everything else down to
              </body></html>.
            *}
