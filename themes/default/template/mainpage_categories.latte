{templateType Piwigo\Controller\Projection\CategoryCatsView}
{do combineCss(id: 'mainpage_categories', path: 'themes/default/css/pages/mainpage_categories.css')}
{do exposeData('error_icon', $ROOT_URL . $themeconf['icon_dir'] . '/errors_small.png')}
{do exposeData('max_requests', $maxRequests)}
<div class="loader"><img
    src="{$ROOT_URL}{$themeconf['img_dir']}/ajax_loader.gif"
  ></div>
<ul
  class="thumbnailCategories"
  style="--cat-illustration-width: {$derivativeParams->maxWidth() + 5}px; --cat-description-height: {$derivativeParams->maxHeight() + 5}px;"
>
  {foreach $categoryThumbnails as $cat}
    {if $cat['representative']}
      {var $derivative = $pwg->derivative($derivativeParams, $cat['representative']['src_image'])}
      {if !$derivative->isCached()}
        {do combineScript(id: 'jquery.ajaxmanager', path: 'themes/default/js/plugins/jquery.ajaxmanager.js', load: 'footer')}
        {do combineScript(id: 'thumbnails.loader', path: 'themes/default/js/thumbnails.loader.js', require: 'jquery.ajaxmanager,page-data', load: 'footer')}
      {/if}
    {/if}
    <li class="{if $iterator->counter0 % 2 !== 0}odd{else}even{/if}">
      <div class="thumbnailCategory">
        <div class="illustration">
          <a href="{$cat['URL']|noescape}">
            <img
              {if !$cat['representative']}
              src="{$ROOT_URL}{$themeconf['icon_dir']}/img_small.png"
              {elseif $derivative->isCached()}
              src="{$derivative->getUrl()|noescape}"
              {else}
              src="{$ROOT_URL}{$themeconf['icon_dir']}/img_small.png"
              data-src="{$derivative->getUrl()|noescape}"
              {/if}
              alt="{$cat['TN_ALT']}"
              title="{$cat['NAME']|replace:'"',' '|strip_tags:false} - {='display this album'|translate}"
            >
          </a>
        </div>
        <div class="description">
          <h3>
            <a href="{$cat['URL']|noescape}">{$cat['NAME']}</a>
            <img
              n:if="!empty($cat['icon_ts'])"
              title="{$cat['icon_ts']['TITLE']}"
              src="{$ROOT_URL}{$themeconf['icon_dir']}/recent{if $cat['icon_ts']['IS_CHILD_DATE']}_by_child{/if}.png"
              alt="(!)"
            >
          </h3>
          <div class="text">
            <p
              n:if="isset($cat['INFO_DATES'])"
              class="dates"
            >{$cat['INFO_DATES']}</p>
            <p class="Nb_images">{$cat['CAPTION_NB_IMAGES']|noescape}</p>
            <p
              n:if="!empty($cat['DESCRIPTION'])"
            >{$cat['DESCRIPTION']|noescape}</p>
          </div>
        </div>
      </div>
    </li>
  {/foreach}
</ul>
