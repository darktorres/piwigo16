{templateType Piwigo\Controller\Projection\CategoryCatsView}
<div class="loader"><img
    src="{$ROOT_URL}{$themeconf['img_dir']}/ajax_loader.gif"
  ></div>
<ul
  class="thumbnailCategories"
  style="--cat-illustration-width: {$derivativeParams->maxWidth() + 5}px; --cat-description-height: {$derivativeParams->maxHeight() + 5}px;"
>
  {foreach $categoryThumbnails as $cat}
    {if $cat->representative !== null}
      {var $derivative = $pwg->derivative($derivativeParams, $cat->representative)}
    {/if}
    <li
      class="{if $iterator->counter0 % 2 !== 0}odd{else}even{/if}"
      data-category-id="{$cat->id}"
    >
      <div class="thumbnailCategory">
        <div class="illustration">
          <a href="{$cat->url|noescape}">
            <img
              {if $cat->representative === null}
              src="{$ROOT_URL}{$themeconf['icon_dir']}/img_small.png"
              {elseif $derivative->isCached()}
              src="{$derivative->getUrl()|noescape}"
              {else}
              src="{$ROOT_URL}{$themeconf['icon_dir']}/img_small.png"
              data-src="{$derivative->getUrl()|noescape}"
              {/if}
              alt="{$cat->tnAlt}"
              title="{$cat->name|replace:'"',' '|stripTags} - {='display this album'|translate}"
            >
          </a>
        </div>
        <div class="description">
          <h3>
            <a href="{$cat->url|noescape}">{$cat->name}</a>
            <img
              n:if="$cat->iconTs !== null"
              title="{$cat->iconTs->title}"
              src="{$ROOT_URL}{$themeconf['icon_dir']}/recent{if $cat->iconTs->isChildDate}_by_child{/if}.png"
              alt="(!)"
            >
          </h3>
          <div class="text">
            <p
              n:if="$cat->infoDates !== null"
              class="dates"
            >{$cat->infoDates}</p>
            <p class="Nb_images">{$cat->captionNbImages|noescape}</p>
            <p
              n:if="$cat->description !== null && $cat->description !== ''"
            >{$cat->description|noescape}</p>
          </div>
        </div>
      </div>
    </li>
  {/foreach}
</ul>
