{if !empty($blocks) }
<div id="menubar">
	{foreach $blocks as $id => $block}
	<dl id="{$id}">
		{if !empty($block->template)}
		{include getExtent($block->template, $id), block: $block, id: $id}
		{else}
		{$block->raw_content|noescape}
		{/if}
	</dl>
	{/foreach}
</div><div id="menuSwitcher"></div>
{/if}
