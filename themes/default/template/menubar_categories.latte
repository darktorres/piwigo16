{templateType Piwigo\Menu\Projection\MenubarBlockView}
<dt>
  <a
    n:if="isset($U_START_FILTER)"
    href="{$U_START_FILTER|noescape}"
    class="pwg-state-default pwg-button menubarFilter"
    title="{='display only recently posted photos'|translate}"
    rel="nofollow"
  ><span class="pwg-icon pwg-icon-filter"></span></a>
  <a
    n:if="isset($U_STOP_FILTER)"
    href="{$U_STOP_FILTER|noescape}"
    class="pwg-state-default pwg-button menubarFilter"
    title="{='return to the display of all photos'|translate}"
  ><span class="pwg-icon pwg-icon-filter-del"></span></a>
  <a href="{$block->data['U_CATEGORIES']|noescape}">{='Albums'|translate}</a>
</dt>
<dd>
  {*
    Builds a variable-depth <ul>/<li> tree across loop iterations --
    every <ul>/<li> open and close below is printed as raw text, not a
    real tracked HTML tag: the actual nesting depth (how many levels to
    open or close) is only known at runtime (str_repeat'd by
    $ref_level's own delta between iterations), which Latte's
    HTML-aware parser -- built for a fixed, statically-analyzable tag
    structure -- can't verify. Only the genuinely self-contained inner
    content per item (the <a>/<span>/<img> below) stays as real tracked
    HTML, since each of those opens and closes within one iteration.
  *}
  {var $ref_level = 0}
  {foreach $block->data['MENU_CATEGORIES'] as $cat}
    {if $cat['LEVEL'] > $ref_level}
      {="<ul>"|noescape}
    {else}
      {="</li>"|noescape}
      {='</ul></li>'|str_repeat:($ref_level - $cat['LEVEL'])|noescape}
    {/if}
    {="<li" . ($cat['SELECTED'] ? ' class="selected"' : '') . ">"|noescape}
    <a
      href="{$cat['URL']|noescape}"
      {if $cat['IS_UPPERCAT']}
      rel="up"
      {/if}
      title="{$cat['TITLE']}"
    >{$cat['NAME']}</a>
    <span
      n:if="$cat['count_images'] > 0"
      class="{if $cat['nb_images'] > 0}menuInfoCat{else}menuInfoCatByChild{/if} badge"
      title="{$cat['TITLE']}"
    >{$cat['count_images']}</span>
    <img
      n:if="$cat['icon_ts'] !== null"
      title="{$cat['icon_ts']->title}"
      src="{$ROOT_URL}{$themeconf['icon_dir']}/recent{if $cat['icon_ts']->isChildDate}_by_child{/if}.png"
      class="icon"
      alt="(!)"
    >
    {var $ref_level = $cat['LEVEL']}
  {/foreach}
  {='</li></ul>'|str_repeat:$ref_level|noescape}

  <p
    class="totalImages"
  >{=$block->data['NB_PICTURE']|translate_dec:'%d photo','%d photos'}</p>
</dd>
