<dt>{='Links'|translate}</dt>
<dd>
	<ul>{spaceless}
		{foreach $block->data as $link}
			<li>
				<a href="{$link['URL']}" class="external"{if isset($link['new_window'])} onclick="window.open(this.href, {=json_encode($link['new_window']['NAME'])}, {=json_encode($link['new_window']['FEATURES'])}); return false;"{/if}>
				{$link['LABEL']}
				</a>
			</li>
		{/foreach}
	{/spaceless}</ul>
</dd>
