{templateType Piwigo\Menu\Projection\MenubarBlockView}
<dt>{='Menu'|translate}</dt>
<dd>
  {if isset($block->data['qsearch']) and $block->data['qsearch'] == true}
    <form
      action="{$ROOT_URL}qsearch.php"
      method="get"
      id="quicksearch"
    >
      <p
        class="quicksearch-form-p"
        {*this <p> is for html validation only - does not affect positioning*}
      >
        <input
          type="text"
          name="q"
          id="qsearchInput"
          {if !empty($QUERY_SEARCH)}
          value="{$QUERY_SEARCH|noescape}"
          {/if}
        >
      </p>
    </form>
  {/if}
  <ul>{spaceless}
      {foreach $block->data as $link}
        <li n:if="is_array($link)"><a
            href="{$link['URL']|noescape}"
            {if isset($link['TITLE'])}
            title="{$link['TITLE']}"
            {/if}
            {if isset($link['REL'])}
            {$link['REL']|noescape}
            {/if}
          >{$link['NAME']}</a>{if isset($link['COUNTER'])} ({$link['COUNTER']}){/if}</li>
      {/foreach}
    {/spaceless}</ul>
</dd>
