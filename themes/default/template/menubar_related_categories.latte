{templateType Piwigo\Menu\Projection\MenubarBlockView}
<dt>
  {='Related albums'|translate}
</dt>
<dd>
  {*
    Builds a variable-depth <ul>/<li> tree across loop iterations --
    every <ul>/<li> open and close below is printed as raw text, not a
    real tracked HTML tag: the actual nesting depth (how many levels to
    open or close) is only known at runtime (str_repeat'd by
    $ref_level's own delta between iterations), which Latte's
    HTML-aware parser -- built for a fixed, statically-analyzable tag
    structure -- can't verify. Only the genuinely self-contained inner
    content per item (the <a>/<span> below) stays as real tracked HTML,
    since each of those opens and closes within one iteration.
  *}
  {var $ref_level = 0}
  {foreach $block->data['MENU_CATEGORIES'] as $cat}
    {if $cat['LEVEL'] > $ref_level}
      {="<ul>"|noescape}
    {else}
      {="</li>"|noescape}
      {='</ul></li>'|str_repeat:($ref_level - $cat['LEVEL'])|noescape}
    {/if}
    {="<li>"|noescape}
    {if isset($cat['TITLE'])}
      <a
        href="{if isset($cat['url'])}{$cat['url']|noescape}{/if}"
        title="{$cat['TITLE']}"
        rel="nofollow"
      >{$cat['name']}</a>
    {else}
      <a
        href="{if isset($cat['url'])}{$cat['url']|noescape}{/if}"
        rel="nofollow"
      >{$cat['name']}</a>
    {/if}
    <span
      n:if="isset($cat['count_images']) and $cat['count_images'] > 0"
      class="badge"
      title="{$cat['count_images']|translate_dec:'%d photo','%d photos'}"
    >{$cat['count_images']}</span>
    <span
      n:if="isset($cat['count_categories']) and $cat['count_categories'] > 0"
      class="badge badgeCategories"
      title="{='sub-albums'|translate}"
    >{$cat['count_categories']}</span>
    {var $ref_level = $cat['LEVEL']}
  {/foreach}
  {='</li></ul>'|str_repeat:$ref_level|noescape}
</dd>
