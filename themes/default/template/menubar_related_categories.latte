{templateType Piwigo\Menu\Projection\MenubarRelatedCategoriesView}
<dt>
  {='Related albums'|translate}
</dt>
<dd>
  {*
    Builds a variable-depth <ul>/<li> tree across loop iterations --
    every <ul>/<li> open and close below is printed as raw text, not a
    real tracked HTML tag: the actual nesting depth (how many levels to
    open or close) is only known at runtime (closeTags'd by
    $ref_level's own delta between iterations), which Latte's
    HTML-aware parser -- built for a fixed, statically-analyzable tag
    structure -- can't verify. Only the genuinely self-contained inner
    content per item (the <a>/<span> below) stays as real tracked HTML,
    since each of those opens and closes within one iteration.
  *}
  {var $ref_level = 0}
  {foreach $categories as $cat}
    {if $cat->level > $ref_level}
      {="<ul>"|noescape}
    {else}
      {="</li>"|noescape}
      {='</ul></li>'|closeTags:($ref_level - $cat->level)}
    {/if}
    {="<li>"|noescape}
    {* No url means this row is only here to carry the tree's shape: an
       ancestor holding none of the current page's own items, so there is
       nothing to filter to. It renders as plain text rather than the
       `<a href="">` it used to, which looked clickable and reloaded the
       page. *}
    {if $cat->url === null}
      {$cat->name}
    {elseif $cat->title !== null}
      <a
        href="{$cat->url|noescape}"
        title="{$cat->title}"
        rel="nofollow"
      >{$cat->name}</a>
    {else}
      <a href="{$cat->url|noescape}" rel="nofollow">{$cat->name}</a>
    {/if}
    <span
      n:if="$cat->countImages !== null and $cat->countImages > 0"
      class="badge"
      title="{$cat->countImages|translate_dec:'%d photo','%d photos'}"
    >{$cat->countImages}</span>
    <span
      n:if="$cat->countCategories !== null and $cat->countCategories > 0"
      class="badge badgeCategories"
      title="{='sub-albums'|translate}"
    >{$cat->countCategories}</span>
    {var $ref_level = $cat->level}
  {/foreach}
  {='</li></ul>'|closeTags:$ref_level}
</dd>
