{templateType Piwigo\Menu\Projection\MenubarBlockView}
<dt>{='Tags'|translate}</dt>
<dd>
  <div id="menuTagCloud">
    {foreach $block->data as $tag}
      <span>{spaceless}
          {if isset($tag['U_ADD'])}
            <a
              class="tagLevel {if isset($tag['level'])}{$tag['level']}{/if}"
              href="{$tag['U_ADD']|noescape}"
              title="{$tag['counter']|translate_dec:'%d photo is also linked to current tags','%d photos are also linked to current tags'}"
              rel="nofollow"
            >+{$tag['name']}</a>
          {else}
            <a
              class="tagLevel {if isset($tag['level'])}{$tag['level']}{/if}"
              href="{$tag['URL']|noescape}"
              title="{='display photos linked to this tag'|translate}"
            >{$tag['name']}</a>
          {/if}</span>{/spaceless}
        {* ABOVE there should be no space between text, </a> and </span> elements to avoid IE8 bug https://connect.microsoft.com/IE/feedback/ViewFeedback.aspx?FeedbackID=366567 *}
      {/foreach}
  </div>
</dd>
