{templateType Piwigo\Calendar\Projection\MonthCalendarView}
{if !empty($chronology_navigation_bars)}
  <div n:foreach="$chronology_navigation_bars as $bar" class="calendarBar">
    <div
      n:if="isset($bar['previous'])"
      class="calendar-nav-prev"
    >&laquo; <a
        href="{$bar['previous']['URL']|noescape}"
      >{$bar['previous']['LABEL']}</a></div>
    <div n:if="isset($bar['next'])" class="calendar-nav-next"><a
        href="{$bar['next']['URL']|noescape}"
      >{$bar['next']['LABEL']}</a> &raquo;</div>
    {if empty($bar['items'])}
      &nbsp;
    {else}
      {foreach $bar['items'] as $item}
        {if !isset($item['URL'])}
          <span class="calItem">{$item['LABEL']}</span>
        {else}
          <a
            class="calItem"
            {if isset($item['NB_IMAGES'])}
            title="{$item['NB_IMAGES']|translate_dec:'%d photo','%d photos'}"
            {/if}
            href="{$item['URL']|noescape}"
          >{$item['LABEL']}</a>
        {/if}
      {/foreach}
    {/if}
  </div>
{/if}

{if !empty($chronology_calendar['calendar_bars'])}
  <div
    n:foreach="$chronology_calendar['calendar_bars'] as $bar"
    class="calendarCalBar"
  >
    <span class="calCalHead"><a
        href="{$bar['U_HEAD']|noescape}"
      >{$bar['HEAD_LABEL']}</a> ({$bar['NB_IMAGES']})</span><br>
    <span
      n:foreach="$bar['items'] as $item"
      class="calCal{if !isset($item['URL'])}Empty{/if}"
    >
      {if isset($item['URL'])}
        <a href="{$item['URL']|noescape}">{$item['LABEL']}</a>
      {else}
        {$item['LABEL']}
      {/if}
      {if isset($item['NB_IMAGES'])}({$item['NB_IMAGES']}){/if}
    </span>
  </div>
{/if}

<table
  n:if="isset($chronology_calendar['month_view'])"
  class="calMonth"
  style="--cal-cell-width: {$chronology_calendar['month_view']['CELL_WIDTH']}px; --cal-cell-height: {$chronology_calendar['month_view']['CELL_HEIGHT']}px;"
>
  <thead>
    <tr>
      <th
        n:foreach="$chronology_calendar['month_view']['wday_labels'] as $wday"
      >{$wday}</th>
    </tr>
  </thead>
  <tr n:foreach="$chronology_calendar['month_view']['weeks'] as $week">
    {foreach $week as $day}
      {if !empty($day)}
        {if isset($day['IMAGE'])}
          <td class="calDayCellFull">
            <div class="calBackDate">{$day['DAY']}</div><div
              class="calForeDate"
            >{$day['DAY']}</div>
            <div class="calImg">
              <a href="{$day['U_IMG_LINK']|noescape}">
                <img
                  src="{$day['IMAGE']|noescape}"
                  alt="{$day['IMAGE_ALT']}"
                  title="{$day['NB_ELEMENTS']|translate_dec:'%d photo','%d photos'}"
                >
              </a>
            </div>
          </td>
          {else}
          <td class="calDayCellEmpty">{$day['DAY']}</td>
          {/if}
      {else}{*blank cell first or last row only*}
        <td></td>{/if}
    {/foreach}{*day in week*}
  </tr>{*week in month*}
</table>
