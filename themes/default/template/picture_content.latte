{if !$current['selected_derivative']->isCached()}
  {do combineScript(id: 'jquery.ajaxmanager', path: 'themes/default/js/plugins/jquery.ajaxmanager.js', load: 'footer')}
  {do combineScript(id: 'thumbnails.loader', path: 'themes/default/js/thumbnails.loader.js', require: 'jquery.ajaxmanager', load: 'footer')}
  {capture $tmpFooterScript}var error_icon = "{$ROOT_URL}{$themeconf['icon_dir']}/errors_small.png"{/capture}
  {do footerScript($tmpFooterScript)}
{/if}

{if isset($current['path_ext']) and $current['path_ext'] == 'pdf' and $current['filesize'] < $PDF_VIEWER_FILESIZE_THRESHOLD}
  <div>
    <embed
      src="{$ROOT_URL}{$current['path']|noescape}"
      type="application/pdf"
    />
  </div>
{else}
  <img
    class="file-ext-{if isset($current['file_ext'])}{$current['file_ext']}{/if} path-ext-{if isset($current['path_ext'])}{$current['path_ext']}{/if}"
    {if (isset($current['path_ext']) and $current['path_ext'] == 'svg')}
    src="{$current['path']|noescape}"
    {elseif $current['selected_derivative']->isCached()}
    src="{$current['selected_derivative']->getUrl()|noescape}"
    {$current['selected_derivative']->getSizeHtm()|noescape}
    {else}
    src="{$ROOT_URL}{$themeconf['img_dir']}/ajax_loader.gif"
    data-src="{$current['selected_derivative']->getUrl()|noescape}"
    {/if}
    alt="{$ALT_IMG}"
    id="theMainImage"
    usemap="#map{$current['selected_derivative']->getType()}"
    title="{if isset($COMMENT_IMG)}{$COMMENT_IMG|strip_tags:false|replace:'"',' '}{else}{$current['TITLE_ESC']|noescape} - {$ALT_IMG}{/if}"
  >

  {if isset($current['path_ext']) and $current['path_ext'] == 'pdf' and $current['filesize'] > $PDF_VIEWER_FILESIZE_THRESHOLD}
    <div class="pdf-too-heavy">
      {='The PDF you requested is too large to display on this page.'|translate}
      <a
        href="{$ROOT_URL}{$current['path']|noescape}"
        target="_blank"
      >{='Click here to display it'|translate}</a>
    </div>
  {/if}
{/if}

{foreach $current['unique_derivatives'] as $derivative_type => $derivative}{spaceless}
    <map name="map{$derivative->getType()}">
      {var $size = $derivative->getSize()}
      {if isset($previous)}
        <area
          shape="rect"
          coords="0,0,{($size[0] / 4)|intval},{$size[1]}"
          href="{$previous['U_IMG']|noescape}"
          title="{='Previous'|translate} : {$previous['TITLE_ESC']|noescape}"
          alt="{$previous['TITLE_ESC']|noescape}"
        >
      {/if}
      <area
        shape="rect"
        coords="{($size[0] / 4)|intval},0,{($size[0] / 1.34)|intval},{($size[1] / 4)|intval}"
        href="{$U_UP|noescape}"
        title="{='Thumbnails'|translate}"
        alt="{='Thumbnails'|translate}"
      >
      {if isset($next)}
        <area
          shape="rect"
          coords="{($size[0] / 1.33)|intval},0,{$size[0]},{$size[1]}"
          href="{$next['U_IMG']|noescape}"
          title="{='Next'|translate} : {$next['TITLE_ESC']|noescape}"
          alt="{$next['TITLE_ESC']|noescape}"
        >
      {/if}
    </map>
  {/spaceless}{/foreach}
