{varType array{month?: list<array<int|string, float|int>>, avg: ?float} $monthStats}
{varType string $month_labels}
{varType ?string $name}
{varType array{CURRENT_PAGE?: float, URL_FIRST?: string, URL_PREV?: string, URL_NEXT?: string, URL_LAST?: string, pages?: array<int, string>, NB_PAGE?: int}|array{CURRENT_PAGE?: float, URL_FIRST?: string, URL_PREV?: string, URL_NEXT?: string, URL_LAST?: string, pages?: array<int, string>, NB_PAGE?: int}|null $navbar}
{varType int $nb_albums}
{varType int $nb_cats}
{varType int $nb_thumbs_page}
{varType int $nb_thumbs_set}
