{varType array<int, string|array{name: string, counter: int}> $nb_users_by_level}
{varType array<string, string|array{name: string, counter: int}> $nb_users_by_status}
{varType ?int $nb_users_granted_indirect}
{varType list<array<string, mixed>> $new_themes}
{varType array<string, mixed>|null $next}
{varType string $next_step_url}
{varType ?bool $no_group_in_gallery}
{varType list<string>|list<string>|null $no_search_results}
{varType bool $obligatory_user_mail_address}
{varType string $open_cat}
{varType list<string> $order_by_options}
{varType int|list<int> $order_by_options_selected}
{varType array<string, string> $order_options}
{varType ?string $order_selected}
{varType ?int $original_resize_maxheight}
{varType ?int $original_resize_maxwidth}
{varType string $orphan_tag_names_array}
{varType int $owner}
{varType string $owner_username}
{varType array{TIME: string, U_REFRESH: string}|null $page_refresh}
{varType int $pagination}
{varType bool $param}
{varType list<int|string>|null $parent_category}
{varType string $password_protected_users}
{varType int $per_page}
{varType list<array<string, mixed>> $permalinks}
{varType ?string $permission_url}
{varType list<string> $plugin_states}
{varType list<array<string, mixed>> $plugins}
{varType array<string, string> $pref_status_options}
{varType string $pref_status_selected}
{varType list<array<mixed>> $prefilters}
{varType array<string, mixed>|null $previous}
{varType array<array-key, string> $privacy_level_options}
{varType int $privacy_level_selected}
{varType bool $private}
{varType string $protected_users}
{varType array<string, string> $purge_derivatives}
{varType \Piwigo\Template\TemplateAdapter $pwg}
{varType string $pwg_token}
{varType array<array-key, string> $pwgmenu}
{varType array<string, string> $radio_options}
{varType array<string, mixed> $rate_summary}
{varType string $rating}
{varType array<string, array<string, mixed>> $ratings}
{varType list<array{TITLE: string, HTML_DATA: string}> $recent_posts}
{varType string $register_dates}
{varType array<array-key, array{name: string, unlinkable: bool}>|list<string>|null $related_categories}
{varType list<string> $related_categories_ids}
{varType list<array<string, mixed>>|null $related_tags}
{varType array<string, mixed>|null $representant}
{varType list<int> $represented_albums}
{varType ?int|?string $resize_quality}
{varType ?string|string $save_error}
{varType ?string|string $save_success}
{varType array<string, mixed> $search}
{varType ?string $search_input}
{varType list<int> $selected_category}
{varType ?string $selected_category_name}
{varType array<mixed> $selection}
{varType list<array{ID: string, CHECKED: string, USERNAME: string, EMAIL: string, LAST_SEND: ?string}> $send}
{varType string $set_default_baseurl}
{varType list<string> $setup_errors}
{varType list<string>|null $setup_warnings}
{varType mixed $show_add_user}
{varType bool $show_details}
{varType array<int, string> $since_options}
{varType int $since_options_selected}
{varType list<array<string, mixed>> $sites}
{varType array<string, mixed>|null $sizes}
{varType array<string, string>|null $slideshow}
{varType array<string, string> $sort_by_options}
{varType string $sort_by_options_selected}
{varType ?string $sort_order_checked}
{varType array<string, string> $sort_order_options}
{varType string $sort_order_options_selected}
{varType array<string, string> $sort_orders}
{varType list<mixed> $standard_pages_used_by}
{varType list<string> $std_pgs_logo_options}
{varType string $std_pgs_selected_logo}
{varType ?string $std_pgs_selected_logo_path}
{varType string $std_pgs_selected_skin}
{varType list<string> $std_pgs_skin_options}
{varType int $step}
{varType string $str_format_ext}
{varType bool $subcats_included}
{varType mixed $subscribe}
{varType string $sync}
{varType list<array{TYPE: mixed, LABEL: mixed}> $sync_error_captions}
{varType list<array{ELEMENT: mixed, LABEL: string}> $sync_errors}
{varType list<array{ELEMENT: mixed, LABEL: mixed}> $sync_infos}
{varType bool $sync_meta}
{varType array<string, array{caption: string, url: string}> $tabsheet}
{varType string $tabsheet_selected}
{varType list<array<string, mixed>> $tag_search_results}
{varType array<int, array{name: mixed, id: string}> $tag_selection}
{varType list<array<string, mixed>>|null $tags}
{varType array<int|string, string> $template_options}
{varType string $template_selection}
{varType array<array-key, string> $theme_options}
{varType string $theme_selected}
{varType array<string, mixed> $themeconf}
{varType array{CURRENT_PAGE?: float, URL_FIRST?: string, URL_PREV?: string, URL_NEXT?: string, URL_LAST?: string, pages?: array<int, string>, NB_PAGE?: int} $thumb_navbar}
{varType ?\Piwigo\Image\DerivativeParams $thumb_params}
{varType array<int|string, mixed>|list<array<string, mixed>> $thumbnails}
{varType ?string $time_elapsed_since_last_calc}
{varType string $title}
{varType int $total}
{varType list<array<string, mixed>> $tpl_themes}
{varType string|false $type}
{varType list<array{id: int, username: string, nb_lines: int}> $ulist}
{varType int $update_result}
{varType string $upload_file_types}
{varType bool $use_standard_pages}
{varType string $used_metadata}
{varType list<array{group_name: string, group_users: string}>|null $user_granted_indirect_groups}
{varType array<int, string>|null|array<string, string> $user_options}
{varType list<mixed> $user_options_selected}
{varType ?string $username}
{varType ?string $username_or_email}
{varType array<int, string>|list<array{ID: string, CHECKED: string, USERNAME: string, EMAIL: string, LAST_SEND: ?string}> $users}
{varType list<int> $users_selected}
{varType ?string $value}
{varType string $view_selector}
{varType string $warning_tags}
