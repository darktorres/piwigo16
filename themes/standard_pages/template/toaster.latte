{do combineScript(id: 'toaster_js', load: 'async', path: 'themes/standard_pages/js/toaster.js')}
{do combineCss(path: "themes/standard_pages/css/toaster.css")}
<div class="toaster" id="pwg_toaster">
  <div class="toast template-pwg-toaster" id="toast_template">
    <i class="toast_icon"></i>
    <p class="toast_text"></p>
  </div>
</div>
