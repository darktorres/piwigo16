<?php

// All declarations use brace-based namespace blocks so that named-namespace
// stubs (Relay, Predis) can coexist in the same file without parse errors.

namespace {
    // -------------------------------------------------------------------------
    // Runtime constants
    // -------------------------------------------------------------------------

    // PHPWG_ROOT_PATH eliminated in Phase 6; the URL constants below remain
    // as Psalm stubs for the few remaining define()-driven URLs.
    const PHPWG_URL = '';

    // Misc
    const PEM_URL = '';

    // mkgetdir flags
    const MKGETDIR_NONE = 0;
    const MKGETDIR_DEFAULT = 0;
    const MKGETDIR_RECURSIVE = 0;
    const MKGETDIR_PROTECT_INDEX = 0;
    const MKGETDIR_DIE_ON_ERROR = 0;


    // -------------------------------------------------------------------------
    // Imagick PECL extension
    // -------------------------------------------------------------------------
    class Imagick
    {
        public const int ORIENTATION_TOPLEFT = 1;
        public const int INTERLACE_LINE = 2;
        public const int FILTER_LANCZOS = 22;
        public const int ALPHACHANNEL_OPAQUE = 7;
        public const int EVALUATE_MULTIPLY = 6;
        public const int EVALUATE_DISSOLVE = 23;
        public const int CHANNEL_ALPHA = 8;
        public const int COMPOSITE_DISSOLVE = 23;

        public function __construct(string $files = '') {}
        public function getImageWidth(): int {}
        public function getImageHeight(): int {}
        public function setImageCompressionQuality(int $quality): bool {}
        public function cropImage(int $width, int $height, int $x, int $y): bool {}
        public function stripImage(): bool {}
        public function rotateImage(mixed $background, float $degrees): bool {}
        public function setImageOrientation(int $orientation): bool {}
        public function setInterlaceScheme(int $interlace): bool {}
        public function scaleImage(int $cols, int $rows, bool $bestfit = false): bool {}
        public function resizeImage(int $columns, int $rows, int $filter, float $blur, bool $bestfit = false): bool {}
        public function convolveImage(array $kernel): bool {}
        public function compositeImage(Imagick $composite_object, int $composite, int $x, int $y, int $channel = self::CHANNEL_ALPHA): bool {}
        public function evaluateImage(int $evaluate, float $constant, int $channel = self::CHANNEL_ALPHA): bool {}
        public function getImageAlphaChannel(): int {}
        public function setImageAlphaChannel(int $mode): bool {}
        public function writeImage(string $filename = ''): bool {}
        /** @return array{versionNumber: int, versionString: string} */
        public function getVersion(): array {}
        /** @param list<int> $factors */
        public function setSamplingFactors(array $factors): bool {}
    }

    class ImagickPixel
    {
        public function __construct(string $color = '') {}
    }

    // -------------------------------------------------------------------------
    // Redis PECL extension (optional Symfony Cache driver)
    // -------------------------------------------------------------------------
    class Redis
    {
        public function connect(string $host, int $port = 6379, float $timeout = 0.0): bool {}
    }

    class RedisArray
    {
        /** @param string[] $hosts */
        public function __construct(array $hosts, array $opts = []) {}
    }

    class RedisCluster
    {
        public function __construct(?string $name, array $seeds = [], float $timeout = 0.0, float $readTimeout = 0.0, bool $persistent = false, mixed $auth = null) {}
    }

    // -------------------------------------------------------------------------
    // IntlDateFormatter (ext-intl) — guarded by class_exists() at call sites
    // -------------------------------------------------------------------------
    class IntlDateFormatter
    {
        public const int FULL = 0;
        public const int LONG = 1;
        public const int MEDIUM = 2;
        public const int SHORT = 3;
        public const int NONE = -1;

        public function __construct(
            ?string $locale,
            int $dateType = self::FULL,
            int $timeType = self::FULL,
            mixed $timezone = null,
            mixed $calendar = null,
            string $pattern = '',
        ) {}

        public function format(mixed $datetime): string|false {}
    }
}

// -------------------------------------------------------------------------
// Relay extension (high-performance Redis client)
// -------------------------------------------------------------------------
namespace Relay {
    class Relay
    {
        public function connect(string $host, int $port = 6379, float $timeout = 0.0): bool {}
    }

    class Cluster
    {
        /** @param string[] $seeds */
        public function __construct(?string $name, array $seeds = [], float $timeout = 0.0, float $readTimeout = 0.0, bool $persistent = false, mixed $auth = null) {}
    }
}

// -------------------------------------------------------------------------
// Predis (optional Symfony Cache driver — package not required)
// -------------------------------------------------------------------------
namespace Predis {
    interface ClientInterface {}
}
