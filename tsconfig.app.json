{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "admin/themes/default/js/**/*",
    "themes/*/js/**/*",
    "plugins/*/js/**/*"
  ],
  "exclude": ["**/dist/**", "node_modules/**", "tests/**"]
}
