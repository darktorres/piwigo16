{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      // Vite's ambient types: needed for the `*.css` side-effect import
      // in stats.ts (Chart.js's resize-monitor stylesheet).
      "vite/client",
      "node",
      "jquery",
      "jqueryui",
      "chart.js",
      "plupload"
    ]
  },
  "include": [
    "build/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.ts",
    "commitlint.config.ts",
    "tests/Unit/**/*.ts",
    "openapi/client/**/*.ts",
    "themes/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
